@{
    ViewData["Title"] = "Gestión de Vehículos";
    Layout = null;
    var vehiculos = ViewBag.Vehiculos as IEnumerable<dynamic> ?? new List<dynamic>();
    int total = vehiculos.Count();
    int activos = vehiculos.Count(v => (bool)v.Activo);
    int inactivos = total - activos;
    int clientes = vehiculos.Select(v => (string)v.ClienteNombre).Distinct().Count();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Vehículos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: 8px;
            padding: 32px;
            max-width: 520px;
            width: 95%;
            box-shadow: 0 8px 40px rgba(0,0,0,0.25);
        }

            .modal-box h5 {
                font-size: 1rem;
                font-weight: 700;
                margin-bottom: 20px;
                color: #1e293b;
            }

        .modal-label {
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
        }

        .modal-input {
            width: 100%;
            padding: 8px 12px;
            font-size: 0.88rem;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            outline: none;
            box-sizing: border-box;
            margin-bottom: 14px;
        }

            .modal-input:focus {
                border-color: #2563eb;
            }

            .modal-input[readonly] {
                background: #f1f5f9;
                color: #94a3b8;
                cursor: not-allowed;
            }

        .modal-footer-btns {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 8px;
        }

        .btn-modal-cancel {
            font-size: 0.82rem;
            padding: 8px 20px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            background: transparent;
            color: #64748b;
            cursor: pointer;
        }

        .btn-modal-save {
            font-size: 0.82rem;
            padding: 8px 20px;
            border: none;
            border-radius: 4px;
            background: #2563eb;
            color: #fff;
            cursor: pointer;
            font-weight: 600;
        }

            .btn-modal-save:hover {
                opacity: 0.88;
            }

        .btn-editar {
            background: rgba(37,99,235,0.08);
            color: #2563eb;
            border: 1px solid rgba(37,99,235,0.2);
            border-radius: 4px;
            padding: 5px 8px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: background .15s;
        }

            .btn-editar:hover {
                background: rgba(37,99,235,0.16);
            }
    </style>
</head>
<body>
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Ordenes" class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Facturas" class="nav-link"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            <a href="/VehiculosAdmin" class="nav-link active"><i class="bi bi-car-front-fill"></i><span>Vehículos</span></a>
        </nav>
    </div>

    <div class="admin-content">
        <div class="section-header">
            <div>
                <h1 class="section-title">Gestión de Vehículos</h1>
                <p class="section-sub">Todos los vehículos registrados en el sistema</p>
            </div>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err"><i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]</div>
        }

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon" style="background:#1e3a5f"><i class="bi bi-car-front-fill text-info"></i></div>
                <div><div class="stat-num">@total</div><div class="stat-label">Total vehículos</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#1a3a2a"><i class="bi bi-check-circle-fill text-success"></i></div>
                <div><div class="stat-num">@activos</div><div class="stat-label">Activos</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#3a1e1e"><i class="bi bi-eye-slash-fill text-danger"></i></div>
                <div><div class="stat-num">@inactivos</div><div class="stat-label">Inactivos</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#2a2a1a"><i class="bi bi-people-fill text-warning"></i></div>
                <div><div class="stat-num">@clientes</div><div class="stat-label">Clientes</div></div>
            </div>
        </div>

        <div class="filtro-bar">
            <div class="input-buscar">
                <i class="bi bi-search"></i>
                <input type="text" id="buscarInput" placeholder="Buscar placa, marca, cliente..."
                       onkeyup="filtrarTabla()" autocomplete="off" readonly
                       onfocus="this.removeAttribute('readonly')" />
            </div>
            <select id="filtroEstado" class="filtro-select" onchange="filtrarTabla()">
                <option value="">Todos los estados</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>

        <div class="tabla-wrapper">
            <table class="tabla-usuarios" id="tablaVehiculos">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Placa</th>
                        <th>Cliente</th>
                        <th>Marca / Modelo</th>
                        <th>Año</th>
                        <th>Color</th>
                        <th>Km</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in vehiculos)
                    {
                        string clienteNombre = v.ClienteNombre;
                        bool activo = (bool)v.Activo;
                        <tr class="fila-usuario @(activo ? "" : "fila-inactiva")"
                            data-placa="@(((string)v.Placa).ToLower())"
                            data-marca="@(((string)v.Marca).ToLower())"
                            data-cliente="@clienteNombre.ToLower()"
                            data-estado="@(activo ? "Activo" : "Inactivo")">
                            <td>@v.IdVehiculo</td>
                            <td><span class="rol-badge badge-admin-rol" style="letter-spacing:.1em;font-size:.72rem">@v.Placa</span></td>
                            <td class="td-nombre">
                                <div class="avatar-circle">@(clienteNombre.Length > 0 ? clienteNombre[0].ToString().ToUpper() : "?")</div>
                                <span>@clienteNombre</span>
                            </td>
                            <td>@v.Marca <span style="color:#64748b">@v.Modelo</span></td>
                            <td>@v.Anio</td>
                            <td>@(string.IsNullOrWhiteSpace((string)v.Color) ? "—" : v.Color)</td>
                            <td>@v.KmActuales.ToString("N0") km</td>
                            <td>
                                @if (activo)
                                {
                                    <span class="estado-badge estado-activo"><i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="estado-badge estado-inactivo"><i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>Inactivo</span>
                                }
                            </td>
                            <td style="font-size:.78rem;color:#64748b">@(((DateTime)v.FechaRegistro).ToString("dd/MM/yyyy"))</td>
                            <td class="td-acciones">
                                @* Botón editar *@
                                <button type="button" class="btn-editar" title="Editar"
                                        onclick="abrirEditar(@v.IdVehiculo, '@v.Placa', '@v.Marca', '@v.Modelo', @v.Anio, '@v.Color', '@v.Vin', @v.KmActuales)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                @if (activo)
                                {
                                    <form action="/VehiculosAdmin/Desactivar/@v.IdVehiculo" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Desactivar vehículo @v.Placa?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-accion btn-desactivar" title="Desactivar">
                                            <i class="bi bi-eye-slash-fill"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form action="/VehiculosAdmin/Reactivar/@v.IdVehiculo" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Reactivar vehículo @v.Placa?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-accion btn-reactivar" title="Reactivar">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                    </form>
                                }
                                <form action="/VehiculosAdmin/Eliminar/@v.IdVehiculo" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar DEFINITIVAMENTE @v.Placa?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-accion btn-desactivar"
                                            style="background:rgba(220,38,38,0.1);color:#b91c1c;border-color:rgba(220,38,38,0.2)"
                                            title="Eliminar">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!vehiculos.Any())
            {
                <div class="tabla-vacia">
                    <i class="bi bi-car-front" style="font-size:3rem;color:#334155"></i>
                    <p class="mt-2">No hay vehículos registrados.</p>
                </div>
            }
        </div>
    </div>

    @* Form oculto para enviar edición *@
    <form id="formEditarAdmin" action="/VehiculosAdmin/Editar" method="post" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" id="eId" name="IdVehiculo" />
        <input type="hidden" id="ePlaca" name="Placa" />
        <input type="hidden" id="eMarca" name="Marca" />
        <input type="hidden" id="eModelo" name="Modelo" />
        <input type="hidden" id="eAnio" name="Anio" />
        <input type="hidden" id="eColor" name="Color" />
        <input type="hidden" id="eVin" name="Vin" />
        <input type="hidden" id="eKm" name="KmActuales" />
    </form>

    @* Modal editar *@
    <div class="modal-overlay" id="modalEditar">
        <div class="modal-box">
            <h5><i class="bi bi-pencil-fill me-2"></i>Editar vehículo</h5>
            <div class="row g-2">
                <div class="col-6">
                    <label class="modal-label">Placa</label>
                    <input type="text" id="mPlaca" class="modal-input" maxlength="10" style="text-transform:uppercase" autocomplete="off" />
                </div>
                <div class="col-6">
                    <label class="modal-label">Marca</label>
                    <input type="text" id="mMarca" class="modal-input" autocomplete="off" />
                </div>
                <div class="col-6">
                    <label class="modal-label">Modelo</label>
                    <input type="text" id="mModelo" class="modal-input" autocomplete="off" />
                </div>
                <div class="col-3">
                    <label class="modal-label">Año</label>
                    <input type="number" id="mAnio" class="modal-input" min="1900" max="2100" autocomplete="off" />
                </div>
                <div class="col-3">
                    <label class="modal-label">Color</label>
                    <input type="text" id="mColor" class="modal-input" autocomplete="off" />
                </div>
                <div class="col-6">
                    <label class="modal-label">VIN</label>
                    <input type="text" id="mVin" class="modal-input" autocomplete="off" />
                </div>
                <div class="col-6">
                    <label class="modal-label">Km actuales</label>
                    <input type="number" id="mKm" class="modal-input" min="0" autocomplete="off" />
                </div>
            </div>
            <div class="modal-footer-btns">
                <button class="btn-modal-cancel" onclick="cerrarEditar()">Cancelar</button>
                <button class="btn-modal-save" onclick="guardarEditar()">
                    <i class="bi bi-check-lg me-1"></i>Guardar cambios
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filtrarTabla() {
            const buscar = document.getElementById('buscarInput').value.toLowerCase();
            const estado = document.getElementById('filtroEstado').value;
            document.querySelectorAll('.fila-usuario').forEach(f => {
                const okB = !buscar || f.dataset.placa.includes(buscar) ||
                    f.dataset.marca.includes(buscar) || f.dataset.cliente.includes(buscar);
                const okE = !estado || f.dataset.estado === estado;
                f.style.display = (okB && okE) ? '' : 'none';
            });
        }

        let idActual = null;

        function abrirEditar(id, placa, marca, modelo, anio, color, vin, km) {
            idActual = id;
            document.getElementById('mPlaca').value  = placa;
            document.getElementById('mMarca').value  = marca;
            document.getElementById('mModelo').value = modelo;
            document.getElementById('mAnio').value   = anio;
            document.getElementById('mColor').value  = color === '—' ? '' : color;
            document.getElementById('mVin').value    = vin  === '—' ? '' : vin;
            document.getElementById('mKm').value     = km;
            document.getElementById('modalEditar').classList.add('show');
            setTimeout(() => document.getElementById('mPlaca').focus(), 100);
        }

        function cerrarEditar() {
            document.getElementById('modalEditar').classList.remove('show');
            idActual = null;
        }

        function guardarEditar() {
            if (!idActual) return;
            document.getElementById('eId').value     = idActual;
            document.getElementById('ePlaca').value  = document.getElementById('mPlaca').value.toUpperCase();
            document.getElementById('eMarca').value  = document.getElementById('mMarca').value;
            document.getElementById('eModelo').value = document.getElementById('mModelo').value;
            document.getElementById('eAnio').value   = document.getElementById('mAnio').value;
            document.getElementById('eColor').value  = document.getElementById('mColor').value;
            document.getElementById('eVin').value    = document.getElementById('mVin').value;
            document.getElementById('eKm').value     = document.getElementById('mKm').value;
            document.getElementById('formEditarAdmin').submit();
        }
    </script>
</body>
</html>
