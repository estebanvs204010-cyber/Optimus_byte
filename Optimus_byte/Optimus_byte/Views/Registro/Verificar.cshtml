@model Optimus_byte.Models.ViewModels.VerificacionViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificar correo — Optimus Byte</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #0f0f1a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }
        .card-verificar {
            background: #1a1a2e;
            border: 1px solid #f0a500;
            border-radius: 16px;
            padding: 40px;
            max-width: 420px;
            width: 100%;
            text-align: center;
        }
        .titulo { color: #f0a500; font-size: 28px; font-weight: bold; }
        .subtitulo { color: #cccccc; font-size: 14px; margin-bottom: 30px; }
        .correo-badge {
            background: #f0a50020;
            border: 1px solid #f0a500;
            color: #f0a500;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            display: inline-block;
            margin-bottom: 24px;
        }
        .input-codigo {
            background: #0f0f1a;
            border: 2px solid #f0a500;
            color: #ffffff;
            font-size: 32px;
            letter-spacing: 12px;
            text-align: center;
            border-radius: 10px;
            padding: 14px;
            width: 100%;
        }
        .input-codigo:focus {
            outline: none;
            box-shadow: 0 0 0 3px #f0a50040;
            background: #0f0f1a;
            color: #ffffff;
        }
        .btn-verificar {
            background: #f0a500;
            color: #000;
            font-weight: bold;
            border: none;
            padding: 12px;
            width: 100%;
            border-radius: 8px;
            font-size: 16px;
            margin-top: 20px;
            cursor: pointer;
        }
        .btn-verificar:hover { background: #d4920a; }
        .error-msg {
            background: #ff000020;
            border: 1px solid #ff4444;
            color: #ff4444;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 14px;
        }
        .temporizador { color: #aaaaaa; font-size: 13px; margin-top: 16px; }
        .temporizador span { color: #f0a500; font-weight: bold; }
        .link-reenviar {
            color: #f0a500;
            font-size: 13px;
            text-decoration: none;
            margin-top: 12px;
            display: inline-block;
        }
        .link-reenviar:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card-verificar">
        <div class="titulo">📧 Verifica tu correo</div>
        <p class="subtitulo">Te enviamos un código de 6 dígitos a:</p>
        <div class="correo-badge">@Model.Correo</div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error-msg">@Model.Error</div>
        }

        <form asp-action="VerificarCodigo" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Correo" value="@Model.Correo" />

            <input type="text"
                   name="Codigo"
                   class="input-codigo"
                   maxlength="6"
                   placeholder="000000"
                   autocomplete="off"
                   autofocus />

            <button type="submit" class="btn-verificar">
                ✅ Verificar código
            </button>
        </form>

        <div class="temporizador">
            El código expira en <span id="timer">10:00</span>
        </div>

        <a href="/Registro" class="link-reenviar">
            ↩ Volver al registro
        </a>
    </div>

    <script>
        // Temporizador de 10 minutos
        let segundos = 600;
        const timer = document.getElementById('timer');
        const intervalo = setInterval(() => {
            segundos--;
            const m = Math.floor(segundos / 60).toString().padStart(2, '0');
            const s = (segundos % 60).toString().padStart(2, '0');
            timer.textContent = `${m}:${s}`;
            if (segundos <= 0) {
                clearInterval(intervalo);
                timer.textContent = 'Expirado';
                timer.style.color = '#ff4444';
            }
        }, 1000);

        // Solo permitir números en el campo
        document.querySelector('.input-codigo').addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
</body>
</html>
