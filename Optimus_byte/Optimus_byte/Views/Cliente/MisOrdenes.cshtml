@{
    ViewData["Title"] = "Mis Órdenes";
    Layout = null;
    var ordenes = ViewBag.Ordenes as List<dynamic> ?? new List<dynamic>();
    var nombre = ViewBag.Nombre as string ?? "Cliente";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OPTIMUS-BYTE — Mis Órdenes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <style>
        /* ── Vista toggle ── */
        .vista-toggle {
            display: flex;
            gap: 4px;
        }

        .vista-btn {
            padding: 7px 14px;
            border: 1px solid var(--borde-input);
            background: transparent;
            color: var(--texto-suave);
            border-radius: 4px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: var(--transicion);
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .vista-btn.active {
                background: var(--dorado-suave);
                color: var(--dorado);
                border-color: var(--dorado);
            }

        /* ── Filtro bar ── */
        .filtro-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .filtro-select {
            padding: 8px 14px;
            border: 1px solid var(--borde-input);
            background: #ffffff;
            color: var(--texto);
            border-radius: 4px;
            font-size: 0.82rem;
            font-family: inherit;
            outline: none;
            transition: border-color .2s;
        }

            .filtro-select:focus {
                border-color: var(--dorado);
            }

        .ordenes-count {
            font-size: 0.78rem;
            color: var(--texto-suave);
            margin-left: auto;
        }

        /* ── Grid de cards ── */
        .ordenes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }

        /* ── Orden card ── */
        .orden-card {
            background: #f8faff;
            border: 1px solid var(--borde-input);
            border-radius: 10px;
            display: flex;
            overflow: hidden;
            transition: box-shadow .2s, border-color .2s;
        }

            .orden-card:hover {
                box-shadow: 0 4px 20px rgba(37,99,235,0.10);
                border-color: rgba(37,99,235,0.25);
            }

        .orden-time {
            background: var(--dorado-suave);
            border-right: 1px solid var(--borde);
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-width: 68px;
            border-radius: 10px 0 0 10px;
            font-size: 0.72rem;
            color: var(--dorado);
            text-align: center;
            gap: 4px;
            padding-top: 18px;
        }

            .orden-time strong {
                font-size: 0.88rem;
                font-weight: 700;
                display: block;
            }

            .orden-time .ot-label {
                font-size: 0.65rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--texto-suave);
                font-weight: 600;
                margin-bottom: 2px;
            }

        .orden-body {
            padding: 14px 16px;
            flex: 1;
            overflow: hidden;
        }

        .orden-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 8px;
            gap: 8px;
        }

        .placa-badge {
            font-family: var(--fuente-display);
            font-size: 0.88rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--texto);
        }

        .vehiculo-line {
            font-size: 0.78rem;
            color: var(--texto-suave);
            margin: 0 0 4px;
        }

        .tipo-line {
            font-size: 0.75rem;
            color: var(--texto-suave);
            margin: 0 0 8px;
        }

        .descripcion-line {
            font-size: 0.8rem;
            color: var(--texto-claro);
            margin-bottom: 10px;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* ── Badges de estado ── */
        .ep-pendiente {
            background: rgba(245,158,11,.12);
            color: #b45309;
            border: 1px solid rgba(245,158,11,.3);
        }

        .ep-proceso {
            background: rgba(37,99,235,.12);
            color: #1d4ed8;
            border: 1px solid rgba(37,99,235,.3);
        }

        .ep-repuesto {
            background: rgba(239,68,68,.12);
            color: #b91c1c;
            border: 1px solid rgba(239,68,68,.3);
        }

        .ep-listo {
            background: rgba(124,58,237,.12);
            color: #6d28d9;
            border: 1px solid rgba(124,58,237,.3);
        }

        .ep-entregado {
            background: rgba(22,163,74,.12);
            color: #15803d;
            border: 1px solid rgba(22,163,74,.3);
        }

        .ep-cancelado {
            background: rgba(100,116,139,.12);
            color: #475569;
            border: 1px solid rgba(100,116,139,.3);
        }

        .estado-pill {
            font-size: 0.68rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }

        /* ── Countdown ── */
        .countdown-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: 600;
            margin-top: 8px;
        }

        .cd-ok {
            background: rgba(34,197,94,.10);
            border: 1px solid rgba(34,197,94,.25);
            color: #16a34a;
        }

        .cd-medio {
            background: rgba(245,158,11,.10);
            border: 1px solid rgba(245,158,11,.25);
            color: #b45309;
        }

        .cd-urgente {
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.3);
            color: #b91c1c;
        }

        .cd-vencido {
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.3);
            color: #b91c1c;
        }

        .cd-listo {
            background: rgba(22,163,74,.12);
            border: 1px solid rgba(22,163,74,.3);
            color: #15803d;
        }

        /* ── Vista tabla ── */
        .tabla-wrapper {
            overflow-x: auto;
        }

        /* ── Estado vacío ── */
        .vacia {
            text-align: center;
            padding: 60px 20px;
            color: var(--texto-suave);
        }

            .vacia i {
                font-size: 3rem;
                display: block;
                margin-bottom: 12px;
                opacity: .4;
            }

            .vacia p {
                font-size: 0.88rem;
            }

        /* ── Stats ── */
        .bg-blue-soft {
            background: rgba(37,99,235,.08);
        }

        .bg-orange-soft {
            background: rgba(234,88,12,.08);
        }

        .bg-green-soft {
            background: rgba(22,163,74,.08);
        }

        .bg-purple-soft {
            background: rgba(124,58,237,.08);
        }
    </style>
</head>
<body>

    <!-- Topbar -->
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@nombre</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <!-- Sidebar -->
    @await Html.PartialAsync("~/Views/Shared/_ClienteSidebar.cshtml")

    <!-- Contenido -->
    <main class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Mis Órdenes</h1>
                <p class="section-sub">Consulta el estado de tus órdenes y el tiempo estimado de entrega</p>
            </div>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok mb-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }

        @{
            int pendientes = ordenes.Count(o => (string)o.Estado == "Pendiente" || (string)o.Estado == "En proceso" || (string)o.Estado == "Esperando repuesto");
            int listos = ordenes.Count(o => (string)o.Estado == "Listo para entrega");
            int entregados = ordenes.Count(o => (string)o.Estado == "Entregado");
        }

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon bg-blue-soft"><i class="bi bi-clipboard2-list text-primary"></i></div>
                <div>
                    <div class="stat-num">@ordenes.Count</div>
                    <div class="stat-label">Total de órdenes</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-orange-soft"><i class="bi bi-hourglass-split" style="color:#ea580c"></i></div>
                <div>
                    <div class="stat-num">@pendientes</div>
                    <div class="stat-label">En proceso</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-purple-soft"><i class="bi bi-check-circle" style="color:#7c3aed"></i></div>
                <div>
                    <div class="stat-num">@listos</div>
                    <div class="stat-label">Listos para recoger</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-green-soft"><i class="bi bi-check2-all text-success"></i></div>
                <div>
                    <div class="stat-num">@entregados</div>
                    <div class="stat-label">Entregados</div>
                </div>
            </div>
        </div>

        <div class="panel-section">
            <div class="section-mini-header">
                <div>
                    <h2>Agenda de órdenes</h2>
                    <p>Órdenes asignadas · tiempos · estados</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="vista-toggle">
                        <button class="vista-btn active" id="btnCards" onclick="cambiarVista('cards')">
                            <i class="bi bi-grid-3x3-gap"></i> Cards
                        </button>
                        <button class="vista-btn" id="btnTabla" onclick="cambiarVista('tabla')">
                            <i class="bi bi-table"></i> Tabla
                        </button>
                    </div>
                </div>
            </div>

            @if (!ordenes.Any())
            {
                <div class="vacia">
                    <i class="bi bi-clipboard2-x"></i>
                    <p>No tienes órdenes registradas aún.</p>
                </div>
            }
            else
            {
                <!-- Filtro -->
                <div class="filtro-bar">
                    <select class="filtro-select" id="filtroEstado" onchange="filtrar()">
                        <option value="">Todos los estados</option>
                        <option>Pendiente</option>
                        <option>En proceso</option>
                        <option>Esperando repuesto</option>
                        <option>Listo para entrega</option>
                        <option>Entregado</option>
                        <option>Cancelado</option>
                    </select>
                    <span class="ordenes-count">@ordenes.Count orden(es)</span>
                </div>

                <!-- Vista Cards -->
                <div class="ordenes-grid" id="vistaCards">
                    @foreach (var o in ordenes)
                    {
                        string estado = (string)o.Estado;
                        string badgeClass = estado switch
                        {
                            "Pendiente" => "ep-pendiente",
                            "En proceso" => "ep-proceso",
                            "Esperando repuesto" => "ep-repuesto",
                            "Listo para entrega" => "ep-listo",
                            "Entregado" => "ep-entregado",
                            "Cancelado" => "ep-cancelado",
                            _ => "ep-pendiente"
                        };

                        DateTime? fechaEntrega = (DateTime?)o.FechaEntregaEstimada;

                        <article class="orden-card fila-orden" data-estado="@estado">
                            <!-- Columna izquierda: fecha + OT -->
                            <div class="orden-time">
                                <span class="ot-label">Orden</span>
                                <strong>OT-@o.IdOrden</strong>
                                <span style="margin-top:8px;">@(((DateTime)o.FechaApertura).ToString("dd MMM"))</span>
                                <strong>@(((DateTime)o.FechaApertura).ToString("HH:mm"))</strong>
                            </div>

                            <!-- Cuerpo -->
                            <div class="orden-body">
                                <div class="orden-header-row">
                                    <span class="placa-badge"><i class="bi bi-car-front me-1"></i>@o.Placa</span>
                                    <span class="estado-pill @badgeClass">@estado</span>
                                </div>
                                <p class="vehiculo-line">@o.Marca @o.Modelo</p>
                                <p class="tipo-line"><i class="bi bi-tools me-1"></i>@o.TipoServicio</p>
                                <p class="descripcion-line">@o.DescripcionProblema</p>

                                @if (!string.IsNullOrWhiteSpace((string?)o.Diagnostico))
                                {
                                    <p style="font-size:.75rem;color:var(--texto-suave);margin-bottom:6px;">
                                        <i class="bi bi-clipboard2-pulse me-1"></i>@o.Diagnostico
                                    </p>
                                }

                                @* Cuenta regresiva *@
                                @if (fechaEntrega.HasValue && estado != "Entregado" && estado != "Cancelado")
                                {
                                    <div class="countdown-pill cd-ok"
                                         id="cd-@o.IdOrden"
                                         data-entrega="@fechaEntrega.Value.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        <i class="bi bi-clock"></i>
                                        <span class="cd-texto">Calculando...</span>
                                    </div>
                                }
                                else if (estado == "Listo para entrega")
                                {
                                    <div class="countdown-pill cd-listo">
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>¡Listo para recoger!</span>
                                    </div>
                                }
                                else if (estado == "Entregado")
                                {
                                    <div class="countdown-pill" style="background:var(--dorado-suave);border:1px solid var(--borde);color:var(--texto-suave)">
                                        <i class="bi bi-check2-all"></i>
                                        <span>Vehículo entregado</span>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>

                <!-- Vista Tabla -->
                <div class="tabla-wrapper d-none" id="vistaTabla">
                    <table class="tabla-usuarios">
                        <thead>
                            <tr>
                                <th>Orden</th>
                                <th>Fecha</th>
                                <th>Placa</th>
                                <th>Vehículo</th>
                                <th>Servicio</th>
                                <th>Estado</th>
                                <th>Entrega estimada</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in ordenes)
                            {
                                string estado = (string)o.Estado;
                                string badgeClass = estado switch
                                {
                                    "Pendiente" => "ep-pendiente",
                                    "En proceso" => "ep-proceso",
                                    "Esperando repuesto" => "ep-repuesto",
                                    "Listo para entrega" => "ep-listo",
                                    "Entregado" => "ep-entregado",
                                    "Cancelado" => "ep-cancelado",
                                    _ => "ep-pendiente"
                                };
                                DateTime? fechaEntrega = (DateTime?)o.FechaEntregaEstimada;

                                <tr class="fila-orden" data-estado="@estado">
                                    <td><strong>OT-@o.IdOrden</strong></td>
                                    <td>@(((DateTime)o.FechaApertura).ToString("dd/MM/yyyy"))</td>
                                    <td><strong>@o.Placa</strong></td>
                                    <td>@o.Marca @o.Modelo</td>
                                    <td>@o.TipoServicio</td>
                                    <td><span class="estado-pill @badgeClass">@estado</span></td>
                                    <td>
                                        @if (fechaEntrega.HasValue)
                                        {
                                            <span data-entrega="@fechaEntrega.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                  style="font-size:.78rem;color:#7c3aed;font-weight:600">
                                                Calculando...
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-size:.75rem;color:#94a3b8">Sin definir</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Cambiar vista cards/tabla ─────────────────────────────
        function cambiarVista(modo) {
            const esCards = modo === 'cards';
            document.getElementById('vistaCards').classList.toggle('d-none', !esCards);
            document.getElementById('vistaTabla').classList.toggle('d-none', esCards);
            document.getElementById('btnCards').classList.toggle('active', esCards);
            document.getElementById('btnTabla').classList.toggle('active', !esCards);
        }

        // ── Filtrar por estado ─────────────────────────────────────
        function filtrar() {
            const e = document.getElementById('filtroEstado').value;
            document.querySelectorAll('.fila-orden').forEach(f => {
                f.style.display = (!e || f.dataset.estado === e) ? '' : 'none';
            });
        }

        // ── Cuentas regresivas ─────────────────────────────────────
        function actualizarCuentas() {
            document.querySelectorAll('[data-entrega]').forEach(el => {
                const diff = new Date(el.dataset.entrega) - new Date();
                const textoEl = el.querySelector('.cd-texto') || el;
                const pill = el.closest ? el.closest('.countdown-pill') : el.parentElement;

                if (diff <= 0) {
                    textoEl.textContent = 'Tiempo de entrega vencido';
                    if (pill) { pill.className = 'countdown-pill cd-vencido'; }
                    return;
                }

                const dias  = Math.floor(diff / 86400000);
                const horas = Math.floor((diff % 86400000) / 3600000);
                const mins  = Math.floor((diff % 3600000) / 60000);

                let texto = '';
                let clase = 'cd-ok';

                if (dias > 0) {
                    texto = `Entrega en ${dias}d ${horas}h`;
                    clase = dias > 1 ? 'cd-ok' : 'cd-medio';
                } else if (horas > 0) {
                    texto = `Entrega en ${horas}h ${mins}m`;
                    clase = horas > 2 ? 'cd-medio' : 'cd-urgente';
                } else {
                    texto = `Entrega en ${mins} minutos`;
                    clase = 'cd-urgente';
                }

                textoEl.textContent = texto;
                if (pill && pill.classList.contains('countdown-pill')) {
                    pill.className = `countdown-pill ${clase}`;
                }
            });
        }

        actualizarCuentas();
        setInterval(actualizarCuentas, 30000);
    </script>
</body>
</html>
