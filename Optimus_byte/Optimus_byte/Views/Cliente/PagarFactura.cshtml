@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Pagar Factura</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="container mt-5">

        <h2>Pagar Factura #@ViewBag.IdFactura</h2>

        <div class="card p-4">

            <p><strong>Orden:</strong> #@ViewBag.IdOrden</p>

            <p>
                <strong>Total:</strong>
                $@String.Format("{0:N0}", ViewBag.Total)
            </p>

            <p>
                <strong>Estado:</strong>
                @ViewBag.EstadoPago
            </p>

            <hr />

            <h5>Método de pago</h5>

            <div class="d-grid gap-2">

                <a href="/Cliente/PagarConTarjeta/@ViewBag.IdFactura"
                   class="btn btn-primary">
                    Tarjeta crédito/débito
                </a>

                <a href="/Cliente/PagarConPSE/@ViewBag.IdFactura"
                   class="btn btn-success">
                    PSE
                </a>

                <a href="/Cliente/PagarConNequi/@ViewBag.IdFactura"
                   class="btn btn-info">
                    Nequi
                </a>

            </div>

            <br />

            <a href="/Cliente/MisFacturas"
               class="btn btn-secondary">
                Volver
            </a>

        </div>

    </div>

</body>
</html>