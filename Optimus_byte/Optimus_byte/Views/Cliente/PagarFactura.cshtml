namespa@{
ViewData["Title"] = "Pagar Factura";
Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Pagar Factura</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="container mt-5">

        <h2>Pagar Factura #@ViewBag.IdFactura</h2>

        <div class="card mt-4">
            <div class="card-body">

                <p>
                    <strong>Orden:</strong>
                    #@ViewBag.IdOrden
                </p>

                <p>
                    <strong>Total:</strong>
                    $@String.Format("{0:N0}", ViewBag.Total)
                </p>

                <p>
                    <strong>Estado:</strong>
                    @ViewBag.EstadoPago
                </p>

                <p>
                    <strong>Fecha:</strong>
                    @(((DateTime)ViewBag.FechaEmision).ToString("dd/MM/yyyy"))
                </p>

            </div>
        </div>

        <div class="mt-4">

            <h4>Método de Pago</h4>

            <div class="d-grid gap-2">

                <button class="btn btn-primary">
                    Pagar con Tarjeta
                </button>

                <button class="btn btn-success">
                    Pagar con PSE
                </button>

                <button class="btn btn-dark">
                    Pagar con Nequi
                </button>

            </div>

        </div>

        <div class="mt-4">
            <a href="/Cliente/MisFacturas" class="btn btn-secondary">
                Volver
            </a>
        </div>

    </div>

</body>
</html>