@{
    ViewData["Title"] = "Mi Portal";
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Cliente";
    var totalOrdenes = ViewBag.TotalOrdenes as int? ?? 0;
    var ordenesActivas = ViewBag.OrdenesActivas as int? ?? 0;
    var totalVehiculos = ViewBag.TotalVehiculos as int? ?? 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OPTIMUS-BYTE — Mi Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <style>
        /* ── Accesos rápidos ── */
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .quick-card {
            background: #ffffff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            padding: 24px 20px;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: var(--transicion);
            position: relative;
            overflow: hidden;
        }

            .quick-card::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: var(--dorado);
                transform: scaleX(0);
                transition: transform 0.3s ease;
            }

            .quick-card:hover {
                border-color: var(--dorado);
                box-shadow: 0 4px 20px rgba(37,99,235,0.10);
                transform: translateY(-2px);
            }

            .quick-card:hover::after {
                transform: scaleX(1);
            }

        .quick-card-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .icon-blue { background: rgba(37,99,235,0.09); color: #2563eb; }
        .icon-gold { background: rgba(37,99,235,0.09); color: var(--dorado); }
        .icon-green { background: rgba(22,163,74,0.09); color: #16a34a; }
        .icon-purple { background: rgba(124,58,237,0.09); color: #7c3aed; }
        .icon-orange { background: rgba(234,88,12,0.09); color: #ea580c; }

        .quick-card-title {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--texto);
            margin: 0;
        }

        .quick-card-desc {
            font-size: 0.78rem;
            color: var(--texto-suave);
            margin: 0;
            line-height: 1.5;
        }

        .quick-card-arrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 600;
            margin-top: auto;
        }

        .soon-badge {
            font-size: 0.58rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            background: rgba(100,116,139,0.12);
            color: var(--texto-suave);
            padding: 2px 7px;
            border-radius: 3px;
            margin-left: 6px;
            vertical-align: middle;
        }

        .quick-card.disabled {
            opacity: 0.6;
            pointer-events: none;
        }

        /* ── Info del taller ── */
        .taller-card {
            background: #ffffff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            padding: 28px;
            margin-bottom: 24px;
        }

        .taller-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 18px;
        }

        .taller-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

            .taller-item i {
                font-size: 1.2rem;
                color: var(--dorado);
                margin-top: 2px;
                flex-shrink: 0;
            }

            .taller-item strong {
                display: block;
                font-size: 0.82rem;
                font-weight: 600;
                color: var(--texto);
                margin-bottom: 2px;
            }

            .taller-item span {
                font-size: 0.78rem;
                color: var(--texto-suave);
            }

        /* ── Stats ── */
        .bg-blue-soft { background: rgba(37,99,235,.08); }
        .bg-green-soft { background: rgba(22,163,74,.08); }
        .bg-purple-soft { background: rgba(124,58,237,.08); }
        .bg-orange-soft { background: rgba(234,88,12,.08); }
    </style>
</head>
<body>

    <!-- Topbar -->
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@nombre</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <!-- Sidebar -->
    @await Html.PartialAsync("~/Views/Shared/_ClienteSidebar.cshtml")

    <!-- Contenido -->
    <main class="admin-content">

        <!-- Encabezado -->
        <div class="section-header">
            <div>
                <h1 class="section-title">Mi Portal</h1>
                <p class="section-sub">Consulta tus vehículos, órdenes y servicios del taller</p>
            </div>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok mb-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div>
        }

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon bg-blue-soft"><i class="bi bi-clipboard2-check text-primary"></i></div>
                <div>
                    <div class="stat-num">@totalOrdenes</div>
                    <div class="stat-label">Total de órdenes</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-orange-soft"><i class="bi bi-hourglass-split" style="color:#ea580c"></i></div>
                <div>
                    <div class="stat-num">@ordenesActivas</div>
                    <div class="stat-label">Órdenes activas</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-green-soft"><i class="bi bi-car-front-fill text-success"></i></div>
                <div>
                    <div class="stat-num">@totalVehiculos</div>
                    <div class="stat-label">Vehículos registrados</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-purple-soft"><i class="bi bi-shield-check" style="color:#7c3aed"></i></div>
                <div>
                    <div class="stat-num">Activo</div>
                    <div class="stat-label">Estado de cuenta</div>
                </div>
            </div>
        </div>

        <!-- Accesos rápidos -->
        <div class="panel-section">
            <div class="section-mini-header">
                <div>
                    <h2>Accesos rápidos</h2>
                    <p>Navega entre las secciones de tu portal de cliente</p>
                </div>
            </div>

            <div class="quick-grid">
                <a href="/Cliente/MisOrdenes" class="quick-card">
                    <div class="quick-card-icon icon-blue">
                        <i class="bi bi-clipboard2-check-fill"></i>
                    </div>
                    <p class="quick-card-title">Mis Órdenes</p>
                    <p class="quick-card-desc">Revisa el estado actual de tus órdenes de trabajo y diagnósticos en tiempo real.</p>
                    <span class="quick-card-arrow">Ver órdenes <i class="bi bi-arrow-right"></i></span>
                </a>

                <a href="/Cliente/MisVehiculos" class="quick-card">
                    <div class="quick-card-icon icon-gold">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <p class="quick-card-title">Mis Vehículos</p>
                    <p class="quick-card-desc">Consulta y administra los vehículos registrados a tu nombre en el taller.</p>
                    <span class="quick-card-arrow">Ver vehículos <i class="bi bi-arrow-right"></i></span>
                </a>

                <a href="/Citas/Index" class="quick-card">
                    <div class="quick-card-icon icon-purple">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <p class="quick-card-title">Agendar Cita</p>
                    <p class="quick-card-desc">Solicita una cita con el taller para revisión, mantenimiento o diagnóstico.</p>
                    <span class="quick-card-arrow">Agendar <i class="bi bi-arrow-right"></i></span>
                </a>

                <a href="/Cliente/EditarPerfil" class="quick-card">
                    <div class="quick-card-icon icon-orange">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                    <p class="quick-card-title">Mi Perfil</p>
                    <p class="quick-card-desc">Actualiza tus datos personales, foto de perfil y contraseña de acceso.</p>
                    <span class="quick-card-arrow">Editar perfil <i class="bi bi-arrow-right"></i></span>
                </a>

                <a href="#" class="quick-card disabled">
                    <div class="quick-card-icon icon-green">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <p class="quick-card-title">Mis Facturas <span class="soon-badge">Pronto</span></p>
                    <p class="quick-card-desc">Descarga y consulta el historial de pagos y facturas emitidas.</p>
                    <span class="quick-card-arrow">Ver facturas <i class="bi bi-arrow-right"></i></span>
                </a>

                <a href="#" class="quick-card disabled">
                    <div class="quick-card-icon icon-blue">
                        <i class="bi bi-tools"></i>
                    </div>
                    <p class="quick-card-title">Mantenimiento <span class="soon-badge">Pronto</span></p>
                    <p class="quick-card-desc">Consulta los próximos mantenimientos recomendados para tu vehículo.</p>
                    <span class="quick-card-arrow">Ver plan <i class="bi bi-arrow-right"></i></span>
                </a>
            </div>
        </div>

        <!-- Info del taller -->
        <div class="taller-card">
            <div class="section-mini-header compact">
                <div>
                    <h2>Información del Taller</h2>
                    <p>Contáctanos si necesitas agendar o tienes alguna duda</p>
                </div>
            </div>
            <div class="taller-grid">
                <div class="taller-item">
                    <i class="bi bi-telephone-fill"></i>
                    <div>
                        <strong>Teléfono</strong>
                        <span>+57 318 509 4530</span>
                    </div>
                </div>
                <div class="taller-item">
                    <i class="bi bi-envelope-fill"></i>
                    <div>
                        <strong>Correo</strong>
                        <span>louisfonsea070&#64;gmail.com</span>
                    </div>
                </div>
                <div class="taller-item">
                    <i class="bi bi-clock-fill"></i>
                    <div>
                        <strong>Horario</strong>
                        <span>Lun – Sáb · 8:00 am – 6:00 pm</span>
                    </div>
                </div>
                <div class="taller-item">
                    <i class="bi bi-geo-alt-fill"></i>
                    <div>
                        <strong>Ubicación</strong>
                        <span>Colombia</span>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Activar nav-link según sección -->
    <script>
        document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
            if (link.getAttribute('href') === window.location.pathname) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>
