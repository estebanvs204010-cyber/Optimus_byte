@{
    ViewData["Title"] = "Mis Facturas";
    Layout = null;

    var facturas = ViewBag.Facturas as List<dynamic> ?? new List<dynamic>();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Mis Facturas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="container mt-4">

        <h2>Mis Facturas</h2>

        @if (!facturas.Any())
        {
            <div class="alert alert-warning">
                No tienes facturas registradas.
            </div>
        }
        else
        {
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Factura</th>
                        <th>Orden</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var f in facturas)
                    {
                        <tr>
                            <td>#@f.IdFactura</td>
                            <td>#@f.IdOrden</td>
                            <td>$@String.Format("{0:N0}", f.Total)</td>
                            <td>@f.EstadoPago</td>
                            <td>@f.FechaEmision.ToString("dd/MM/yyyy")</td>

                            <td>
                                @if (f.EstadoPago == "Pendiente")
                                {
                                    <a href="/Cliente/PagarFactura/@f.IdFactura"
                                       class="btn btn-success btn-sm">
                                        Pagar
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Pagada
                                    </span>
                                }
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        }

        <a href="/Cliente/Portal" class="btn btn-secondary">
            Volver
        </a>

    </div>

</body>
</html>