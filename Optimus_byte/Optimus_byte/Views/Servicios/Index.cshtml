@{
    ViewBag.Title = "Nuestros Servicios - Optimus-Byte";
    Layout = null;
    var nombre = Context.Session.GetString("UsuarioNombre");
    var rol = Context.Session.GetString("UsuarioRol");
    bool logueado = !string.IsNullOrEmpty(nombre);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalogo.css" asp-append-version="true" />
    <link href="~/css/Servicios.css" rel="stylesheet" />

</head>

<body>
    <nav class="ob-navbar">
        <button class="ob-hamburger" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <a class="ob-nav-logo" asp-controller="Home" asp-action="Index">
            <img src="~/img/putin.png" alt="Optimus-Byte" />
        </a>


        <div class="ob-nav-acciones">
            @if (!logueado)
            {
                <a class="ob-btn-ingresar"
                   href="/Login/Index?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">
                    Ingresar
                </a>
                <a class="ob-btn-registro" asp-controller="Registro" asp-action="Index">Registrarse</a>
            }
            else
            {
                @await Html.PartialAsync("_MenuUsuarioPartial")
            }
        </div>
    </nav>

    <!-- ══ SIDEBAR ══ -->
    <aside class="ob-sidebar" id="obSidebar">
        <div class="ob-sidebar-title">Optimus-Byte</div>
        <a asp-controller="Home" asp-action="Index">
            <i class="fas fa-house"></i> Inicio
        </a>
        <a asp-controller="Inventario" asp-action="Index">
            <i class="fas fa-boxes-stacked"></i> Inventario
        </a>
        <a asp-controller="Servicios" asp-action="Index">
            <i class="fas fa-screwdriver-wrench"></i> Servicios
        </a>
        <a asp-controller="Citas" asp-action="Index">
            <i class="fas fa-calendar-check"></i> Citas
        </a>
        <a asp-controller="Home" asp-action="AcercaDe">
            <i class="fas fa-circle-info"></i> Acerca de
        </a>
    </aside>

    <div class="ob-overlay" id="obOverlay" onclick="closeSidebar()"></div>


    <div class="hero-card">
        <div class="hero-avatar">C</div>
        <div>
            <h1 class="hero-title">Bienvenido, @User.Identity.Name</h1>
            <p class="hero-subtitle">Este es tu portal de consulta. Aquí puedes ver el estado de tu vehículo y tus servicios.</p>
        </div>
    </div>


    <div class="grid-cards">
        <div class="mini-card">
            <div>
                <img src="~/img/mbasico.jpg"
                     alt="Mantenimiento Básico"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3 class="section-title">Mantenimiento Básico</h3>
                <p class="section-desc">Servicios esenciales para el cuidado preventivo de tu vehículo</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>

        </div>


        <div class="mini-card">
            <div>
                <img src="~/img/rgeneral.jpg"
                     alt="Revison General"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3>Revisión General</h3>
                <p>Inspección completa de niveles, correas, fluidos, luces, suspensión y estado general del vehículo.</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>

        <div class="mini-card">
            <div>
                <img src="~/img/frenos.jpg"
                     alt="Mis Facturas"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3>Sistema de Frenos</h3>
                <p>Revisión y mantenimiento de pastillas, discos, líquido de frenos y funcionamiento general del sistema.</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>

        <div class="mini-card">
            <div>
                <img src="~/img/aceite.jpg"
                     alt="Mis Facturas"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3>Cambio de aceite</h3>
                <p>Mantenimiento preventivo que consiste en reemplazar el aceite del motor y el filtro para garantizar una correcta lubricación y prolongar la vida útil del vehículo.</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>
        <div class="mini-card">
            <div>
                <img src="~/img/balanceo.jpg"
                     alt="Mis Facturas"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;">
                <h3>Balanceo</h3>
                <p>Realizamos el balanceo de ruedas con equipos especializados para eliminar vibraciones y garantizar un desgaste uniforme de las llantas.</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>

        <div class="mini-card">
            <div>
                <img src="~/img/electrico.jpg"
                     alt="Mis Facturas"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3>Sistema Eléctrico</h3>
                <p>diagnóstico, reparación y mantenimiento del sistema eléctrico de tu vehículo, asegurando el correcto funcionamiento de la batería, luces, alternador</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>

        <div class="mini-card">
            <div>
                <img src="~/img/Llantas.jpg"
                     alt="Mis Facturas"
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3>Llantas</h3>
                <p>revisión, montaje, reparación y mantenimiento de llantas para garantizar una conducción segura, cómoda.</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>

        <div class="mini-card">
            <div>
                <img src="~/img/Suspe.jpg"
                     alt="Mis Facturas" c
                     style="
                 width: 300px;
                 height: 100px;
                 object-fit: cover;
                 border-radius: 15px 15px 0 0;
                 margin: -24px -24px 18px -24px;
                 display: block;
             ">
                <h3>Suspensión</h3>
                <p>servicios de inspección, mantenimiento y reparación del sistema de suspensión, mejorando la estabilidad</p>
            </div>
            <a class="mini-link" href="@Url.Action("Index", "Citas")">AGENDAR CITA →</a>
        </div>

    </div>
    <script>
        function toggleMenu(btn) {
            const menu = document.getElementById('menuUsuario');
            menu.classList.toggle('abierto');
            document.addEventListener('click', function cerrar(e) {
                if (!btn.contains(e.target) && !menu.contains(e.target)) {
                    menu.classList.remove('abierto');
                    document.removeEventListener('click', cerrar);
                }
            });
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('obSidebar');
            const overlay = document.getElementById('obOverlay');
            const isOpen = sidebar.classList.contains('activa');
            if (isOpen) {
                closeSidebar();
            } else {
                sidebar.classList.add('activa');
                overlay.classList.add('activa');
            }
        }

        function closeSidebar() {
            document.getElementById('obSidebar').classList.remove('activa');
            document.getElementById('obOverlay').classList.remove('activa');
        }

        document.querySelectorAll('.ob-sidebar a').forEach(function(link) {
            link.addEventListener('click', closeSidebar);
        });
    </script>
</body>
</html>