@{
    ViewBag.Title = "Nuestros Servicios - Optimus-Byte";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --bg: #f6f3ed;
        --card: #ffffff;
        --text: #1f2937;
        --muted: #7b8794;
        --line: #d9e2f2;
        --blue: #3b6bdc;
        --blue-soft: #eaf1ff;
        --shadow: 0 2px 10px rgba(31, 41, 55, .06);
        --radius: 10px;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
    }

    .page-wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 24px 18px 40px;
    }

    .topbar {
        background: var(--card);
        border-bottom: 1px solid #e7edf5;
        box-shadow: var(--shadow);
        height: 60px;
        display: flex;
        align-items: center;
    }

    .topbar-inner {
        max-width: 1120px;
        width: 100%;
        margin: 0 auto;
        padding: 0 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        color: var(--blue);
        font-size: 22px;
        letter-spacing: .5px;
    }

        .brand i {
            font-size: 22px;
        }

    .brand-tag {
        border: 1px solid #d7e3ff;
        background: #f4f8ff;
        color: #6f89c9;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 2px;
        letter-spacing: .12em;
    }

    .userbox {
        display: flex;
        align-items: center;
        gap: 14px;
        color: #6b7280;
        font-size: 14px;
    }

    .logout-btn {
        border: 1px solid #d7dde8;
        background: #fff;
        color: #7b8794;
        font-size: 12px;
        letter-spacing: .12em;
        padding: 8px 14px;
        border-radius: 2px;
        text-decoration: none;
    }

    .hero-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-left: 3px solid var(--blue);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 26px 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .hero-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #eef4ff;
        color: var(--blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 28px;
        border: 1px solid #cfdcfb;
        flex: 0 0 auto;
    }

    .hero-title {
        font-size: 30px;
        font-family: Georgia, "Times New Roman", serif;
        margin: 0 0 4px;
        color: #202938;
        font-weight: 500;
    }

    .hero-subtitle {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
    }

    .grid-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 34px;
    }

    .mini-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 28px 22px;
        min-height: 250px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .mini-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 18px;
    }

    .blue {
        background: #eef3ff;
        color: #3b6bdc;
    }

    .teal {
        background: #e8f4f7;
        color: #2f7f96;
    }

    .green {
        background: #edf8ef;
        color: #3f9a56;
    }

    .purple {
        background: #f1ecff;
        color: #8b5cf6;
    }

    .mini-card h3 {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 22px;
        margin: 0 0 12px;
        font-weight: 500;
        color: #202938;
    }

    .mini-card p {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 22px;
    }

    .mini-link {
        text-decoration: none;
        color: #6d84c8;
        font-size: 12px;
        letter-spacing: .16em;
        font-weight: 600;
    }

    .section-box {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 28px;
    }

        .section-box h2 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 28px;
            font-weight: 500;
            margin: 0 0 8px;
            color: #202938;
        }

        .section-box .desc {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 20px;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .info-card {
        background: #eef3f9;
        border: 1px solid #d7e1ef;
        border-radius: 4px;
        padding: 16px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

        .info-card i {
            color: var(--blue);
            font-size: 18px;
            margin-top: 2px;
        }

        .info-card .label {
            font-size: 12px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 4px;
        }

        .info-card .value {
            font-size: 14px;
            color: #4b5563;
        }


 

    .grid-cards, .info-grid {
        grid-template-columns: 1fr;
    }

    }
</style>

<div class="topbar">
    <div class="topbar-inner">
        <div style="display:flex;align-items:center;gap:12px;">
            <div class="brand">
                <i class="bi bi-gear-fill"></i>
                <span>OPTIMUS-BYTE</span>
            </div>
            <span class="brand-tag">CLIENTE</span>
        </div>

        <div class="userbox">
            <span><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
            <a href="@Url.Action("Index", "Home")" class="logout-btn">
                <i class="bi bi-box-arrow-right"></i> SALIR
            </a>
        </div>
    </div>
</div>

<div class="page-wrap">

    <div class="hero-card">
        <div class="hero-avatar">C</div>
        <div>
            <h1 class="hero-title">Bienvenido, @User.Identity.Name</h1>
            <p class="hero-subtitle">Este es tu portal de consulta. Aquí puedes ver el estado de tu vehículo y tus servicios.</p>
        </div>
    </div>

    <div class="grid-cards">
        <div class="mini-card">
            <div>
                <div class="mini-icon blue"><i class="bi bi-car-front-fill"></i></div>
                <h3>Mis Vehículos</h3>
                <p>Consulta los vehículos registrados a tu nombre en el taller.</p>
            </div>
            <a class="mini-link" href="@Url.Action("MisVehiculos", "Cliente")">VER VEHÍCULOS →</a>
        </div>

        <div class="mini-card">
            <div>
                <div class="mini-icon teal"><i class="bi bi-clipboard-check-fill"></i></div>
                <h3>Mis Órdenes</h3>
                <p>Revisa el estado actual de tus órdenes de trabajo y diagnósticos.</p>
            </div>
            <a class="mini-link" href="@Url.Action("MisOrdenes", "Cliente")">VER ÓRDENES →</a>
        </div>

        <div class="mini-card">
            <div>
                <div class="mini-icon green"><i class="bi bi-receipt-cutoff"></i></div>
                <h3>Mis Facturas</h3>
                <p>Descarga y consulta el historial de pagos y facturas emitidas.</p>
            </div>
            <a class="mini-link" href="#">VER FACTURAS →</a>
        </div>

        <div class="mini-card">
            <div>
                <div class="mini-icon purple"><i class="bi bi-tools"></i></div>
                <h3>Mantenimiento</h3>
                <p>Consulta los próximos mantenimientos recomendados para tu vehículo.</p>
            </div>
            <a class="mini-link" href="#">VER PLAN →</a>
        </div>
    </div>

    <div class="section-box">
        <h2>Información del Taller</h2>
        <div class="desc">Contáctanos si necesitas agendar o tienes alguna duda</div>

        <div class="info-grid">
            <div class="info-card">
                <i class="bi bi-telephone-fill"></i>
                <div>
                    <div class="label">Teléfono</div>
                    <div class="value">+57 318 509 4530</div>
                </div>
            </div>

            <div class="info-card">
                <i class="bi bi-envelope-fill"></i>
                <div>
                    <div class="label">Correo</div>
                    <div class="value">louisfonsea070@gmail.com</div>
                </div>
            </div>

            <div class="info-card">
                <i class="bi bi-clock-fill"></i>
                <div>
                    <div class="label">Horario</div>
                    <div class="value">Lun – Sáb · 8:00 am – 6:00 pm</div>
                </div>
            </div>

            <div class="info-card">
                <i class="bi bi-geo-alt-fill"></i>
                <div>
                    <div class="label">Ubicación</div>
                    <div class="value">Colombia</div>
                </div>
            </div>
        </div>
    </div>

</div>