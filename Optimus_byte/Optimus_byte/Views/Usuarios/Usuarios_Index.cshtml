@model List<Optimus_byte.Models.ViewModels.UsuarioEditarViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = null;

    var solicitudes = ViewBag.SolicitudesPendientes as List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>();
    var stockBajo = ViewBag.RepuestosBajoStockList as List<Optimus_byte.Models.ViewModels.RepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.RepuestoViewModel>();
    int totalNotif = solicitudes.Count + stockBajo.Count;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Gestión de Usuarios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        /* ── Campanita ── */
        .bell-btn {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 6px;
            color: #1e293b; 
            font-size: 1.55rem; 

            transition: color .2s, transform .2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .bell-btn:hover {
                color: var(--dorado);
                transform: scale(1.05); 
            }

        .bell-badge {
            position: absolute;
            top: -1px;
            right: -1px;
            background: #ef4444;
            color: #fff;
            font-size: .65rem; 
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            line-height: 1;
            border: 1.5px solid #ffffff;
        }
        /* ── Panel notificaciones ── */
        .notif-panel {
            display: none;
            position: fixed;
            top: 54px;
            right: 18px;
            width: 370px;
            max-height: 500px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            box-shadow: 0 8px 30px rgba(0,0,0,.12);
            z-index: 9999;
        }

            .notif-panel.open {
                display: block;
            }

        .notif-header {
            padding: 12px 16px;
            border-bottom: 1px solid var(--borde-input);
            font-size: .75rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notif-section-title {
            padding: 8px 16px 4px;
            font-size: .65rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            background: var(--grafito-med);
            border-bottom: 1px solid var(--borde-input);
        }

        .notif-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(0,0,0,.04);
            font-size: .82rem;
        }

            .notif-item:last-child {
                border-bottom: none;
            }

        .notif-titulo {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 2px;
        }

        .notif-sub {
            color: #64748b;
            font-size: .76rem;
        }

        .notif-hora {
            color: #94a3b8;
            font-size: .7rem;
            margin-top: 4px;
        }

        .notif-empty {
            padding: 24px 16px;
            text-align: center;
            color: #94a3b8;
            font-size: .82rem;
        }

        .stock-alerta-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(220,38,38,.08);
            border: 1px solid rgba(220,38,38,.25);
            color: #b91c1c;
            border-radius: 4px;
            font-size: .7rem;
            font-weight: 600;
            padding: 3px 9px;
        }
    </style>
</head>
<body>

    <!-- ── TOPBAR ── -->
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">

            <!-- CAMPANITA -->
            <button class="bell-btn" id="btnCampana" title="Notificaciones" onclick="toggleNotif()">
                <i class="bi bi-bell-fill"></i>
                @if (totalNotif > 0)
                {
                    <span class="bell-badge" id="bellBadge">@totalNotif</span>
                }
            </button>

            <a href="/Home/Index" class="ob-btn-home">Home</a>
            <a href="/Login/Logout" class="ob-btn-salir">
                <i ></i>Salir
            </a>
        </div>
    </div>

    <!-- ── PANEL NOTIFICACIONES ── -->
    <div class="notif-panel" id="notifPanel">
        <div class="notif-header">
            <span><i class="bi bi-bell me-1"></i>Notificaciones</span>
            @if (totalNotif > 0)
            {
                <span style="background:#ef4444;color:#fff;font-size:.65rem;padding:2px 7px;border-radius:10px">
                    @totalNotif pendiente(s)
                </span>
            }
        </div>

        @* — Solicitudes de repuesto — *@
        @if (solicitudes.Any())
        {
            <div class="notif-section-title"><i class="bi bi-box-seam me-1"></i>Solicitudes de repuesto (@solicitudes.Count)</div>
            @foreach (var s in solicitudes)
            {
                bool esLibre = s.NombreRepuesto?.StartsWith("[Sin inventario]") ?? false;
                string nombreMostrar = esLibre ? s.NombreRepuesto!.Replace("[Sin inventario]", "").Trim() : (s.NombreRepuesto ?? "—");
                <div class="notif-item">
                    <div class="notif-titulo">
                        <i class="bi bi-box-seam me-1" style="color:#f97316"></i>
                        @if (esLibre)
                        {
                            <span style="font-size:.63rem;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:1px 6px;margin-right:4px">Sin inventario</span>
                        }
                        @nombreMostrar <span style="color:#94a3b8;font-weight:400"> × @s.Cantidad</span>
                    </div>
                    <div class="notif-sub">OT-@s.IdOrden &nbsp;·&nbsp; @s.MecanicoNombre</div>
                    @if (!string.IsNullOrWhiteSpace(s.Motivo))
                    {
                        <div class="notif-sub" style="margin-top:2px;font-style:italic"><i class="bi bi-chat-left-text me-1"></i>@s.Motivo</div>
                    }
                    <div class="notif-hora">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
                        @if (esLibre)
                        {
                            <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-plus-circle"></i> Crear en inventario
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Admin" asp-action="AceptarSolicitudRepuesto" method="post" style="display:inline" onsubmit="return confirm('¿Aceptar y descontar stock de este repuesto?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                                <input type="hidden" name="ordenId" value="@s.IdOrden" />
                                <input type="hidden" name="repuestoNombre" value="@nombreMostrar" />
                                <input type="hidden" name="cantidad" value="@s.Cantidad" />
                                <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#22c55e;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                    <i class="bi bi-check2"></i> Aceptar
                                </button>
                            </form>
                        }
                        <form asp-controller="Admin" asp-action="RechazarSolicitudRepuesto" method="post" style="display:inline" onsubmit="return confirm('¿Rechazar esta solicitud?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                            <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#ef4444;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-x-lg"></i> Rechazar
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

        @* — Stock bajo — *@
        @if (stockBajo.Any())
        {
            <div class="notif-section-title"><i class="bi bi-exclamation-triangle-fill me-1" style="color:#dc2626"></i>Stock bajo (@stockBajo.Count repuesto(s))</div>
            @foreach (var r in stockBajo)
            {
                <div class="notif-item">
                    <div class="notif-titulo">
                        <span class="stock-alerta-chip"><i class="bi bi-exclamation-triangle-fill"></i>STOCK BAJO</span>
                        <span style="margin-left:6px">@r.Nombre</span>
                    </div>
                    <div class="notif-sub" style="margin-top:4px">
                        Stock actual: <strong style="color:#dc2626">@r.StockActual</strong> &nbsp;·&nbsp; Mínimo: @r.StockMinimo
                        &nbsp;·&nbsp; Ref: <span style="font-family:monospace">@r.Referencia</span>
                    </div>
                    <div style="margin-top:6px">
                        <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                            <i class="bi bi-arrow-up-circle"></i> Actualizar stock
                        </a>
                    </div>
                </div>
            }
        }

        @if (totalNotif == 0)
        {
            <div class="notif-empty">
                <i class="bi bi-check-circle" style="font-size:1.8rem;display:block;margin-bottom:8px;color:#22c55e"></i>
                Sin notificaciones pendientes
            </div>
        }

        @if (solicitudes.Any())
        {
            <div style="padding:10px 16px;text-align:right">
                <a href="/Admin/SolicitudesRepuesto" style="font-size:.76rem;color:var(--dorado);text-decoration:none">
                    Ver todas las solicitudes <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
    </div>

    <!-- ── SIDEBAR ── -->
    

    <aside class="admin-sidebar">
       

        <nav class="admin-sidebar">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                string nombreCompleto = User.Identity.Name ?? "Administrador";
                string inicial = !string.IsNullOrEmpty(nombreCompleto) ? nombreCompleto.Substring(0, 1).ToUpper() : "A";
                string rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Administrador";

                <div class="admin-sidebar-profile-vertical">
                    <div class="admin-avatar-circle-lg">@inicial</div>
                    <div class="admin-avatar-name-vertical">@nombreCompleto</div>
                    <div class="admin-role-pill">@rolUsuario</div>
                </div>
            }
            else
            {
                <div class="admin-sidebar-profile-vertical">
                    <div class="admin-avatar-circle-lg">A</div>
                    <div class="admin-avatar-name-vertical">Administrador</div>
                    <div class="admin-role-pill">SuperAdmin</div>
                </div>
            }
            <a href="/Usuarios" class="nav-link active"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes" class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Admin/Facturas" class="nav-link"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Admin/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            <a href="/VehiculosAdmin/Index" class="nav-link"><i class="bi bi-car-front-fill"></i><span>Vehículos</span></a>
            <a href="/Admin/SolicitudesRepuesto" class="nav-link" style="position:relative">
                <i class="bi bi-bell-fill"></i>
                <span>Solicitudes</span>
                @if (solicitudes.Count > 0)
                {
                    <span style="position:absolute;top:6px;right:10px;background:#ef4444;color:#fff;font-size:.55rem;font-weight:700;min-width:15px;height:15px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px">@solicitudes.Count</span>
                }
            </a>
        </div>
    </aside>

    <!-- ── CONTENIDO ── -->
    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Gestión de Usuarios</h1>
                <p class="section-sub">Administra mecánicos y clientes del sistema</p>
            </div>
            <a asp-controller="Usuarios" asp-action="Crear" class="btn-nuevo">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Usuario
            </a>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err">
                <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
            </div>
        }

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon" style="background:#1e3a5f">
                    <i class="bi bi-people-fill text-info"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count</div>
                    <div class="stat-label">Total usuarios</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#2a2a1a">
                    <i class="bi bi-wrench-adjustable-circle-fill text-warning"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(u => u.NombreRol == "Mecanico")</div>
                    <div class="stat-label">Mecánicos</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#1a3a2a">
                    <i class="bi bi-person-check-fill text-success"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(u => u.NombreRol == "Cliente")</div>
                    <div class="stat-label">Clientes</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#3a1e1e">
                    <i class="bi bi-person-dash-fill text-danger"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(u => !u.Activo)</div>
                    <div class="stat-label">Inactivos</div>
                </div>
            </div>
        </div>

        <div class="filtro-bar">
            <div class="input-buscar">
                <i class="bi bi-search"></i>
                <input type="text" id="buscarInput"
                       placeholder="Buscar por nombre o correo..."
                       onkeyup="filtrarTabla()" />
            </div>
            <select id="filtroRol" class="filtro-select" onchange="filtrarTabla()">
                <option value="">Todos los roles</option>
                <option value="Admin">Admin</option>
                <option value="Mecanico">Mecánico</option>
                <option value="Cliente">Cliente</option>
            </select>
            <select id="filtroEstado" class="filtro-select" onchange="filtrarTabla()">
                <option value="">Todos los estados</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>

        <div class="tabla-wrapper">
            <table class="tabla-usuarios" id="tablaUsuarios">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var (badgeClass, icono) = u.NombreRol switch
                        {
                            "Admin" => ("badge-admin-rol", "bi-shield-fill"),
                            "Mecanico" => ("badge-mec", "bi-wrench-adjustable"),
                            "Cliente" => ("badge-cli", "bi-person-fill"),
                            _ => ("badge-default", "bi-question-circle")
                        };
                        <tr class="fila-usuario @(u.Activo ? "" : "fila-inactiva")"
                            data-nombre="@u.NombreCompleto.ToLower()"
                            data-correo="@u.Correo.ToLower()"
                            data-rol="@u.NombreRol"
                            data-estado="@(u.Activo ? "Activo" : "Inactivo")">

                            <td>@u.IdUsuario</td>

                            <td class="td-nombre">
                                <div class="avatar-circle">@u.NombreCompleto.Substring(0, 1).ToUpper()</div>
                                <span>@u.NombreCompleto</span>
                            </td>

                            <td class="td-correo">@u.Correo</td>

                            <td>@(string.IsNullOrEmpty(u.Telefono) ? "—" : u.Telefono)</td>

                            <td>
                                <span class="rol-badge @badgeClass">
                                    <i class="bi @icono me-1" style="font-size:.7rem"></i>
                                    @(string.IsNullOrEmpty(u.NombreRol) ? "Sin rol" : u.NombreRol)
                                </span>
                            </td>

                            <td>
                                @if (u.Activo)
                                {
                                    <span class="estado-badge estado-activo">
                                        <i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="estado-badge estado-inactivo">
                                        <i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>Inactivo
                                    </span>
                                }
                            </td>

                            <td class="td-acciones">
                                <a asp-controller="Usuarios" asp-action="Editar"
                                   asp-route-id="@u.IdUsuario"
                                   class="btn-accion btn-editar" title="Editar usuario">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                @if (u.Activo)
                                {
                                    <form asp-controller="Usuarios" asp-action="Desactivar"
                                          asp-route-id="@u.IdUsuario" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Desactivar a @u.NombreCompleto?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-accion btn-desactivar" title="Desactivar">
                                            <i class="bi bi-person-dash-fill"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Usuarios" asp-action="Reactivar"
                                          asp-route-id="@u.IdUsuario" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Reactivar a @u.NombreCompleto?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-accion btn-reactivar" title="Reactivar">
                                            <i class="bi bi-person-check-fill"></i>
                                        </button>
                                    </form>
                                }

                                <!-- ✦ BOTÓN ELIMINAR -->
                                <form asp-controller="Usuarios" asp-action="Eliminar"
                                      asp-route-id="@u.IdUsuario" method="post" class="d-inline"
                                      onsubmit="return confirm('⚠️ ¿Eliminar PERMANENTEMENTE a @u.NombreCompleto?\n\nEsta acción no se puede deshacer.')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-accion btn-eliminar" title="Eliminar permanentemente">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="tabla-vacia">
                    <i class="bi bi-people" style="font-size:3rem;color:#334155"></i>
                    <p class="mt-2">No hay usuarios registrados aún.</p>
                    <a asp-controller="Usuarios" asp-action="Crear" class="btn-nuevo mt-2">
                        Crear primer usuario
                    </a>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        /* ── Filtro tabla ── */
        function filtrarTabla() {
            const buscar = document.getElementById('buscarInput').value.toLowerCase();
            const rol    = document.getElementById('filtroRol').value;
            const estado = document.getElementById('filtroEstado').value;

            document.querySelectorAll('.fila-usuario').forEach(fila => {
                const okBuscar = !buscar ||
                    fila.dataset.nombre.includes(buscar) ||
                    fila.dataset.correo.includes(buscar);
                const okRol    = !rol    || fila.dataset.rol    === rol;
                const okEstado = !estado || fila.dataset.estado === estado;
                fila.style.display = (okBuscar && okRol && okEstado) ? '' : 'none';
            });
        }

        /* ── Campanita ── */
        function toggleNotif() {
            document.getElementById('notifPanel').classList.toggle('open');
        }
        document.addEventListener('click', function (e) {
            const panel = document.getElementById('notifPanel');
            const btn   = document.getElementById('btnCampana');
            if (panel && btn && !panel.contains(e.target) && !btn.contains(e.target)) {
                panel.classList.remove('open');
            }
        });

        /* Polling badge cada 30s */
        setInterval(async () => {
            try {
                const res  = await fetch('/Admin/NotificacionesCount');
                const data = await res.json();
                const badge = document.getElementById('bellBadge');
                const total = (data.solicitudes || 0) + (data.stockBajo || 0);
                if (total > 0) {
                    if (!badge) {
                        const b = document.createElement('span');
                        b.id = 'bellBadge'; b.className = 'bell-badge'; b.textContent = total;
                        document.getElementById('btnCampana').appendChild(b);
                    } else { badge.textContent = total; }
                } else if (badge) { badge.remove(); }
            } catch (e) {}
        }, 30000);
    </script>
</body>
</html>
