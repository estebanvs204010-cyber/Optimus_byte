@model Usuario
@{
    ViewData["Title"] = "Nuevo Usuario";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Nuevo Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
</head>
<body>

    @* ── Topbar ── *@
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Administrador</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name">
                <i class="bi bi-person-circle me-1"></i>
                @Context.Session.GetString("UsuarioNombre")
            </span>
            <a href="/Login/Logout" class="btn-salir">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>

    @* ── Sidebar ── *@
    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Login/Usuarios_Index" class="nav-link active">
                <i class="bi bi-people-fill"></i><span>Usuarios</span>
            </a>
            <a href="/Admin/Ordenes" class="nav-link">
                <i class="bi bi-clipboard2-check"></i><span>Órdenes</span>
            </a>
            <a href="/Admin/Inventario" class="nav-link">
                <i class="bi bi-box-seam"></i><span>Inventario</span>
            </a>
            <a href="/Admin/Facturas" class="nav-link">
                <i class="bi bi-receipt"></i><span>Facturas</span>
            </a>
            <a href="/Admin/Dashboard" class="nav-link">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
        </nav>
    </div>

    @* ── Contenido ── *@
    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Nuevo Usuario</h1>
                <p class="section-sub">Registra un administrador, mecánico o cliente</p>
            </div>
            <a href="/Login/Usuarios_Index" class="btn-volver">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
        </div>

        <div class="form-card">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alerta alerta-err mb-4">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-controller="Usuarios" asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <div class="form-group-custom">
                        <label asp-for="NombreCompleto">Nombre completo</label>
                        <div class="input-wrap">
                            <i class="bi bi-person"></i>
                            <input asp-for="NombreCompleto" class="input-custom" placeholder="Nombre completo" />
                        </div>
                        <span asp-validation-for="NombreCompleto" class="err-msg"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Correo">Correo electrónico</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Correo" type="email" class="input-custom" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Correo" class="err-msg"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Telefono">Teléfono</label>
                        <div class="input-wrap">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="Telefono" class="input-custom" placeholder="300 123 4567" />
                        </div>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="IdRol">Rol del usuario</label>
                        <div class="input-wrap">
                            <i class="bi bi-shield-check"></i>
                            <select asp-for="IdRol" class="input-custom select-custom" id="selectRol" onchange="actualizarPreview(this)">
                                <option value="">— Selecciona un rol —</option>
                                @foreach (var rol in (List<VistaPrincipal.Models.Rol>)ViewBag.Roles)
                                {
                                    var emoji = rol.NombreRol switch
                                    {
                                        "Admin" => "🛡️",
                                        "Mecanico" => "🔧",
                                        "Cliente" => "👤",
                                        _ => "⚙️"
                                    };
                                    <option value="@rol.RolId">@emoji @rol.NombreRol</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="IdRol" class="err-msg"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Contrasena">Contraseña</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Contrasena" type="password" id="inputPass" class="input-custom" placeholder="••••••••" />
                            <button type="button" class="btn-ojo" onclick="togglePass('inputPass', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena" class="err-msg"></span>
                    </div>

                    <div class="form-group-custom justify-content-center pt-2" id="rolPreview" style="display:none">
                        <label>Rol seleccionado</label>
                        <div class="mt-2">
                            <span class="rol-badge" id="rolBadge">
                                <i class="bi me-1" id="rolIcono" style="font-size:.7rem"></i>
                                <span id="rolNombre">—</span>
                            </span>
                        </div>
                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-guardar">
                        <i class="bi bi-person-plus-fill me-2"></i>Crear usuario
                    </button>
                    <a href="/Login/Usuarios_Index" class="btn-cancelar">Cancelar</a>
                </div>

            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePass(id, btn) {
            const inp = document.getElementById(id);
            const icon = btn.querySelector('i');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }

        const rolConfig = {
            'Admin':    { badge: 'badge-admin-rol', icono: 'bi-shield-fill' },
            'Mecanico': { badge: 'badge-mec',       icono: 'bi-wrench-adjustable' },
            'Cliente':  { badge: 'badge-cli',       icono: 'bi-person-fill' },
        };

        function actualizarPreview(sel) {
            const preview = document.getElementById('rolPreview');
            if (!sel.value) { preview.style.display = 'none'; return; }

            const nombre = sel.options[sel.selectedIndex].text.replace(/^\S+\s*/, '').trim();
            const cfg    = rolConfig[nombre] ?? { badge: 'badge-default', icono: 'bi-question-circle' };

            document.getElementById('rolBadge').className = 'rol-badge ' + cfg.badge;
            document.getElementById('rolIcono').className = 'bi ' + cfg.icono + ' me-1';
            document.getElementById('rolNombre').textContent = nombre;
            preview.style.display = 'block';
        }
    </script>
</body>
</html>
