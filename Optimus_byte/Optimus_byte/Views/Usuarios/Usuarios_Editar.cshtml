@model Optimus_byte.Models.ViewModels.UsuarioEditarViewModel
@{
    ViewData["Title"] = "Editar Usuario";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Editar Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>

    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Administrador</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name">
                <i class="bi bi-person-circle me-1"></i>
                @Context.Session.GetString("UsuarioNombre")
            </span>
            <a href="/Login/Logout" class="btn-salir">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link active">
                <i class="bi bi-people-fill"></i><span>Usuarios</span>
            </a>
            <a href="/Admin/Ordenes" class="nav-link">
                <i class="bi bi-clipboard2-check"></i><span>Órdenes</span>
            </a>
            <a href="/Admin/Inventario" class="nav-link">
                <i class="bi bi-box-seam"></i><span>Inventario</span>
            </a>
            <a href="/Admin/Facturas" class="nav-link">
                <i class="bi bi-receipt"></i><span>Facturas</span>
            </a>
            <a href="/Admin/Dashboard" class="nav-link">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
        </nav>
    </div>

    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Editar Usuario</h1>
                <p class="section-sub">
                    Modificando a <strong style="color:#e2e8f0">@Model.NombreCompleto</strong>
                    @{
                        var rolActual = (List<Optimus_byte.Models.Rol>)ViewBag.Roles;
                        var nombreRol = rolActual.FirstOrDefault(r => r.RolId == Model.IdRol)?.NombreRol ?? "";
                        var (bc, ic) = nombreRol switch
                        {
                            "Admin" => ("badge-admin-rol", "bi-shield-fill"),
                            "Mecanico" => ("badge-mec", "bi-wrench-adjustable"),
                            "Cliente" => ("badge-cli", "bi-person-fill"),
                            _ => ("badge-default", "bi-question-circle")
                        };
                    }
                    <span class="rol-badge @bc ms-2">
                        <i class="bi @ic me-1" style="font-size:.7rem"></i>@nombreRol
                    </span>
                </p>
            </div>
            <a asp-controller="Usuarios" asp-action="Index" class="btn-volver">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
        </div>

        <div class="form-card">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alerta alerta-err mb-4">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-controller="Usuarios" asp-action="Editar"
                  asp-route-id="@Model.IdUsuario" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid">

                    @* Nombre *@
                    <div class="form-group-custom">
                        <label asp-for="NombreCompleto">Nombre completo</label>
                        <div class="input-wrap">
                            <i class="bi bi-person"></i>
                            <input asp-for="NombreCompleto" class="input-custom"
                                   placeholder="Nombre completo" />
                        </div>
                        <span asp-validation-for="NombreCompleto" class="err-msg"></span>
                    </div>

                    @* Correo *@
                    <div class="form-group-custom">
                        <label asp-for="Correo">Correo electrónico</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Correo" type="email" class="input-custom"
                                   placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Correo" class="err-msg"></span>
                    </div>

                    @* Teléfono *@
                    <div class="form-group-custom">
                        <label asp-for="Telefono">Teléfono</label>
                        <div class="input-wrap">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="Telefono" class="input-custom"
                                   placeholder="300 123 4567" />
                        </div>
                    </div>

                    @* Rol — solo 3 opciones *@
                    <div class="form-group-custom">
                        <label asp-for="IdRol">Rol del usuario</label>
                        <div class="input-wrap">
                            <i class="bi bi-shield-check"></i>
                            <select asp-for="IdRol" class="input-custom select-custom">
                                @foreach (var rol in (List<Optimus_byte.Models.Rol>)ViewBag.Roles)
                                {
                                    <option value="@rol.RolId"
                                            selected="@(rol.RolId == Model.IdRol ? "selected" : null)">
                                        @* Mostrar ícono según rol *@
                                        @(rol.NombreRol == "Admin" ? "🛡️ Admin" :
                                                                            rol.NombreRol == "Mecanico" ? "🔧 Mecánico" :
                                                                            "👤 Cliente")
                                </option>
                                                                }
                            </select>
                        </div>
                        <span asp-validation-for="IdRol" class="err-msg"></span>
                    </div>

                    @* Nueva contraseña *@
                    <div class="form-group-custom">
                        <label asp-for="Contrasena">
                            Nueva contraseña
                            <span class="label-hint">(vacío = no cambiar)</span>
                        </label>
                        <div class="input-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Contrasena" type="password" id="inputPass"
                                   class="input-custom" placeholder="••••••••" />
                            <button type="button" class="btn-ojo"
                                    onclick="togglePass('inputPass', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    @* Toggle activo *@
                    <div class="form-group-custom justify-content-center pt-3">
                        <label>Estado del usuario</label>
                        <div class="toggle-wrap mt-2">
                            <input type="checkbox" id="activoCheck"
                                   asp-for="Activo" class="toggle-input" />
                            <label for="activoCheck" class="toggle-slider"></label>
                            <span class="toggle-text" id="toggleText">
                                @(Model.Activo ? "✅ Activo" : "❌ Inactivo")
                            </span>
                        </div>
                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-guardar">
                        <i class="bi bi-floppy-fill me-2"></i>Guardar cambios
                    </button>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn-cancelar">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePass(id, btn) {
            const inp = document.getElementById(id);
            const icon = btn.querySelector('i');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            icon.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
        document.getElementById('activoCheck').addEventListener('change', function () {
            document.getElementById('toggleText').textContent = this.checked ? '✅ Activo' : '❌ Inactivo';
        });
    </script>
</body>
</html>

