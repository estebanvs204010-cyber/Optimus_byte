@{
    var currentPath = Context.Request.Path.Value ?? "";
    var nombre = Context.Session.GetString("UsuarioNombre") ?? "Cliente";
    var inicial = nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "C";
}

<aside class="admin-sidebar">
    <div class="sidebar-user-card">
        <div class="sidebar-avatar">@inicial</div>
        <div class="sidebar-user-info">
            <span class="sidebar-user-name">@nombre</span>
            <span class="sidebar-user-role">CLIENTE</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <a href="/Cliente/Portal"
           class="nav-link @(currentPath.Contains("/Portal") ? "active" : "")">
            <i class="bi bi-house-door-fill"></i><span>Inicio</span>
        </a>
        <a href="/Cliente/MisOrdenes"
           class="nav-link @(currentPath.Contains("/MisOrdenes") ? "active" : "")">
            <i class="bi bi-clipboard2-check-fill"></i><span>Mis Órdenes</span>
        </a>
        <a href="/Cliente/MisVehiculos"
           class="nav-link @(currentPath.Contains("/MisVehiculos") ? "active" : "")">
            <i class="bi bi-car-front-fill"></i><span>Mis Vehículos</span>
        </a>
        <a href="/Citas/Index"
           class="nav-link @(currentPath.Contains("/Citas") ? "active" : "")">
            <i class="bi bi-calendar-check-fill"></i><span>Agendar Cita</span>
        </a>
        <a href="/Cliente/EditarPerfil"
           class="nav-link @(currentPath.Contains("/EditarPerfil") || currentPath.Contains("/perfil") ? "active" : "")">
            <i class="bi bi-person-fill"></i><span>Mi Perfil</span>
        </a>

       
        <div class="sidebar-divider"></div>
        <a href="/Home/Index" class="nav-link">
            <i class="bi bi-globe"></i><span>Página principal</span>
        </a>
        <a href="/Login/Logout" class="nav-link nav-link-logout">
            <i class="bi bi-box-arrow-right"></i><span>Salir</span>
        </a>
    </nav>
</aside>

<style>
    .sidebar-user-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 18px 18px;
        border-bottom: 1px solid var(--borde);
        margin-bottom: 6px;
    }

    .sidebar-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--dorado-suave);
        border: 2px solid var(--borde);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--fuente-titulo);
        font-size: 1.2rem;
        color: var(--dorado);
        font-weight: 700;
        flex-shrink: 0;
    }

    .sidebar-user-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
    }

    .sidebar-user-name {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--texto);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sidebar-user-role {
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--dorado);
        font-weight: 600;
    }

    .sidebar-divider {
        height: 1px;
        background: var(--borde);
        margin: 8px 16px;
    }

    .nav-link-logout:hover {
        color: #dc2626 !important;
        background: rgba(220,38,38,0.05) !important;
        border-left-color: #dc2626 !important;
    }
</style>

