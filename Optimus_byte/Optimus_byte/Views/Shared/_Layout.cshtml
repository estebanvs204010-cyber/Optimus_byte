@{
    var solicitudes = ViewBag.SolicitudesPendientes as List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>();
    var stockBajo = ViewBag.RepuestosBajoStockList as List<Optimus_byte.Models.ViewModels.RepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.RepuestoViewModel>();
    int totalSolicitudes = solicitudes.Count;
    int totalStockBajo = stockBajo.Count;
    int totalNotif = totalSolicitudes + totalStockBajo;

    // La vista activa se detecta por la URL
    string path = Context.Request.Path.Value?.ToLower() ?? "";
    bool isUsuarios = path.StartsWith("/usuarios");
    bool isOrdenes = path.Contains("/admin/ordenes") || path.Contains("/admin/ordendetalle");
    bool isInventario = path.Contains("/admin/inventario");
    bool isFacturas = path.Contains("/admin/facturas");
    bool isDashboard = path.Contains("/admin/dashboard");
    bool isVehiculos = path.Contains("/vehiculosadmin");
    bool isSolicitudes = path.Contains("/admin/solicitudes");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        /* ── Campanita (compartida) ── */
        .bell-btn {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 6px;
            color: var(--texto-suave);
            font-size: 1.25rem;
            transition: color .2s;
        }

            .bell-btn:hover {
                color: var(--dorado);
            }

        .bell-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            background: #ef4444;
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
            line-height: 1;
        }
        /* ── Panel notificaciones ── */
        .notif-panel {
            display: none;
            position: fixed;
            top: 54px;
            right: 18px;
            width: 370px;
            max-height: 500px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            box-shadow: 0 8px 30px rgba(0,0,0,.12);
            z-index: 9999;
        }

            .notif-panel.open {
                display: block;
            }

        .notif-header {
            padding: 12px 16px;
            border-bottom: 1px solid var(--borde-input);
            font-size: .75rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notif-section-title {
            padding: 8px 16px 4px;
            font-size: .65rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            background: var(--grafito-med);
            border-bottom: 1px solid var(--borde-input);
        }

        .notif-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(0,0,0,.04);
            font-size: .82rem;
        }

            .notif-item:last-child {
                border-bottom: none;
            }

        .notif-titulo {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 2px;
        }

        .notif-sub {
            color: #64748b;
            font-size: .76rem;
        }

        .notif-hora {
            color: #94a3b8;
            font-size: .7rem;
            margin-top: 4px;
        }

        .notif-empty {
            padding: 24px 16px;
            text-align: center;
            color: #94a3b8;
            font-size: .82rem;
        }

        .stock-alerta-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(220,38,38,.08);
            border: 1px solid rgba(220,38,38,.25);
            color: #b91c1c;
            border-radius: 4px;
            font-size: .7rem;
            font-weight: 600;
            padding: 3px 9px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    @* ── TOPBAR ── *@
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="bell-btn" id="btnCampana" title="Notificaciones" onclick="toggleNotif()">
                <i class="bi bi-bell-fill"></i>
                @if (totalNotif > 0)
                {
                    <span class="bell-badge" id="bellBadge">@totalNotif</span>
                }
            </button>
            <span class="admin-name">
                <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")
            </span>
            <a href="/Login/Logout" class="btn-salir">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>

    @* ── PANEL DE NOTIFICACIONES ── *@
    <div class="notif-panel" id="notifPanel">
        <div class="notif-header">
            <span><i class="bi bi-bell me-1"></i>Notificaciones</span>
            @if (totalNotif > 0)
            {
                <span style="background:#ef4444;color:#fff;font-size:.65rem;padding:2px 7px;border-radius:10px">
                    @totalNotif pendiente(s)
                </span>
            }
        </div>

        @if (solicitudes.Any())
        {
            <div class="notif-section-title">
                <i class="bi bi-box-seam me-1"></i>Solicitudes de repuesto (@totalSolicitudes)
            </div>
            @foreach (var s in solicitudes)
            {
                bool esLibre = s.NombreRepuesto?.StartsWith("[Sin inventario]") ?? false;
                string nombreMostrar = esLibre
                ? s.NombreRepuesto!.Replace("[Sin inventario]", "").Trim()
                : (s.NombreRepuesto ?? "—");
                <div class="notif-item">
                    <div class="notif-titulo">
                        <i class="bi bi-box-seam me-1" style="color:#f97316"></i>
                        @if (esLibre)
                        {
                            <span style="font-size:.63rem;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:1px 6px;margin-right:4px">Sin inventario</span>
                        }
                        @nombreMostrar <span style="color:#94a3b8;font-weight:400"> × @s.Cantidad</span>
                    </div>
                    <div class="notif-sub">OT-@s.IdOrden &nbsp;·&nbsp; @s.MecanicoNombre</div>
                    @if (!string.IsNullOrWhiteSpace(s.Motivo))
                    {
                        <div class="notif-sub" style="margin-top:2px;font-style:italic">
                            <i class="bi bi-chat-left-text me-1"></i>@s.Motivo
                        </div>
                    }
                    <div class="notif-hora">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
                        @if (esLibre)
                        {
                            <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-plus-circle"></i> Crear en inventario
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Admin" asp-action="AceptarSolicitudRepuesto" method="post"
                                  style="display:inline"
                                  onsubmit="return confirm('¿Aceptar y descontar stock de este repuesto?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                                <input type="hidden" name="ordenId" value="@s.IdOrden" />
                                <input type="hidden" name="repuestoNombre" value="@nombreMostrar" />
                                <input type="hidden" name="cantidad" value="@s.Cantidad" />
                                <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#22c55e;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                    <i class="bi bi-check2"></i> Aceptar
                                </button>
                            </form>
                        }
                        <form asp-controller="Admin" asp-action="RechazarSolicitudRepuesto" method="post"
                              style="display:inline" onsubmit="return confirm('¿Rechazar esta solicitud?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                            <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#ef4444;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-x-lg"></i> Rechazar
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

        @if (stockBajo.Any())
        {
            <div class="notif-section-title">
                <i class="bi bi-exclamation-triangle-fill me-1" style="color:#dc2626"></i>Stock bajo (@totalStockBajo repuesto(s))
            </div>
            @foreach (var r in stockBajo)
            {
                <div class="notif-item">
                    <div class="notif-titulo">
                        <span class="stock-alerta-chip"><i class="bi bi-exclamation-triangle-fill"></i>STOCK BAJO</span>
                        <span style="margin-left:6px">@r.Nombre</span>
                    </div>
                    <div class="notif-sub" style="margin-top:4px">
                        Actual: <strong style="color:#dc2626">@r.StockActual</strong> &nbsp;·&nbsp; Mínimo: @r.StockMinimo
                        &nbsp;·&nbsp; Ref: <span style="font-family:monospace">@r.Referencia</span>
                    </div>
                    <div style="margin-top:6px">
                        <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                            <i class="bi bi-arrow-up-circle"></i> Actualizar stock
                        </a>
                    </div>
                </div>
            }
        }
        else if (!solicitudes.Any())
        {
            <div class="notif-empty">
                <i class="bi bi-check-circle" style="font-size:1.5rem;display:block;margin-bottom:6px;color:#22c55e"></i>
                No hay notificaciones pendientes
            </div>
        }
    </div>

    @* ── SIDEBAR ── *@
       

    @* ── SIDEBAR ── *@
    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link @(isUsuarios ? "active" : "")">
                <i class="bi bi-people-fill"></i><span>Usuarios</span>
            </a>
            <a href="/Admin/Ordenes" class="nav-link @(isOrdenes ? "active" : "")">
                <i class="bi bi-clipboard2-check"></i><span>Órdenes</span>
            </a>
            <a href="/Admin/Inventario" class="nav-link @(isInventario ? "active" : "")">
                <i class="bi bi-box-seam"></i><span>Inventario</span>
            </a>
            <a href="/Admin/Facturas" class="nav-link @(isFacturas ? "active" : "")">
                <i class="bi bi-receipt"></i><span>Facturas</span>
            </a>
            <a href="/Admin/Dashboard" class="nav-link @(isDashboard ? "active" : "")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
            <a href="/VehiculosAdmin/Index" class="nav-link @(isVehiculos ? "active" : "")">
                <i class="bi bi-car-front-fill"></i><span>Vehículos</span>
            </a>
            <a href="/Admin/SolicitudesRepuesto" class="nav-link @(isSolicitudes ? "active" : "")" style="position:relative">
                <i class="bi bi-bell-fill"></i>
                <span>Solicitudes</span>
                @if (totalSolicitudes > 0)
                {
                    <span style="position:absolute;top:6px;right:10px;background:#ef4444;color:#fff;font-size:.55rem;font-weight:700;min-width:15px;height:15px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px">@totalSolicitudes</span>
                }
            </a>
        </nav>
    </div>

    @* ── CONTENIDO DE CADA VISTA ── *@
    <div class="admin-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Campanita ────────────────────────
        function toggleNotif() {
            document.getElementById('notifPanel').classList.toggle('open');
        }
        document.addEventListener('click', function (e) {
            const panel = document.getElementById('notifPanel');
            const btn   = document.getElementById('btnCampana');
            if (panel && btn && !panel.contains(e.target) && !btn.contains(e.target)) {
                panel.classList.remove('open');
            }
        });

        // Polling badge cada 30s
        setInterval(async () => {
            try {
                const res  = await fetch('/Admin/NotificacionesCount');
                const data = await res.json();
                const badge = document.getElementById('bellBadge');
                const total = (data.solicitudes || 0) + (data.stockBajo || 0);
                if (total > 0) {
                    if (!badge) {
                        const b = document.createElement('span');
                        b.id = 'bellBadge'; b.className = 'bell-badge'; b.textContent = total;
                        document.getElementById('btnCampana').appendChild(b);
                    } else { badge.textContent = total; }
                } else if (badge) { badge.remove(); }
            } catch (e) {}
        }, 30000);
    </script>
    @* Scripts específicos de cada vista *@
    @RenderSection("Scripts", required: false)
</body>
</html>
