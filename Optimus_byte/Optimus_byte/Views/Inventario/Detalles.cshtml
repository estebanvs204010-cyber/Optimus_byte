@model Optimus_byte.Models.Repuesto
@using Optimus_byte.Controllers
@{
    ViewData["Title"] = Model.Nombre;
    Layout = null;
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
    bool logueado     = !string.IsNullOrEmpty(Context.Session.GetString("UsuarioId"));

    var cals      = ViewBag.Calificaciones as List<CalificacionViewModel> ?? new();
    double prom   = ViewBag.Promedio ?? 0.0;
    int totalCals = ViewBag.TotalCals ?? 0;

    // Imagen: propia o default por categoría
    var imgDefaults = new Dictionary<string, string> {
        { "Motor",             "/img/defaults/motor.png"       },
        { "Frenos",            "/img/defaults/frenos.png"      },
        { "Filtros",           "/img/defaults/filtros.png"     },
        { "Eléctrico",         "/img/defaults/electrico.png"   },
        { "Sistema Eléctrico", "/img/defaults/electrico.png"   },
        { "Suspensión",        "/img/defaults/suspension.png"  },
        { "Lubricantes",       "/img/defaults/lubricantes.png" },
    };
    var imgSrc = !string.IsNullOrEmpty(Model.ImagenUrl)
        ? Model.ImagenUrl
        : (imgDefaults.ContainsKey(Model.Categoria) ? imgDefaults[Model.Categoria] : "/img/defaults/repuesto.png");

    string estrellaStr(double v) => v >= 1 ? (v >= 1.5 ? (v >= 2 ? (v >= 2.5 ? (v >= 3 ? (v >= 3.5 ? (v >= 4 ? (v >= 4.5 ? "★★★★★" : "★★★★½") : "★★★★") : "★★★½") : "★★★") : "★★½") : "★★") : "★½") : "★";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Nombre — Optimus-Byte</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <style>
        :root {
            --azul:      #1e3a8a;
            --azul-mid:  #2563eb;
            --dorado:    #d97706;
            --fondo:     #f4f6fb;
            --borde:     rgba(30,58,138,.12);
            --texto:     #1a2332;
            --suave:     #64748b;
            --radio:     10px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--fondo); font-family: 'Barlow', sans-serif; color: var(--texto); }

        /* ── NAVBAR ── */
        .det-nav {
            position: fixed; top: 0; left: 0; width: 100%;
            height: 68px; background: #fff;
            border-bottom: 1px solid var(--borde);
            display: flex; align-items: center; gap: 16px;
            padding: 0 28px; z-index: 100;
            box-shadow: 0 1px 20px rgba(30,58,138,.07);
        }
        .det-nav a.back-btn {
            display: flex; align-items: center; gap: 6px;
            color: var(--azul-mid); font-size: .78rem;
            letter-spacing: .08em; text-transform: uppercase;
            font-weight: 600; text-decoration: none;
            border: 1px solid var(--azul-mid);
            padding: 6px 14px; border-radius: 4px;
            transition: .2s;
        }
        .det-nav a.back-btn:hover { background: var(--azul-mid); color: #fff; }
        .det-nav .brand {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1.2rem; font-weight: 700; color: var(--azul);
            letter-spacing: .05em; text-transform: uppercase;
        }

        /* ── CONTENIDO ── */
        .det-wrap {
            max-width: 1000px; margin: 0 auto;
            padding: 90px 24px 60px;
        }

        /* ── TARJETA PRINCIPAL ── */
        .det-card {
            background: #fff; border-radius: var(--radio);
            border: 1px solid var(--borde);
            box-shadow: 0 4px 24px rgba(30,58,138,.07);
            display: grid; grid-template-columns: 380px 1fr;
            overflow: hidden; margin-bottom: 32px;
        }
        @@media (max-width: 700px) {
            .det-card { grid-template-columns: 1fr; }
        }

        /* Imagen */
        .det-img-zone {
            background: linear-gradient(135deg, #e8edf5, #dde4f0);
            display: flex; align-items: center; justify-content: center;
            min-height: 320px; position: relative; overflow: hidden;
        }
        .det-img-zone img {
            max-width: 85%; max-height: 300px;
            object-fit: contain;
        }
        .det-badge {
            position: absolute; top: 12px; left: 12px;
            background: var(--azul-mid); color: #fff;
            font-size: .62rem; letter-spacing: .1em;
            text-transform: uppercase; font-weight: 700;
            padding: 4px 10px; border-radius: 3px;
        }
        .det-badge.agotado { background: #dc2626; }
        .det-badge.bajo    { background: #d97706; }

        /* Info */
        .det-info { padding: 32px 28px; display: flex; flex-direction: column; gap: 14px; }
        .det-cat-chip {
            display: inline-flex; align-items: center; gap: 6px;
            background: rgba(37,99,235,.07); border: 1px solid rgba(37,99,235,.18);
            color: var(--azul-mid); font-size: .68rem; font-weight: 600;
            letter-spacing: .1em; text-transform: uppercase;
            padding: 3px 10px; border-radius: 20px; width: fit-content;
        }
        .det-nombre {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 2rem; font-weight: 700; color: var(--azul);
            line-height: 1.15; text-transform: uppercase;
        }
        .det-referencia { font-size: .78rem; color: var(--suave); font-family: monospace; }

        /* Marca/Modelo chips */
        .det-mm { display: flex; gap: 8px; flex-wrap: wrap; margin: 4px 0; }
        .mm-chip {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 5px 12px; border-radius: 20px;
            font-size: .75rem; font-weight: 600;
        }
        .mm-chip.marca  { background: #eff6ff; border: 1px solid #bfdbfe; color: var(--azul); }
        .mm-chip.modelo { background: #fefce8; border: 1px solid #fde68a; color: #92400e; }

        .det-precio {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 2.4rem; font-weight: 700; color: var(--azul-mid);
        }
        .det-precio span { font-size: .9rem; color: var(--suave); margin-left: 4px; }

        .det-desc { font-size: .88rem; color: var(--suave); line-height: 1.6; }

        .det-stock-row {
            display: flex; align-items: center; gap: 8px;
            font-size: .82rem; font-weight: 500;
        }
        .dot-stock { width: 8px; height: 8px; border-radius: 50%; }
        .dot-ok   { background: #16a34a; }
        .dot-low  { background: #d97706; }
        .dot-out  { background: #dc2626; }

        .det-btn-cotizar {
            width: 100%; padding: 13px;
            background: var(--azul); color: #fff;
            border: none; border-radius: 6px;
            font-family: 'Barlow Condensed', sans-serif;
            font-size: .9rem; font-weight: 700;
            letter-spacing: .1em; text-transform: uppercase;
            cursor: pointer; transition: .2s; margin-top: 8px;
        }
        .det-btn-cotizar:hover { background: #1e3a8a; }
        .det-btn-cotizar:disabled { background: #94a3b8; cursor: not-allowed; }

        /* ── SECCIÓN CALIFICACIONES ── */
        .det-reviews {
            background: #fff; border-radius: var(--radio);
            border: 1px solid var(--borde);
            box-shadow: 0 2px 12px rgba(30,58,138,.05);
            padding: 28px 28px 24px;
        }
        .rev-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1.25rem; font-weight: 700;
            color: var(--azul); text-transform: uppercase;
            letter-spacing: .06em; margin-bottom: 20px;
            padding-bottom: 12px; border-bottom: 1px solid var(--borde);
        }
        .rev-summary {
            display: flex; align-items: center; gap: 24px;
            margin-bottom: 24px;
        }
        .rev-big-num {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 3.5rem; font-weight: 700; color: var(--dorado);
            line-height: 1;
        }
        .rev-stars { font-size: 1.5rem; color: var(--dorado); }
        .rev-count { font-size: .8rem; color: var(--suave); margin-top: 4px; }

        /* Formulario */
        .rev-form { margin-bottom: 28px; }
        .rev-form-title {
            font-size: .78rem; font-weight: 600; letter-spacing: .08em;
            text-transform: uppercase; color: var(--suave); margin-bottom: 10px;
        }
        .star-picker { display: flex; gap: 4px; margin-bottom: 12px; }
        .star-picker input[type=radio] { display: none; }
        .star-picker label {
            font-size: 1.8rem; cursor: pointer; color: #d1d5db;
            transition: color .15s, transform .15s;
        }
        .star-picker input:checked ~ label,
        .star-picker label:hover,
        .star-picker label:hover ~ label { color: var(--dorado); transform: scale(1.1); }
        /* Técnica RTL para selección de estrellas */
        .star-picker { flex-direction: row-reverse; justify-content: flex-end; }
        .star-picker label:hover, .star-picker label:hover ~ label,
        .star-picker input:checked ~ label { color: var(--dorado); }

        .rev-textarea {
            width: 100%; padding: 10px 14px;
            border: 1px solid rgba(30,58,138,.2); border-radius: 6px;
            font-family: 'Barlow', sans-serif; font-size: .85rem;
            resize: vertical; min-height: 80px; color: var(--texto);
            outline: none; transition: border-color .2s;
        }
        .rev-textarea:focus { border-color: var(--azul-mid); }
        .rev-submit {
            margin-top: 10px; padding: 9px 22px;
            background: var(--azul-mid); color: #fff;
            border: none; border-radius: 5px; cursor: pointer;
            font-family: 'Barlow Condensed', sans-serif;
            font-size: .82rem; font-weight: 700;
            letter-spacing: .08em; text-transform: uppercase;
            transition: .2s;
        }
        .rev-submit:hover { background: var(--azul); }

        /* Lista de reseñas */
        .rev-list { display: flex; flex-direction: column; gap: 16px; }
        .rev-item {
            padding: 14px 16px; border-radius: 8px;
            background: #f8fafc; border: 1px solid var(--borde);
        }
        .rev-item-header {
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 6px;
        }
        .rev-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--azul); color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: .85rem; font-weight: 700; flex-shrink: 0;
        }
        .rev-user  { font-weight: 600; font-size: .85rem; }
        .rev-date  { font-size: .72rem; color: var(--suave); margin-left: auto; }
        .rev-stars-small { color: var(--dorado); font-size: .9rem; margin-bottom: 4px; }
        .rev-comment { font-size: .82rem; color: var(--suave); line-height: 1.55; }
        .rev-empty { text-align: center; padding: 24px; color: var(--suave); font-size: .85rem; }

        .alerta-ok {
            padding: 10px 16px; background: #f0fdf4;
            border: 1px solid #86efac; border-radius: 6px;
            color: #166534; font-size: .82rem; margin-bottom: 16px;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <!-- ══ NAVBAR (igual al Home) ══ -->
    <nav class="ob-navbar">
        <button class="ob-hamburger" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>
        <a class="ob-nav-logo" asp-controller="Home" asp-action="Index">
            <img src="~/img/putin.png" alt="Optimus-Byte" />
        </a>
        <a href="/Inventario/Index" style="margin-left:12px;font-size:.75rem;color:var(--dorado,#d97706);
           letter-spacing:.08em;text-transform:uppercase;font-weight:600;text-decoration:none;
           border:1px solid var(--dorado,#d97706);padding:6px 14px;border-radius:4px;">
            ← Catálogo
        </a>
        <div class="ob-nav-acciones">
            @if (!logueado)
            {
                <a class="ob-btn-ingresar" asp-controller="Login" asp-action="Index">Ingresar</a>
                <a class="ob-btn-registro" asp-controller="Registro" asp-action="Index">Registrarse</a>
            }
            else
            {
                @await Html.PartialAsync("_MenuUsuarioPartial")
            }
        </div>
    </nav>
    <aside class="ob-sidebar" id="obSidebar">
        <div class="ob-sidebar-title">Optimus-Byte</div>
        <a asp-controller="Home" asp-action="Index"><i class="fas fa-house"></i> Inicio</a>
        <a asp-controller="Inventario" asp-action="Index" class="activo-sidebar"><i class="fas fa-boxes-stacked"></i> Catálogo</a>
        <a asp-controller="Servicios" asp-action="Index"><i class="fas fa-screwdriver-wrench"></i> Servicios</a>
        <a asp-controller="Citas" asp-action="Index"><i class="fas fa-calendar-check"></i> Citas</a>
        <a asp-controller="Home" asp-action="Sobre"><i class="fas fa-circle-info"></i> Acerca de</a>
    </aside>
    <div class="ob-overlay" id="obOverlay" onclick="closeSidebar()"></div>

    <div class="det-wrap">

        @if (TempData["CalOk"] != null)
        {
            <div class="alerta-ok">⭐ @TempData["CalOk"]</div>
        }

        <!-- TARJETA PRINCIPAL -->
        <div class="det-card">

            <!-- Imagen -->
            <div class="det-img-zone">
                @{
                    string badgeClass = Model.StockActual == 0 ? "agotado" : (Model.StockActual <= Model.StockMinimo ? "bajo" : "");
                    string badgeTxt   = Model.StockActual == 0 ? "Agotado" : (Model.StockActual <= Model.StockMinimo ? "Stock bajo" : "Disponible");
                }
                <span class="det-badge @badgeClass">@badgeTxt</span>
                <img src="@imgSrc" alt="@Model.Nombre"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
                <span style="display:none;font-size:4rem;">🔩</span>
            </div>

            <!-- Info -->
            <div class="det-info">
                <span class="det-cat-chip">⚙ @Model.Categoria</span>

                <h1 class="det-nombre">@Model.Nombre</h1>
                <div class="det-referencia">Ref: @Model.Referencia</div>

                @if (!string.IsNullOrEmpty(Model.Marca) || !string.IsNullOrEmpty(Model.Modelo))
                {
                    <div class="det-mm">
                        @if (!string.IsNullOrEmpty(Model.Marca))
                        {
                            <span class="mm-chip marca">🏷 @Model.Marca</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Modelo))
                        {
                            <span class="mm-chip modelo">🚗 @Model.Modelo</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Descripcion))
                {
                    <p class="det-desc">@Model.Descripcion</p>
                }

                <div class="det-precio">
                    @Model.PrecioUnitario.ToString("N0")
                    <span>COP</span>
                </div>

                <div class="det-stock-row">
                    <span class="dot-stock @(Model.StockActual == 0 ? "dot-out" : Model.StockActual <= Model.StockMinimo ? "dot-low" : "dot-ok")"></span>
                    @if (Model.StockActual == 0)
                    { <span>Sin stock disponible</span> }
                    else
                    { <span>@Model.StockActual unidades disponibles</span> }
                </div>

                @* Calificación promedio inline *@
                @if (totalCals > 0)
                {
                    <div style="font-size:.82rem;color:var(--suave)">
                        <span style="color:var(--dorado);font-size:1rem;">@("★".PadRight((int)Math.Round(prom), '★').PadRight(5,'☆'))</span>
                        @prom.ToString("F1") / 5 &nbsp;·&nbsp; @totalCals reseña@(totalCals != 1 ? "s" : "")
                    </div>
                }

                <button class="det-btn-cotizar"
                        @(Model.StockActual == 0 ? "disabled" : "")
                        onclick="alert('Repuesto agregado a cotización')">
                    @(Model.StockActual == 0 ? "Sin stock" : "+ Agregar a cotización")
                </button>
            </div>
        </div>

        <!-- SECCIÓN CALIFICACIONES -->
        <div class="det-reviews">
            <div class="rev-title">⭐ Calificaciones y reseñas</div>

            @if (totalCals > 0)
            {
                <div class="rev-summary">
                    <div>
                        <div class="rev-big-num">@prom.ToString("F1")</div>
                        <div class="rev-stars">@(new string('★', (int)Math.Round(prom)))@(new string('☆', 5 - (int)Math.Round(prom)))</div>
                        <div class="rev-count">@totalCals reseña@(totalCals != 1 ? "s" : "")</div>
                    </div>
                </div>
            }

            @* Formulario (solo usuarios logueados) *@
            @if (logueado)
            {
                <div class="rev-form">
                    <div class="rev-form-title">Deja tu calificación</div>
                    <form asp-controller="Inventario" asp-action="Calificar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idRepuesto" value="@Model.IdRepuesto" />

                        <div class="star-picker" id="starPicker">
                            @for (int s = 5; s >= 1; s--)
                            {
                                <input type="radio" name="estrellas" id="s@(s)" value="@s"
                                       @(s == 5 ? "checked" : "") />
                                <label for="s@(s)" title="@s estrella@(s!=1?"s":"")">★</label>
                            }
                        </div>

                        <textarea class="rev-textarea" name="comentario" rows="3"
                                  placeholder="Cuéntanos tu experiencia con este repuesto (opcional)..."></textarea>
                        <button type="submit" class="rev-submit">Publicar calificación</button>
                    </form>
                </div>
            }
            else
            {
                <p style="font-size:.82rem;color:var(--suave);margin-bottom:20px;">
                    <a href="/Login/Index" style="color:var(--azul-mid);font-weight:600;">Inicia sesión</a>
                    para dejar una calificación.
                </p>
            }

            <!-- Lista reseñas -->
            <div class="rev-list">
                @if (!cals.Any())
                {
                    <div class="rev-empty">
                        Aún no hay reseñas para este repuesto. ¡Sé el primero!
                    </div>
                }
                else
                {
                    @foreach (var c in cals)
                    {
                        <div class="rev-item">
                            <div class="rev-item-header">
                                <div class="rev-avatar">
                                    @(c.NombreUsuario.Length > 0 ? c.NombreUsuario[0].ToString().ToUpper() : "?")
                                </div>
                                <span class="rev-user">@c.NombreUsuario</span>
                                <span class="rev-date">@c.Fecha.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="rev-stars-small">
                                @(new string('★', c.Estrellas))@(new string('☆', 5 - c.Estrellas))
                            </div>
                            @if (!string.IsNullOrEmpty(c.Comentario))
                            {
                                <div class="rev-comment">@c.Comentario</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

    </div>
    <script>
        function toggleSidebar() {
            document.getElementById('obSidebar').classList.toggle('activa');
            document.getElementById('obOverlay').classList.toggle('activa');
        }
        function closeSidebar() {
            document.getElementById('obSidebar').classList.remove('activa');
            document.getElementById('obOverlay').classList.remove('activa');
        }
        function toggleMenu(btn) {
            const menu = document.getElementById('menuUsuario');
            menu.classList.toggle('abierto');
            document.addEventListener('click', function cerrar(e) {
                if (!btn.contains(e.target) && !menu.contains(e.target)) {
                    menu.classList.remove('abierto');
                    document.removeEventListener('click', cerrar);
                }
            });
        }
    </script>
</body>
</html>
