@{
    Layout = null;
    ViewData["Title"] = "Catálogo de Repuestos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Optimus-Byte</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalogo.css" asp-append-version="true" />
    <style>
        /* Correcciones garantizadas — sobreescriben cualquier conflicto */
        .logo-img {
            height: 48px !important;
            width: auto !important;
            max-width: 200px !important;
            display: block !important;
        }

        .barra-superior {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 80px !important;
            background-color: #ffffff !important;
            border-bottom: 1px solid rgba(37,99,235,0.15) !important;
            display: flex !important;
            align-items: center !important;
            gap: 20px !important;
            padding: 0 32px !important;
            z-index: 1200 !important;
            box-shadow: 0 1px 40px rgba(37,99,235,0.08) !important;
        }

        .boton-menu {
            background: transparent !important;
            color: #2563eb !important;
            border: 1px solid rgba(37,99,235,0.15) !important;
            width: 44px !important;
            height: 44px !important;
            font-size: 18px !important;
            border-radius: 4px !important;
            cursor: pointer !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .nav-acciones {
            margin-left: auto !important;
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
        }

        .boton-ingresar,
        .boton-registro {
            text-decoration: none !important;
            padding: 10px 26px !important;
            border-radius: 4px !important;
            font-family: 'Jost', sans-serif !important;
            font-size: 0.82rem !important;
            letter-spacing: 0.12em !important;
            text-transform: uppercase !important;
            transition: all 0.3s ease !important;
        }

        .boton-ingresar {
            background: transparent !important;
            color: #2563eb !important;
            border: 1px solid #2563eb !important;
        }

        .boton-ingresar:hover {
            background: #2563eb !important;
            color: #fff !important;
        }

        .boton-registro {
            background: #2563eb !important;
            color: #fff !important;
            border: 1px solid #2563eb !important;
        }

        .boton-registro:hover {
            background: #3b82f6 !important;
            color: #fff !important;
        }

        .nb-cotizacion {
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            border: 1px solid #2563eb !important;
            color: #2563eb !important;
            padding: 7px 16px !important;
            border-radius: 4px !important;
            font-size: .75rem !important;
            letter-spacing: .1em !important;
            text-transform: uppercase !important;
            cursor: pointer !important;
            background: transparent !important;
        }

        .barra-lateral {
            position: fixed !important;
            top: 80px !important;
            left: -280px !important;
            width: 280px !important;
            height: calc(100vh - 80px) !important;
            background: #ffffff !important;
            border-right: 1px solid rgba(37,99,235,0.15) !important;
            padding: 36px 0 !important;
            transition: left 0.3s ease !important;
            z-index: 1000 !important;
            overflow-y: auto !important;
        }

        .barra-lateral.activa {
            left: 0 !important;
            box-shadow: 4px 0 40px rgba(37,99,235,0.1) !important;
        }

        .barra-lateral h2 {
            color: #2563eb !important;
            font-size: 1.1rem !important;
            letter-spacing: 0.08em !important;
            text-transform: uppercase !important;
            padding: 0 28px 24px !important;
            margin: 0 !important;
            border-bottom: 1px solid rgba(37,99,235,0.15) !important;
            margin-bottom: 12px !important;
        }

        .barra-lateral a {
            display: flex !important;
            align-items: center !important;
            color: #64748b !important;
            text-decoration: none !important;
            padding: 13px 28px !important;
            font-size: 0.82rem !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            transition: all 0.3s ease !important;
            border-left: 2px solid transparent !important;
        }

        .barra-lateral a:hover,
        .barra-lateral a.activo-sidebar {
            color: #2563eb !important;
            background: rgba(37,99,235,0.08) !important;
            border-left-color: #2563eb !important;
        }

        .cat-layout {
            padding-top: 80px !important;
        }

        body { margin: 0 !important; padding: 0 !important; }
    </style>
</head>

<body>

    <!-- ══ NAVBAR ══════════════════════════════════════════ -->
    <header class="barra-superior">
        <button class="boton-menu" onclick="mostrarMenu()">☰</button>

        <a class="logo-proyecto" asp-controller="Home" asp-action="Index">
            <img src="~/img/putin.png" alt="Optimus-Byte" class="logo-img" />
        </a>

        <button class="nb-cotizacion" id="toggleCarrito">
            🛒 Mi cotización
            <span class="carrito-badge" id="badgeCount">0</span>
        </button>

        <div class="nav-acciones">
            <a class="boton-ingresar" asp-controller="Login" asp-action="Index">Ingresar</a>
            <a class="boton-registro" asp-controller="Registro" asp-action="Index">Registrar</a>
        </div>
    </header>

    <!-- ══ BARRA LATERAL ═══════════════════════════════════ -->
    <aside class="barra-lateral" id="barraLateral">
        <h2>Optimus-Byte</h2>
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <a asp-controller="Inventario" asp-action="Index" class="activo-sidebar">Catálogo</a>
        <a asp-controller="Servicios" asp-action="Index">Servicios</a>
        <a asp-controller="Citas" asp-action="Index">Citas</a>
        <a asp-controller="Home" asp-action="Sobre">Acerca de</a>
    </aside>

    <!-- ══ LAYOUT: SIDEBAR CATEGORÍAS + MAIN ══════════════ -->
    <div class="cat-layout" id="contenidoPrincipal">

        <aside class="cat-sb">
            <div class="cat-sb-header">
                <div class="cat-sb-header-txt">Cotizador de Repuestos</div>
                <button class="cat-sb-carrito-btn" onclick="toggleCarrito()">
                    🛒 Productos agregados
                    <span id="sbCount" style="background:rgba(0,0,0,0.25);border-radius:10px;padding:1px 7px;font-size:.65rem;">0</span>
                </button>
            </div>
            <div class="cat-sb-cat-title">Categorías</div>
            <div class="cat-sb-cat on" onclick="filtrar('todos', this)">Todos los productos <span class="arr">→</span></div>
            <div class="cat-sb-cat" onclick="filtrar('Motor', this)">Motor <span class="arr">→</span></div>
            <div class="cat-sb-cat" onclick="filtrar('Frenos', this)">Frenos <span class="arr">→</span></div>
            <div class="cat-sb-cat" onclick="filtrar('Filtros', this)">Filtros <span class="arr">→</span></div>
            <div class="cat-sb-cat" onclick="filtrar('Eléctrico', this)">Eléctrico <span class="arr">→</span></div>
            <div class="cat-sb-cat" onclick="filtrar('Suspensión', this)">Suspensión <span class="arr">→</span></div>
            <div class="cat-sb-cat" onclick="filtrar('Lubricantes', this)">Lubricantes <span class="arr">→</span></div>
        </aside>

        <main class="cat-main">
            <div class="cat-main-top">
                <div class="cat-main-title">Todos los <em>productos</em></div>
                <div class="cat-search-row">
                    <input class="cat-search-inp" placeholder="Buscar repuesto..." id="searchInp" oninput="buscar()" />
                    <button class="cat-search-btn">🔍</button>
                    <select class="cat-sort-sel" onchange="ordenar(this.value)">
                        <option value="nombre">Nombre A–Z</option>
                        <option value="precio-asc">Precio ↑</option>
                        <option value="precio-desc">Precio ↓</option>
                    </select>
                </div>
            </div>

            <div class="cat-carrito-panel" id="carritoPanel" style="display:none;">
                <div class="cat-carrito-panel-hdr">
                    <span>Mi cotización</span>
                    <span style="cursor:pointer;" onclick="toggleCarrito()">✕ cerrar</span>
                </div>
                <div id="carritoItems"></div>
                <div class="cat-carrito-total">
                    <span class="cat-carrito-total-lbl">Total estimado</span>
                    <span class="cat-carrito-total-val" id="totalVal">$0</span>
                </div>
                <button class="cat-btn-cotizar">Enviar cotización →</button>
            </div>

            <div class="cat-grid" id="productosGrid"></div>
        </main>
    </div>

    <script src="~/js/catalogo.js" asp-append-version="true"></script>
    <script>
        function mostrarMenu() {
            document.getElementById('barraLateral').classList.toggle('activa');
        }
    </script>

</body>
</html>
