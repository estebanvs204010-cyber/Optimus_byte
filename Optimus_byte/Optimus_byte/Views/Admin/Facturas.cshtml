@model List<Optimus_byte.Models.ViewModels.FacturaViewModel>
@{
    ViewData["Title"] = "Facturas";
    Layout = null;
    string[] metodosPago = { "Efectivo","Transferencia","Tarjeta debito","Tarjeta credito","PSE","Nequi" };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Facturas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        .badge-pago { display:inline-block;padding:3px 9px;border-radius:2px;font-size:.68rem;letter-spacing:.06em; }
        .pago-Pendiente { background:rgba(234,179,8,.1);border:1px solid rgba(234,179,8,.3);color:#a16207; }
        .pago-Pagado    { background:rgba(22,163,74,.08);border:1px solid rgba(22,163,74,.2);color:#15803d; }
        .pago-Anulado   { background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.2);color:#b91c1c; }
        .total-pagado { font-size:1.5rem;font-weight:700;color:#15803d; }
        .total-pendiente { font-size:1.5rem;font-weight:700;color:#a16207; }
    </style>
</head>
<body>

    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios"         class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes"    class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Admin/Facturas"   class="nav-link active"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Admin/Dashboard"  class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
        </nav>
    </div>

    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Facturas</h1>
                <p class="section-sub">@Model.Count factura(s) · Total cobrado $@Model.Where(f => f.EstadoPago == "Pagado").Sum(f => f.Total).ToString("N0")</p>
            </div>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err"><i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]</div>
        }

        <!-- Resumen rápido -->
        <div class="stats-row" style="margin-bottom:20px">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(234,179,8,.08)">
                    <i class="bi bi-hourglass-split" style="color:#a16207"></i>
                </div>
                <div>
                    <div class="stat-num total-pendiente" style="font-size:1.4rem">$@Model.Where(f => f.EstadoPago == "Pendiente").Sum(f => f.Total).ToString("N0")</div>
                    <div class="stat-label">Por cobrar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(22,163,74,.08)">
                    <i class="bi bi-cash-coin" style="color:#15803d"></i>
                </div>
                <div>
                    <div class="stat-num total-pagado" style="font-size:1.4rem">$@Model.Where(f => f.EstadoPago == "Pagado").Sum(f => f.Total).ToString("N0")</div>
                    <div class="stat-label">Cobrado</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(37,99,235,.08)">
                    <i class="bi bi-receipt-cutoff" style="color:var(--dorado)"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(f => f.EstadoPago == "Pendiente")</div>
                    <div class="stat-label">Facturas pendientes</div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <form method="get" action="/Admin/Facturas" class="filtro-bar mb-3">
            <div class="input-buscar">
                <i class="bi bi-search"></i>
                <input type="text" name="buscar" value="@ViewBag.BuscarFiltro" placeholder="Buscar por cliente, placa o N° factura..." />
            </div>
            <select name="estado" class="filtro-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="Pendiente" selected="@(ViewBag.EstadoFiltro == "Pendiente" ? "selected" : null)">Pendiente</option>
                <option value="Pagado"    selected="@(ViewBag.EstadoFiltro == "Pagado"    ? "selected" : null)">Pagado</option>
                <option value="Anulado"   selected="@(ViewBag.EstadoFiltro == "Anulado"   ? "selected" : null)">Anulado</option>
            </select>
            <button type="submit" class="btn-nuevo" style="white-space:nowrap">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.EstadoFiltro) || !string.IsNullOrEmpty(ViewBag.BuscarFiltro))
            {
                <a href="/Admin/Facturas" class="btn-cancelar">Limpiar</a>
            }
        </form>

        <!-- Tabla -->
        <div class="tabla-wrapper">
            <table class="tabla-usuarios">
                <thead>
                    <tr>
                        <th>N° Factura</th>
                        <th>Orden</th>
                        <th>Cliente</th>
                        <th>Placa</th>
                        <th>Subtotal</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Emisión</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td style="font-weight:600;color:var(--dorado)">#@f.IdFactura</td>
                            <td><a href="/Admin/OrdenDetalle/@f.IdOrden" style="color:var(--dorado)">#@f.IdOrden</a></td>
                            <td>@f.Cliente</td>
                            <td><strong>@f.Placa</strong> <span style="font-size:.75rem;color:var(--texto-suave)">@f.MarcaModelo</span></td>
                            <td>$@f.Subtotal.ToString("N0")</td>
                            <td>$@f.Iva.ToString("N0")</td>
                            <td style="font-weight:600">$@f.Total.ToString("N0")</td>
                            <td><span class="badge-pago pago-@f.EstadoPago">@f.EstadoPago</span></td>
                            <td style="font-size:.78rem;color:var(--texto-suave)">@f.FechaEmision.ToString("dd/MM/yyyy")</td>
                            <td class="td-acciones">
                                @if (f.EstadoPago == "Pendiente")
                                {
                                    <!-- Registrar pago -->
                                    <button class="btn-accion btn-reactivar" title="Registrar pago"
                                            data-bs-toggle="modal" data-bs-target="#modalPago"
                                            onclick="setFacturaPago(@f.IdFactura, @f.Total)">
                                        <i class="bi bi-cash-coin"></i>
                                    </button>
                                    <!-- Anular -->
                                    <button class="btn-accion btn-desactivar" title="Anular factura"
                                            data-bs-toggle="modal" data-bs-target="#modalAnular"
                                            onclick="setFacturaAnular(@f.IdFactura)">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                                @if (f.EstadoPago == "Pagado")
                                {
                                    <span style="font-size:.72rem;color:#15803d">
                                        <i class="bi bi-check2-circle me-1"></i>@(f.MetodoPago)<br/>
                                        <span style="color:var(--texto-suave)">@f.FechaPago?.ToString("dd/MM/yy")</span>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="tabla-vacia">
                    <i class="bi bi-receipt" style="font-size:3rem;color:#334155"></i>
                    <p class="mt-2">No se encontraron facturas.</p>
                    <p style="font-size:.8rem;color:var(--texto-suave)">Las facturas se generan desde el detalle de cada orden.</p>
                </div>
            }
        </div>
    </div>

    <!-- Modal Registrar Pago -->
    <div class="modal fade" id="modalPago" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:#fff;border:1px solid var(--borde-input);border-radius:6px">
                <div class="modal-header" style="border-bottom:1px solid var(--borde-input)">
                    <h5 class="modal-title" style="font-size:.9rem;letter-spacing:.06em;color:var(--dorado)">
                        <i class="bi bi-cash-coin me-2"></i>Registrar pago — Factura <span id="numFacturaPago"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Admin" asp-action="RegistrarPago" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idFactura" id="inputIdFactura" />
                    <div class="modal-body" style="padding:24px">
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Monto *</label>
                            <input type="number" name="monto" id="inputMontoPago" class="input-custom" style="padding-left:14px" step="0.01" min="0" required />
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Método de pago *</label>
                            <select name="metodo" class="input-custom select-custom" style="padding-left:14px" required>
                                @foreach (var m in metodosPago)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Referencia de transacción</label>
                            <input type="text" name="referencia" class="input-custom" style="padding-left:14px" placeholder="Opcional" />
                        </div>
                        <div class="form-group-custom">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Observaciones</label>
                            <input type="text" name="observaciones" class="input-custom" style="padding-left:14px" placeholder="Opcional" />
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--borde-input);padding:14px 24px;gap:10px">
                        <button type="submit" class="btn-guardar"><i class="bi bi-check-circle-fill me-2"></i>Confirmar pago</button>
                        <button type="button" class="btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Anular Factura -->
    <div class="modal fade" id="modalAnular" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:#fff;border:1px solid var(--borde-input);border-radius:6px">
                <div class="modal-header" style="border-bottom:1px solid var(--borde-input)">
                    <h5 class="modal-title" style="font-size:.9rem;letter-spacing:.06em;color:#dc2626">
                        <i class="bi bi-x-circle-fill me-2"></i>Anular Factura <span id="numFacturaAnular"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Admin" asp-action="AnularFactura" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idFactura" id="inputIdAnular" />
                    <div class="modal-body" style="padding:24px">
                        <div class="form-group-custom">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Motivo de anulación *</label>
                            <textarea name="motivo" class="input-custom" style="padding:10px 14px;height:80px;resize:none" required placeholder="Explica el motivo de la anulación..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--borde-input);padding:14px 24px;gap:10px">
                        <button type="submit" class="btn-guardar" style="background:transparent;color:#dc2626;border-color:#dc2626">
                            <i class="bi bi-x-circle-fill me-2"></i>Anular factura
                        </button>
                        <button type="button" class="btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setFacturaPago(id, total) {
            document.getElementById('inputIdFactura').value = id;
            document.getElementById('inputMontoPago').value = total;
            document.getElementById('numFacturaPago').textContent = '#' + id;
        }
        function setFacturaAnular(id) {
            document.getElementById('inputIdAnular').value = id;
            document.getElementById('numFacturaAnular').textContent = '#' + id;
        }
    </script>
</body>
</html>
