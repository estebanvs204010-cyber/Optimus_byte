@model List<Optimus_byte.Models.ViewModels.FacturaViewModel>
@{
    ViewData["Title"] = "Facturas";
    Layout = null;
    string[] metodosPago = { "Efectivo", "Transferencia", "Tarjeta debito", "Tarjeta credito", "PSE", "Nequi" };
    var solicitudes = ViewBag.SolicitudesPendientes as List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>();
    var stockBajo = ViewBag.RepuestosBajoStockList as List<Optimus_byte.Models.ViewModels.RepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.RepuestoViewModel>();
    int totalSolicitudes = solicitudes.Count;
    int totalStockBajo = stockBajo.Count;
    int totalNotif = totalSolicitudes + totalStockBajo;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Facturas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        .badge-pago {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 2px;
            font-size: .68rem;
            letter-spacing: .06em;
        }

        .pago-Pendiente {
            background: rgba(234,179,8,.1);
            border: 1px solid rgba(234,179,8,.3);
            color: #a16207;
        }

        .pago-Pagado {
            background: rgba(22,163,74,.08);
            border: 1px solid rgba(22,163,74,.2);
            color: #15803d;
        }

        .pago-Anulado {
            background: rgba(220,38,38,.08);
            border: 1px solid rgba(220,38,38,.2);
            color: #b91c1c;
        }

        .total-pagado {
            font-size: 1.5rem;
            font-weight: 700;
            color: #15803d;
        }

        .total-pendiente {
            font-size: 1.5rem;
            font-weight: 700;
            color: #a16207;
        }

        /* ── Campanita ── */
        .bell-btn {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 6px;
            color: var(--texto-suave);
            font-size: 1.25rem;
            transition: color .2s;
        }

            .bell-btn:hover {
                color: var(--dorado);
            }

        .bell-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            background: #ef4444;
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
            line-height: 1;
        }
        /* ── Panel notificaciones ── */
        .notif-panel {
            display: none;
            position: fixed;
            top: 54px;
            right: 18px;
            width: 370px;
            max-height: 500px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            box-shadow: 0 8px 30px rgba(0,0,0,.12);
            z-index: 9999;
        }

            .notif-panel.open {
                display: block;
            }

        .notif-header {
            padding: 12px 16px;
            border-bottom: 1px solid var(--borde-input);
            font-size: .75rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notif-section-title {
            padding: 8px 16px 4px;
            font-size: .65rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            background: var(--grafito-med);
            border-bottom: 1px solid var(--borde-input);
        }

        .notif-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(0,0,0,.04);
            font-size: .82rem;
        }

            .notif-item:last-child {
                border-bottom: none;
            }

        .notif-titulo {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 2px;
        }

        .notif-sub {
            color: #64748b;
            font-size: .76rem;
        }

        .notif-hora {
            color: #94a3b8;
            font-size: .7rem;
            margin-top: 4px;
        }

        .notif-empty {
            padding: 24px 16px;
            text-align: center;
            color: #94a3b8;
            font-size: .82rem;
        }

        .stock-alerta-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(220,38,38,.08);
            border: 1px solid rgba(220,38,38,.25);
            color: #b91c1c;
            border-radius: 4px;
            font-size: .7rem;
            font-weight: 600;
            padding: 3px 9px;
        }
    </style>
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

</head>
<body>

    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">

            @* ── CAMPANITA ── *@
            <button class="bell-btn" id="btnCampana" title="Notificaciones" onclick="toggleNotif()">
                <i class="bi bi-bell-fill"></i>
                @if (totalNotif > 0)
                {
                    <span class="bell-badge" id="bellBadge">@totalNotif</span>
                }
            </button>

            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    @* ── Panel de notificaciones ── *@
    <div class="notif-panel" id="notifPanel">
        <div class="notif-header">
            <span><i class="bi bi-bell me-1"></i>Notificaciones</span>
            @if (totalNotif > 0)
            {
                <span style="background:#ef4444;color:#fff;font-size:.65rem;padding:2px 7px;border-radius:10px">
                    @totalNotif pendiente(s)
                </span>
            }
        </div>

        @* — Solicitudes de repuesto — *@
        @if (solicitudes.Any())
        {
            <div class="notif-section-title"><i class="bi bi-box-seam me-1"></i>Solicitudes de repuesto (@totalSolicitudes)</div>
            @foreach (var s in solicitudes)
            {
                bool esLibre = s.NombreRepuesto?.StartsWith("[Sin inventario]") ?? false;
                string nombreMostrar = esLibre ? s.NombreRepuesto!.Replace("[Sin inventario]", "").Trim() : (s.NombreRepuesto ?? "—");
                <div class="notif-item">
                    <div class="notif-titulo">
                        <i class="bi bi-box-seam me-1" style="color:#f97316"></i>
                        @if (esLibre)
                        {
                            <span style="font-size:.63rem;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:1px 6px;margin-right:4px">Sin inventario</span>
                        }
                        @nombreMostrar <span style="color:#94a3b8;font-weight:400"> × @s.Cantidad</span>
                    </div>
                    <div class="notif-sub">OT-@s.IdOrden &nbsp;·&nbsp; @s.MecanicoNombre</div>
                    @if (!string.IsNullOrWhiteSpace(s.Motivo))
                    {
                        <div class="notif-sub" style="margin-top:2px;font-style:italic"><i class="bi bi-chat-left-text me-1"></i>@s.Motivo</div>
                    }
                    <div class="notif-hora">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
                        @if (esLibre)
                        {
                            <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-plus-circle"></i> Crear en inventario
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Admin" asp-action="AceptarSolicitudRepuesto" method="post" style="display:inline" onsubmit="return confirm('¿Aceptar y descontar stock de este repuesto?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                                <input type="hidden" name="ordenId" value="@s.IdOrden" />
                                <input type="hidden" name="repuestoNombre" value="@nombreMostrar" />
                                <input type="hidden" name="cantidad" value="@s.Cantidad" />
                                <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#22c55e;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                    <i class="bi bi-check2"></i> Aceptar
                                </button>
                            </form>
                        }
                        <form asp-controller="Admin" asp-action="RechazarSolicitudRepuesto" method="post" style="display:inline" onsubmit="return confirm('¿Rechazar esta solicitud?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                            <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#ef4444;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-x-lg"></i> Rechazar
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

        @* — Stock bajo (persistente) — *@
        @if (stockBajo.Any())
        {
            <div class="notif-section-title"><i class="bi bi-exclamation-triangle-fill me-1" style="color:#dc2626"></i>Stock bajo (@totalStockBajo repuesto(s))</div>
            @foreach (var r in stockBajo)
            {
                <div class="notif-item">
                    <div class="notif-titulo">
                        <span class="stock-alerta-chip"><i class="bi bi-exclamation-triangle-fill"></i>STOCK BAJO</span>
                        <span style="margin-left:6px">@r.Nombre</span>
                    </div>
                    <div class="notif-sub" style="margin-top:4px">
                        Actual: <strong style="color:#dc2626">@r.StockActual</strong> &nbsp;·&nbsp; Mínimo: @r.StockMinimo
                        &nbsp;·&nbsp; Ref: <span style="font-family:monospace">@r.Referencia</span>
                    </div>
                    <div style="margin-top:6px">
                        <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                            <i class="bi bi-arrow-up-circle"></i> Actualizar stock
                        </a>
                    </div>
                </div>
            }
        }

        @if (totalNotif == 0)
        {
            <div class="notif-empty">
                <i class="bi bi-check-circle" style="font-size:1.8rem;display:block;margin-bottom:8px;color:#22c55e"></i>
                Sin notificaciones pendientes
            </div>
        }

        @if (solicitudes.Any())
        {
            <div style="padding:10px 16px;text-align:right">
                <a href="/Admin/SolicitudesRepuesto" style="font-size:.76rem;color:var(--dorado);text-decoration:none">
                    Ver todas las solicitudes <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes" class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Admin/Facturas" class="nav-link active"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Admin/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            <a href="/VehiculosAdmin/Index" class="nav-link"><i class="bi bi-car-front-fill"></i><span>Vehículos</span></a>
            <a href="/Admin/SolicitudesRepuesto" class="nav-link" style="position:relative">
                <i class="bi bi-bell-fill"></i>
                <span>Solicitudes</span>
                @if (totalSolicitudes > 0)
                {
                    <span style="position:absolute;top:6px;right:10px;background:#ef4444;color:#fff;font-size:.55rem;font-weight:700;min-width:15px;height:15px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px">@totalSolicitudes</span>
                }
            </a>
        </nav>
    </div>

    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Facturas</h1>
                <p class="section-sub">@Model.Count factura(s) · Total cobrado $@Model.Where(f => f.EstadoPago == "Pagado").Sum(f => f.Total).ToString("N0")</p>
            </div>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err"><i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]</div>
        }

        <!-- Resumen rápido -->
        <div class="stats-row" style="margin-bottom:20px">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(234,179,8,.08)">
                    <i class="bi bi-hourglass-split" style="color:#a16207"></i>
                </div>
                <div>
                    <div class="stat-num total-pendiente" style="font-size:1.4rem">$@Model.Where(f => f.EstadoPago == "Pendiente").Sum(f => f.Total).ToString("N0")</div>
                    <div class="stat-label">Por cobrar</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(22,163,74,.08)">
                    <i class="bi bi-cash-coin" style="color:#15803d"></i>
                </div>
                <div>
                    <div class="stat-num total-pagado" style="font-size:1.4rem">$@Model.Where(f => f.EstadoPago == "Pagado").Sum(f => f.Total).ToString("N0")</div>
                    <div class="stat-label">Cobrado</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(37,99,235,.08)">
                    <i class="bi bi-receipt-cutoff" style="color:var(--dorado)"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.Count(f => f.EstadoPago == "Pendiente")</div>
                    <div class="stat-label">Facturas pendientes</div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <form method="get" action="/Admin/Facturas" class="filtro-bar mb-3">
            <div class="input-buscar">
                <i class="bi bi-search"></i>
                <input type="text" name="buscar" value="@ViewBag.BuscarFiltro" placeholder="Buscar por cliente, placa o N° factura..." />
            </div>
            <select name="estado" class="filtro-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="Pendiente" selected="@(ViewBag.EstadoFiltro == "Pendiente" ? "selected" : null)">Pendiente</option>
                <option value="Pagado" selected="@(ViewBag.EstadoFiltro == "Pagado" ? "selected" : null)">Pagado</option>
                <option value="Anulado" selected="@(ViewBag.EstadoFiltro == "Anulado" ? "selected" : null)">Anulado</option>
            </select>
            <button type="submit" class="btn-nuevo" style="white-space:nowrap">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.EstadoFiltro) || !string.IsNullOrEmpty(ViewBag.BuscarFiltro))
            {
                <a href="/Admin/Facturas" class="btn-cancelar">Limpiar</a>
            }
        </form>

        <!-- Tabla -->
        <div class="tabla-wrapper">
            <table class="tabla-usuarios">
                <thead>
                    <tr>
                        <th>N° Factura</th>
                        <th>Orden</th>
                        <th>Cliente</th>
                        <th>Placa</th>
                        <th>Subtotal</th>
                        <th>IVA</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Emisión</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td style="font-weight:600;color:var(--dorado)">#@f.IdFactura</td>
                            <td><a href="/Admin/OrdenDetalle/@f.IdOrden" style="color:var(--dorado)">#@f.IdOrden</a></td>
                            <td>@f.Cliente</td>
                            <td><strong>@f.Placa</strong> <span style="font-size:.75rem;color:var(--texto-suave)">@f.MarcaModelo</span></td>
                            <td>$@f.Subtotal.ToString("N0")</td>
                            <td>$@f.Iva.ToString("N0")</td>
                            <td style="font-weight:600">$@f.Total.ToString("N0")</td>
                            <td><span class="badge-pago pago-@f.EstadoPago">@f.EstadoPago</span></td>
                            <td style="font-size:.78rem;color:var(--texto-suave)">@f.FechaEmision.ToString("dd/MM/yyyy")</td>
                            <td class="td-acciones">
                                @if (f.EstadoPago == "Pendiente")
                                {
                                    <button class="btn-accion btn-reactivar" title="Registrar pago"
                                            data-bs-toggle="modal" data-bs-target="#modalPago"
                                            onclick="setFacturaPago(@f.IdFactura, @f.Total)">
                                        <i class="bi bi-cash-coin"></i>
                                    </button>
                                    <button class="btn-accion btn-desactivar" title="Anular factura"
                                            data-bs-toggle="modal" data-bs-target="#modalAnular"
                                            onclick="setFacturaAnular(@f.IdFactura)">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                                @if (f.EstadoPago == "Pagado")
                                {
                                    <span style="font-size:.72rem;color:#15803d">
                                        <i class="bi bi-check2-circle me-1"></i>@(f.MetodoPago)<br />
                                        <span style="color:var(--texto-suave)">@f.FechaPago?.ToString("dd/MM/yy")</span>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="tabla-vacia">
                    <i class="bi bi-receipt" style="font-size:3rem;color:#334155"></i>
                    <p class="mt-2">No se encontraron facturas.</p>
                    <p style="font-size:.8rem;color:var(--texto-suave)">Las facturas se generan desde el detalle de cada orden.</p>
                </div>
            }
        </div>
    </div>

    <!-- Modal Registrar Pago -->
    <div class="modal fade" id="modalPago" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:#fff;border:1px solid var(--borde-input);border-radius:6px">
                <div class="modal-header" style="border-bottom:1px solid var(--borde-input)">
                    <h5 class="modal-title" style="font-size:.9rem;letter-spacing:.06em;color:var(--dorado)">
                        <i class="bi bi-cash-coin me-2"></i>Registrar pago — Factura <span id="numFacturaPago"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Admin" asp-action="RegistrarPago" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idFactura" id="inputIdFactura" />
                    <div class="modal-body" style="padding:24px">
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Monto *</label>
                            <input type="number" name="monto" id="inputMontoPago" class="input-custom" style="padding-left:14px" step="0.01" min="0" required />
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Método de pago *</label>
                            <select name="metodo" class="input-custom select-custom" style="padding-left:14px" required>
                                @foreach (var m in metodosPago)
                                {
                                    <option value="@m">@m</option>
                                }
                            </select>
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Referencia de transacción</label>
                            <input type="text" name="referencia" class="input-custom" style="padding-left:14px" placeholder="Opcional" />
                        </div>
                        <div class="form-group-custom">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Observaciones</label>
                            <input type="text" name="observaciones" class="input-custom" style="padding-left:14px" placeholder="Opcional" />
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--borde-input);padding:14px 24px;gap:10px">
                        <button type="submit" class="btn-guardar"><i class="bi bi-check-circle-fill me-2"></i>Confirmar pago</button>
                        <button type="button" class="btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Anular Factura -->
    <div class="modal fade" id="modalAnular" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="background:#fff;border:1px solid var(--borde-input);border-radius:6px">
                <div class="modal-header" style="border-bottom:1px solid var(--borde-input)">
                    <h5 class="modal-title" style="font-size:.9rem;letter-spacing:.06em;color:#dc2626">
                        <i class="bi bi-x-circle-fill me-2"></i>Anular Factura <span id="numFacturaAnular"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Admin" asp-action="AnularFactura" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idFactura" id="inputIdAnular" />
                    <div class="modal-body" style="padding:24px">
                        <div class="form-group-custom">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Motivo de anulación *</label>
                            <textarea name="motivo" class="input-custom" style="padding:10px 14px;height:80px;resize:none" required placeholder="Explica el motivo de la anulación..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top:1px solid var(--borde-input);padding:14px 24px;gap:10px">
                        <button type="submit" class="btn-guardar" style="background:transparent;color:#dc2626;border-color:#dc2626">
                            <i class="bi bi-x-circle-fill me-2"></i>Anular factura
                        </button>
                        <button type="button" class="btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleNotif() {
            document.getElementById('notifPanel').classList.toggle('open');
        }
        document.addEventListener('click', function (e) {
            const panel = document.getElementById('notifPanel');
            const btn   = document.getElementById('btnCampana');
            if (panel && btn && !panel.contains(e.target) && !btn.contains(e.target)) {
                panel.classList.remove('open');
            }
        });

        setInterval(async () => {
            try {
                const res  = await fetch('/Admin/NotificacionesCount');
                const data = await res.json();
                const badge = document.getElementById('bellBadge');
                const total = (data.solicitudes || 0) + (data.stockBajo || 0);
                if (total > 0) {
                    if (!badge) {
                        const b = document.createElement('span');
                        b.id = 'bellBadge'; b.className = 'bell-badge'; b.textContent = total;
                        document.getElementById('btnCampana').appendChild(b);
                    } else { badge.textContent = total; }
                } else if (badge) { badge.remove(); }
            } catch (e) {}
        }, 30000);

        function setFacturaPago(id, total) {
            document.getElementById('inputIdFactura').value = id;
            document.getElementById('inputMontoPago').value = total;
            document.getElementById('numFacturaPago').textContent = '#' + id;
        }
        function setFacturaAnular(id) {
            document.getElementById('inputIdAnular').value = id;
            document.getElementById('numFacturaAnular').textContent = '#' + id;
        }
    </script>
</body>
</html>
