
@model Optimus_byte.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
    var solicitudes = ViewBag.SolicitudesPendientes as List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.SolicitudRepuestoViewModel>();
    var stockBajo = ViewBag.RepuestosBajoStockList as List<Optimus_byte.Models.ViewModels.RepuestoViewModel>
                      ?? new List<Optimus_byte.Models.ViewModels.RepuestoViewModel>();
    int totalSolicitudes = solicitudes.Count;
    int totalStockBajo = stockBajo.Count;
    int totalNotif = totalSolicitudes + totalStockBajo;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .kpi-card {
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 6px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            transition: var(--transicion);
        }

            .kpi-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(37,99,235,0.1);
            }

        .kpi-icon {
            width: 46px;
            height: 46px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }

        .kpi-num {
            font-size: 2rem;
            font-weight: 700;
            color: var(--marfil);
            line-height: 1;
        }

        .kpi-label {
            font-size: 0.72rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--texto-suave);
        }

        .two-col {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }

        .panel {
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 6px;
            overflow: hidden;
        }

        .panel-header {
            padding: 14px 20px;
            border-bottom: 1px solid var(--borde-input);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title {
            font-size: .8rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 500;
        }

        .panel-body {
            padding: 0;
        }

        .mini-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .8rem;
        }

            .mini-table th {
                padding: 10px 16px;
                font-size: .65rem;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--texto-suave);
                background: var(--grafito-med);
                border-bottom: 1px solid var(--borde-input);
            }

            .mini-table td {
                padding: 10px 16px;
                border-bottom: 1px solid rgba(37,99,235,.05);
                color: var(--texto-claro);
            }

            .mini-table tr:last-child td {
                border-bottom: none;
            }

            .mini-table tr:hover td {
                background: rgba(37,99,235,.02);
            }

        .badge-estado {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 2px;
            font-size: .68rem;
            letter-spacing: .06em;
        }

        .estado-pendiente {
            background: rgba(234,179,8,.1);
            border: 1px solid rgba(234,179,8,.3);
            color: #a16207;
        }

        .estado-proceso {
            background: rgba(37,99,235,.08);
            border: 1px solid rgba(37,99,235,.25);
            color: var(--dorado);
        }

        .estado-espera {
            background: rgba(249,115,22,.08);
            border: 1px solid rgba(249,115,22,.2);
            color: #c2410c;
        }

        .estado-listo {
            background: rgba(22,163,74,.08);
            border: 1px solid rgba(22,163,74,.2);
            color: #15803d;
        }

        .estado-entregado {
            background: rgba(100,116,139,.08);
            border: 1px solid rgba(100,116,139,.2);
            color: #64748b;
        }

        .estado-cancelado {
            background: rgba(220,38,38,.08);
            border: 1px solid rgba(220,38,38,.2);
            color: #b91c1c;
        }

        .stock-bar {
            height: 6px;
            background: var(--grafito-med);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 4px;
        }

        .stock-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--dorado);
        }

            .stock-fill.critico {
                background: #dc2626;
            }

        /* ── Campanita ── */
        .bell-btn {
            position: relative;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 6px;
            color: var(--texto-suave);
            font-size: 1.25rem;
            transition: color .2s;
        }

            .bell-btn:hover {
                color: var(--dorado);
            }

        .bell-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            background: #ef4444;
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
            line-height: 1;
        }
        /* ── Panel notificaciones ── */
        .notif-panel {
            display: none;
            position: fixed;
            top: 54px;
            right: 18px;
            width: 370px;
            max-height: 500px;
            overflow-y: auto;
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            box-shadow: 0 8px 30px rgba(0,0,0,.12);
            z-index: 9999;
        }

            .notif-panel.open {
                display: block;
            }

        .notif-header {
            padding: 12px 16px;
            border-bottom: 1px solid var(--borde-input);
            font-size: .75rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notif-section-title {
            padding: 8px 16px 4px;
            font-size: .65rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            background: var(--grafito-med);
            border-bottom: 1px solid var(--borde-input);
        }

        .notif-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(0,0,0,.04);
            font-size: .82rem;
        }

            .notif-item:last-child {
                border-bottom: none;
            }

        .notif-titulo {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 2px;
        }

        .notif-sub {
            color: #64748b;
            font-size: .76rem;
        }

        .notif-hora {
            color: #94a3b8;
            font-size: .7rem;
            margin-top: 4px;
        }

        .notif-empty {
            padding: 24px 16px;
            text-align: center;
            color: #94a3b8;
            font-size: .82rem;
        }
        /* Stock bajo — chip persistente */
        .stock-alerta-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(220,38,38,.08);
            border: 1px solid rgba(220,38,38,.25);
            color: #b91c1c;
            border-radius: 4px;
            font-size: .7rem;
            font-weight: 600;
            padding: 3px 9px;
        }
    </style>
</head>
<body>

    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">

            @* ── CAMPANITA ── *@
            <button class="bell-btn" id="btnCampana" title="Notificaciones" onclick="toggleNotif()">
                <i class="bi bi-bell-fill"></i>
                @if (totalNotif > 0)
                {
                    <span class="bell-badge" id="bellBadge">@totalNotif</span>
                }
            </button>

            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    @* ── Panel de notificaciones ── *@
    <div class="notif-panel" id="notifPanel">
        <div class="notif-header">
            <span><i class="bi bi-bell me-1"></i>Notificaciones</span>
            @if (totalNotif > 0)
            {
                <span style="background:#ef4444;color:#fff;font-size:.65rem;padding:2px 7px;border-radius:10px">
                    @totalNotif pendiente(s)
                </span>
            }
        </div>

        @* — Solicitudes de repuesto — *@
        @if (solicitudes.Any())
        {
            <div class="notif-section-title"><i class="bi bi-box-seam me-1"></i>Solicitudes de repuesto (@totalSolicitudes)</div>
            @foreach (var s in solicitudes)
            {
                bool esLibre = s.NombreRepuesto?.StartsWith("[Sin inventario]") ?? false;
                string nombreMostrar = esLibre ? s.NombreRepuesto!.Replace("[Sin inventario]", "").Trim() : (s.NombreRepuesto ?? "—");
                <div class="notif-item">
                    <div class="notif-titulo">
                        <i class="bi bi-box-seam me-1" style="color:#f97316"></i>
                        @if (esLibre)
                        {
                            <span style="font-size:.63rem;background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:1px 6px;margin-right:4px">Sin inventario</span>
                        }
                        @nombreMostrar <span style="color:#94a3b8;font-weight:400"> × @s.Cantidad</span>
                    </div>
                    <div class="notif-sub">OT-@s.IdOrden &nbsp;·&nbsp; @s.MecanicoNombre</div>
                    @if (!string.IsNullOrWhiteSpace(s.Motivo))
                    {
                        <div class="notif-sub" style="margin-top:2px;font-style:italic"><i class="bi bi-chat-left-text me-1"></i>@s.Motivo</div>
                    }
                    <div class="notif-hora">@s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
                        @if (esLibre)
                        {
                            <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-plus-circle"></i> Crear en inventario
                            </a>
                        }
                        else
                        {
                            <form asp-controller="Admin" asp-action="AceptarSolicitudRepuesto" method="post" style="display:inline" onsubmit="return confirm('¿Aceptar y descontar stock de este repuesto?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                                <input type="hidden" name="ordenId" value="@s.IdOrden" />
                                <input type="hidden" name="repuestoNombre" value="@nombreMostrar" />
                                <input type="hidden" name="cantidad" value="@s.Cantidad" />
                                <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#22c55e;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                    <i class="bi bi-check2"></i> Aceptar
                                </button>
                            </form>
                        }
                        <form asp-controller="Admin" asp-action="RechazarSolicitudRepuesto" method="post" style="display:inline" onsubmit="return confirm('¿Rechazar esta solicitud?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="solicitudId" value="@s.IdSolicitud" />
                            <button type="submit" style="font-size:.68rem;padding:4px 10px;background:#ef4444;color:#fff;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                                <i class="bi bi-x-lg"></i> Rechazar
                            </button>
                        </form>
                    </div>
                </div>
            }
        }

        @* — Stock bajo (persistente hasta que suba el mecánico) — *@
        @if (stockBajo.Any())
        {
            <div class="notif-section-title"><i class="bi bi-exclamation-triangle-fill me-1" style="color:#dc2626"></i>Stock bajo (@totalStockBajo repuesto(s))</div>
            @foreach (var r in stockBajo)
            {
                <div class="notif-item">
                    <div class="notif-titulo">
                        <span class="stock-alerta-chip"><i class="bi bi-exclamation-triangle-fill"></i>STOCK BAJO</span>
                        <span style="margin-left:6px">@r.Nombre</span>
                    </div>
                    <div class="notif-sub" style="margin-top:4px">
                        Stock actual: <strong style="color:#dc2626">@r.StockActual</strong> &nbsp;·&nbsp; Mínimo: @r.StockMinimo
                        &nbsp;·&nbsp; Ref: <span style="font-family:monospace">@r.Referencia</span>
                    </div>
                    <div style="margin-top:6px">
                        <a href="/Admin/Inventario" style="font-size:.68rem;padding:4px 10px;background:#3b82f6;color:#fff;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:4px">
                            <i class="bi bi-arrow-up-circle"></i> Actualizar stock
                        </a>
                    </div>
                </div>
            }
        }

        @if (totalNotif == 0)
        {
            <div class="notif-empty">
                <i class="bi bi-check-circle" style="font-size:1.8rem;display:block;margin-bottom:8px;color:#22c55e"></i>
                Sin notificaciones pendientes
            </div>
        }

        @if (solicitudes.Any())
        {
            <div style="padding:10px 16px;text-align:right">
                <a href="/Admin/SolicitudesRepuesto" style="font-size:.76rem;color:var(--dorado);text-decoration:none">
                    Ver todas las solicitudes <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes" class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Admin/Facturas" class="nav-link"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Admin/Dashboard" class="nav-link active"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            <a href="/VehiculosAdmin/Index" class="nav-link"><i class="bi bi-car-front-fill"></i><span>Vehículos</span></a>
            <a href="/Admin/SolicitudesRepuesto" class="nav-link" style="position:relative">
                <i class="bi bi-bell-fill"></i>
                <span>Solicitudes</span>
                @if (totalSolicitudes > 0)
                {
                    <span style="position:absolute;top:6px;right:10px;background:#ef4444;color:#fff;font-size:.55rem;font-weight:700;min-width:15px;height:15px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px">@totalSolicitudes</span>
                }
            </a>
        </nav>
    </div>

    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Dashboard</h1>
                <p class="section-sub">Resumen general del sistema · @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-CO"))</p>
            </div>
        </div>

        @* Alerta persistente de stock bajo (banner visible en contenido) *@
        @if (stockBajo.Any())
        {
            <div style="background:rgba(220,38,38,.07);border:1px solid rgba(220,38,38,.25);border-radius:6px;padding:12px 18px;margin-bottom:20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;font-size:1.1rem"></i>
                <span style="font-size:.82rem;color:#b91c1c;font-weight:600">
                    @totalStockBajo repuesto(s) con stock bajo mínimo.
                </span>
                <span style="font-size:.8rem;color:#64748b">Esta alerta desaparece cuando el stock sea repuesto.</span>
                <a href="/Admin/Inventario" style="margin-left:auto;font-size:.75rem;color:#dc2626;text-decoration:underline">Ver inventario</a>
            </div>
        }

        <div class="citas-strip">
            <div class="cita-chip">
                <i class="bi bi-calendar-day-fill"></i>
                <div><strong>@Model.CitasHoy</strong><span>Total de citas del día</span></div>
            </div>
            <div class="cita-chip">
                <i class="bi bi-car-front-fill"></i>
                <div><strong>@Model.VehiculosMantenimiento</strong><span>Vehículos en mantenimiento</span></div>
            </div>
            <div class="cita-chip">
                <i class="bi bi-calendar2-week-fill"></i>
                <div><strong>@Model.ProximasCitas</strong><span>Próximas citas</span></div>
            </div>
            <div class="cita-chip">
                <i class="bi bi-graph-up-arrow"></i>
                <div><strong>@Model.OrdenesHoy</strong><span>Estadísticas rápidas</span></div>
            </div>
        </div>

        <div class="panel" style="margin-bottom:20px">
            <div class="panel-header">
                <span class="panel-title"><i class="bi bi-calendar-check me-2"></i>Citas solicitadas por clientes</span>
            </div>
            <div class="panel-body">
                <table class="mini-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Vehículo</th>
                            <th>Servicio</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in Model.CitasRecientes)
                        {
                            <tr>
                                <td>@cita.FechaHora.ToString("dd/MM hh:mm tt")</td>
                                <td>@cita.Cliente</td>
                                <td><strong>@cita.Placa</strong> · @cita.Vehiculo</td>
                                <td>@cita.Servicio</td>
                                <td><span class="badge-estado estado-proceso">@cita.Estado</span></td>
                                <td>
                                    @if (cita.Estado == "Pendiente" || cita.Estado == "Solicitada")
                                    {
                                        <button onclick="abrirModalAprobar(@cita.IdCita, @cita.IdVehiculo,'@Html.Raw(cita.Servicio.Replace("'","\\'"))','@Html.Raw(cita.Observaciones.Replace("'","\\'"))','@cita.Cliente','@cita.Placa')"
                                                style="padding:4px 10px;background:#16a34a;color:#fff;
                                           border:none;border-radius:4px;font-size:.72rem;cursor:pointer;">
                                            ✓ Aprobar
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size:.72rem;color:#64748b;">@cita.Estado</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.CitasRecientes.Any())
                        {
                            <tr>
                                <td colspan="6" style="text-align:center;padding:24px;
                    color:var(--texto-suave)">
                                    Sin citas solicitadas
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>        
            </div>
        </div>

        <!-- KPIs -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(37,99,235,.08)">
                    <i class="bi bi-people-fill" style="color:var(--dorado)"></i>
                </div>
                <div class="kpi-num">@Model.TotalUsuarios</div>
                <div class="kpi-label">Usuarios del sistema</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(22,163,74,.08)">
                    <i class="bi bi-person-check-fill" style="color:#15803d"></i>
                </div>
                <div class="kpi-num">@Model.TotalClientes</div>
                <div class="kpi-label">Clientes activos</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(14,116,144,.08)">
                    <i class="bi bi-car-front-fill" style="color:#0e7490"></i>
                </div>
                <div class="kpi-num">@Model.TotalVehiculos</div>
                <div class="kpi-label">Vehículos registrados</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(234,179,8,.08)">
                    <i class="bi bi-clipboard2-check-fill" style="color:#a16207"></i>
                </div>
                <div class="kpi-num">@Model.OrdenesAbiertas</div>
                <div class="kpi-label">Órdenes abiertas</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(249,115,22,.08)">
                    <i class="bi bi-calendar-day-fill" style="color:#c2410c"></i>
                </div>
                <div class="kpi-num">@Model.OrdenesHoy</div>
                <div class="kpi-label">Órdenes de hoy</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(220,38,38,.08)">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626"></i>
                </div>
                <div class="kpi-num">@Model.RepuestosBajoStock</div>
                <div class="kpi-label">Repuestos bajo stock</div>
            </div>
            <div class="kpi-card" style="border-color:rgba(37,99,235,.3)">
                <div class="kpi-icon" style="background:rgba(37,99,235,.08)">
                    <i class="bi bi-cash-stack" style="color:var(--dorado)"></i>
                </div>
                <div class="kpi-num" style="font-size:1.5rem">$@Model.IngresosMes.ToString("N0")</div>
                <div class="kpi-label">Ingresos este mes</div>
            </div>
        </div>

        <!-- Dos columnas -->
        <div class="two-col">

            <!-- Órdenes recientes -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title"><i class="bi bi-clipboard2-pulse me-2"></i>Órdenes recientes</span>
                    <a href="/Admin/Ordenes" class="btn-volver" style="padding:5px 12px;font-size:.72rem">Ver todas</a>
                </div>
                <div class="panel-body">
                    <table class="mini-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Placa</th>
                                <th>Cliente</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.OrdenesRecientes)
                            {
                                var cls = o.Estado switch
                                {
                                    "Pendiente" => "estado-pendiente",
                                    "En proceso" => "estado-proceso",
                                    "Esperando repuesto" => "estado-espera",
                                    "Listo para entrega" => "estado-listo",
                                    "Entregado" => "estado-entregado",
                                    "Cancelado" => "estado-cancelado",
                                    _ => ""
                                };
                                <tr>
                                    <td><a href="/Admin/OrdenDetalle/@o.IdOrden" style="color:var(--dorado)">#@o.IdOrden</a></td>
                                    <td><strong>@o.Placa</strong></td>
                                    <td>@o.Cliente</td>
                                    <td><span class="badge-estado @cls">@o.Estado</span></td>
                                    <td style="color:var(--texto-suave)">@o.FechaApertura.ToString("dd/MM")</td>
                                </tr>
                            }
                            @if (!Model.OrdenesRecientes.Any())
                            {
                                <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--texto-suave)">Sin órdenes</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Repuestos críticos -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title"><i class="bi bi-exclamation-triangle me-2"></i>Stock crítico</span>
                    <a href="/Admin/Inventario" class="btn-volver" style="padding:5px 12px;font-size:.72rem">Ver inventario</a>
                </div>
                <div class="panel-body" style="padding:16px">
                    @foreach (var r in Model.RepuestosCriticos)
                    {
                        double pct = r.StockMinimo > 0
                        ? Math.Min(100, (double)r.StockActual / r.StockMinimo * 100) : 0;
                        <div style="margin-bottom:16px">
                            <div class="d-flex justify-content-between" style="font-size:.8rem">
                                <span style="font-weight:500">@r.Nombre</span>
                                <span style="color:var(--texto-suave)">@r.StockActual/@r.StockMinimo</span>
                            </div>
                            <div style="font-size:.7rem;color:var(--texto-suave);margin-bottom:4px">@r.Referencia</div>
                            <div class="stock-bar">
                                <div class="stock-fill critico" style="width:@((int)pct)%"></div>
                            </div>
                        </div>
                    }
                    @if (!Model.RepuestosCriticos.Any())
                    {
                        <p style="text-align:center;color:var(--texto-suave);font-size:.82rem;padding:20px 0">
                            <i class="bi bi-check-circle-fill me-1" style="color:#15803d"></i>Todo el stock en niveles correctos
                        </p>
                    }
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleNotif() {
            document.getElementById('notifPanel').classList.toggle('open');
        }
        document.addEventListener('click', function (e) {
            const panel = document.getElementById('notifPanel');
            const btn   = document.getElementById('btnCampana');
            if (panel && btn && !panel.contains(e.target) && !btn.contains(e.target)) {
                panel.classList.remove('open');
            }
        });

        // Polling badge cada 30s
        setInterval(async () => {
            try {
                const res  = await fetch('/Admin/NotificacionesCount');
                const data = await res.json();
                const badge = document.getElementById('bellBadge');
                const total = (data.solicitudes || 0) + (data.stockBajo || 0);
                if (total > 0) {
                    if (!badge) {
                        const b = document.createElement('span');
                        b.id = 'bellBadge'; b.className = 'bell-badge'; b.textContent = total;
                        document.getElementById('btnCampana').appendChild(b);
                    } else { badge.textContent = total; }
                } else if (badge) { badge.remove(); }
            } catch (e) {}
        }, 30000);
    </script>

    <!-- Modal Aprobar Cita -->
    <div class="modal fade" id="modalAprobarCita" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-size:.9rem;color:var(--dorado)">
                        <i class="bi bi-calendar-check me-2"></i>Aprobar cita y crear orden
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Admin" asp-action="AprobarCita" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idCita" id="ac_idCita" />
                    <input type="hidden" name="idVehiculo" id="ac_idVehiculo" />
                    <input type="hidden" name="servicio" id="ac_servicio" />
                    <div class="modal-body" style="padding:20px;display:flex;flex-direction:column;gap:14px;">

                        <div id="ac_resumen" style="background:#f8fafc;border:1px solid #e2e8f0;
                         border-radius:6px;padding:12px;font-size:.82rem;color:#334155;"></div>

                        <!-- Mecánico -->
                        <div>
                            <label style="font-size:.72rem;text-transform:uppercase;
                                      letter-spacing:.08em;color:#64748b;">
                                Asignar mecánico (opcional)
                            </label>
                            <select name="idMecanico" class="form-select form-select-sm mt-1">
                                <option value="">Sin asignar por ahora</option>
                                @foreach (var m in ViewBag.Mecanicos as List<(int Id, string Nombre)>
                                ?? new List<(int Id, string Nombre)>())
                                {
                                    <option value="@m.Id">@m.Nombre</option>
                                }
                            </select>
                        </div>

                        <!-- KM ingreso -->
                        <div>
                            <label style="font-size:.72rem;text-transform:uppercase;
                                      letter-spacing:.08em;color:#64748b;">
                                Kilómetros de ingreso *
                            </label>
                            <input type="number" name="kmIngreso" class="form-control form-control-sm mt-1"
                                   required min="0" placeholder="Ej: 45000" />
                        </div>

                        <!-- Observaciones -->
                        <div>
                            <label style="font-size:.72rem;text-transform:uppercase;
                                      letter-spacing:.08em;color:#64748b;">
                                Observaciones
                            </label>
                            <textarea name="observaciones" id="ac_obs" class="form-control form-control-sm mt-1"
                                      rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit"
                                style="padding:8px 20px;background:#16a34a;color:#fff;
                                   border:none;border-radius:5px;font-size:.82rem;cursor:pointer;">
                            ✓ Aprobar y crear orden
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function abrirModalAprobar(idCita, idVehiculo, servicio, obs, cliente, placa) {
            document.getElementById('ac_idCita').value     = idCita;
            document.getElementById('ac_idVehiculo').value = idVehiculo;
            document.getElementById('ac_servicio').value   = servicio;
            document.getElementById('ac_obs').value        = obs;
            document.getElementById('ac_resumen').innerHTML =
                `<strong>${cliente}</strong> · ${placa}<br>
                 <span style="color:#2563eb">${servicio}</span>`;
            new bootstrap.Modal(document.getElementById('modalAprobarCita')).show();
        }
    </script>
</body>
</html>
