@model Optimus_byte.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 28px; }
        .kpi-card { background: #fff; border: 1px solid var(--borde-input); border-radius: 6px; padding: 20px; display: flex; flex-direction: column; gap: 8px; transition: var(--transicion); }
        .kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(37,99,235,0.1); }
        .kpi-icon { width: 46px; height: 46px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
        .kpi-num { font-size: 2rem; font-weight: 700; color: var(--marfil); line-height: 1; }
        .kpi-label { font-size: 0.72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--texto-suave); }
        .two-col { display: grid; grid-template-columns: 1.6fr 1fr; gap: 20px; margin-top: 20px; }
        .panel { background: #fff; border: 1px solid var(--borde-input); border-radius: 6px; overflow: hidden; }
        .panel-header { padding: 14px 20px; border-bottom: 1px solid var(--borde-input); display: flex; align-items: center; justify-content: space-between; }
        .panel-title { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--dorado); font-weight: 500; }
        .panel-body { padding: 0; }
        .mini-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
        .mini-table th { padding: 10px 16px; font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; color: var(--texto-suave); background: var(--grafito-med); border-bottom: 1px solid var(--borde-input); }
        .mini-table td { padding: 10px 16px; border-bottom: 1px solid rgba(37,99,235,.05); color: var(--texto-claro); }
        .mini-table tr:last-child td { border-bottom: none; }
        .mini-table tr:hover td { background: rgba(37,99,235,.02); }
        .badge-estado { display: inline-block; padding: 2px 8px; border-radius: 2px; font-size: .68rem; letter-spacing: .06em; }
        .estado-pendiente   { background: rgba(234,179,8,.1);  border: 1px solid rgba(234,179,8,.3);  color: #a16207; }
        .estado-proceso     { background: rgba(37,99,235,.08); border: 1px solid rgba(37,99,235,.25); color: var(--dorado); }
        .estado-espera      { background: rgba(249,115,22,.08);border: 1px solid rgba(249,115,22,.2); color: #c2410c; }
        .estado-listo       { background: rgba(22,163,74,.08); border: 1px solid rgba(22,163,74,.2);  color: #15803d; }
        .estado-entregado   { background: rgba(100,116,139,.08);border: 1px solid rgba(100,116,139,.2);color: #64748b; }
        .estado-cancelado   { background: rgba(220,38,38,.08); border: 1px solid rgba(220,38,38,.2);  color: #b91c1c; }
        .stock-bar { height: 6px; background: var(--grafito-med); border-radius: 3px; overflow: hidden; margin-top: 4px; }
        .stock-fill { height: 100%; border-radius: 3px; background: var(--dorado); }
        .stock-fill.critico { background: #dc2626; }
    </style>
</head>
<body>

    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios"        class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes"   class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Admin/Facturas"  class="nav-link"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Admin/Dashboard" class="nav-link active"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            <a href="/VehiculosAdmin/Index" class="nav-link active"><i class="bi bi-car-front-fill"></i><span>Vehículos</span></a>
        </nav>
    </div>

    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Dashboard</h1>
                <p class="section-sub">Resumen general del sistema · @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-CO"))</p>
            </div>
        </div>

        <!-- KPIs -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(37,99,235,.08)">
                    <i class="bi bi-people-fill" style="color:var(--dorado)"></i>
                </div>
                <div class="kpi-num">@Model.TotalUsuarios</div>
                <div class="kpi-label">Usuarios del sistema</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(22,163,74,.08)">
                    <i class="bi bi-person-check-fill" style="color:#15803d"></i>
                </div>
                <div class="kpi-num">@Model.TotalClientes</div>
                <div class="kpi-label">Clientes activos</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(14,116,144,.08)">
                    <i class="bi bi-car-front-fill" style="color:#0e7490"></i>
                </div>
                <div class="kpi-num">@Model.TotalVehiculos</div>
                <div class="kpi-label">Vehículos registrados</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(234,179,8,.08)">
                    <i class="bi bi-clipboard2-check-fill" style="color:#a16207"></i>
                </div>
                <div class="kpi-num">@Model.OrdenesAbiertas</div>
                <div class="kpi-label">Órdenes abiertas</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(249,115,22,.08)">
                    <i class="bi bi-calendar-day-fill" style="color:#c2410c"></i>
                </div>
                <div class="kpi-num">@Model.OrdenesHoy</div>
                <div class="kpi-label">Órdenes de hoy</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(220,38,38,.08)">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626"></i>
                </div>
                <div class="kpi-num">@Model.RepuestosBajoStock</div>
                <div class="kpi-label">Repuestos bajo stock</div>
            </div>
            <div class="kpi-card" style="border-color:rgba(37,99,235,.3)">
                <div class="kpi-icon" style="background:rgba(37,99,235,.08)">
                    <i class="bi bi-cash-stack" style="color:var(--dorado)"></i>
                </div>
                <div class="kpi-num" style="font-size:1.5rem">$@Model.IngresosMes.ToString("N0")</div>
                <div class="kpi-label">Ingresos este mes</div>
            </div>
        </div>

        <!-- Dos columnas -->
        <div class="two-col">

            <!-- Órdenes recientes -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title"><i class="bi bi-clipboard2-pulse me-2"></i>Órdenes recientes</span>
                    <a href="/Admin/Ordenes" class="btn-volver" style="padding:5px 12px;font-size:.72rem">Ver todas</a>
                </div>
                <div class="panel-body">
                    <table class="mini-table">
                        <thead>
                            <tr>
                                <th>#</th><th>Placa</th><th>Cliente</th><th>Estado</th><th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.OrdenesRecientes)
                            {
                                var cls = o.Estado switch {
                                    "Pendiente"           => "estado-pendiente",
                                    "En proceso"          => "estado-proceso",
                                    "Esperando repuesto"  => "estado-espera",
                                    "Listo para entrega"  => "estado-listo",
                                    "Entregado"           => "estado-entregado",
                                    "Cancelado"           => "estado-cancelado",
                                    _                     => ""
                                };
                                <tr>
                                    <td><a href="/Admin/OrdenDetalle/@o.IdOrden" style="color:var(--dorado)">#@o.IdOrden</a></td>
                                    <td><strong>@o.Placa</strong></td>
                                    <td>@o.Cliente</td>
                                    <td><span class="badge-estado @cls">@o.Estado</span></td>
                                    <td style="color:var(--texto-suave)">@o.FechaApertura.ToString("dd/MM")</td>
                                </tr>
                            }
                            @if (!Model.OrdenesRecientes.Any())
                            {
                                <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--texto-suave)">Sin órdenes</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Repuestos críticos -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title"><i class="bi bi-exclamation-triangle me-2"></i>Stock crítico</span>
                    <a href="/Admin/Inventario" class="btn-volver" style="padding:5px 12px;font-size:.72rem">Ver inventario</a>
                </div>
                <div class="panel-body" style="padding:16px">
                    @foreach (var r in Model.RepuestosCriticos)
                    {
                        double pct = r.StockMinimo > 0
                            ? Math.Min(100, (double)r.StockActual / r.StockMinimo * 100) : 0;
                        <div style="margin-bottom:16px">
                            <div class="d-flex justify-content-between" style="font-size:.8rem">
                                <span style="font-weight:500">@r.Nombre</span>
                                <span style="color:var(--texto-suave)">@r.StockActual/@r.StockMinimo</span>
                            </div>
                            <div style="font-size:.7rem;color:var(--texto-suave);margin-bottom:4px">@r.Referencia</div>
                            <div class="stock-bar">
                                <div class="stock-fill critico" style="width:@((int)pct)%"></div>
                            </div>
                        </div>
                    }
                    @if (!Model.RepuestosCriticos.Any())
                    {
                        <p style="text-align:center;color:var(--texto-suave);font-size:.82rem;padding:20px 0">
                            <i class="bi bi-check-circle-fill me-1" style="color:#15803d"></i>Todo el stock en niveles correctos
                        </p>
                    }
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
