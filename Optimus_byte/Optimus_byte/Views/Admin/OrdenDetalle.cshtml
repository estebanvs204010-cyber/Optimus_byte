@model Optimus_byte.Models.ViewModels.OrdenDetalleViewModel
@{
    ViewData["Title"] = $"Orden #{Model.IdOrden}";
    Layout = null;
    string[] estadosDisponibles = { "Pendiente","En proceso","Esperando repuesto","Listo para entrega","Entregado","Cancelado" };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Orden #@Model.IdOrden</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
  
</head>
<body>

    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UsuarioNombre")</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios"         class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes"    class="nav-link active"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Admin/Facturas"   class="nav-link"><i class="bi bi-receipt"></i><span>Facturas</span></a>
            <a href="/Admin/Dashboard"  class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
            <a href="/VehiculosAdmin/Index" class="nav-link active"><i class="bi bi-car-front-fill"></i><span>Vehículos</span></a>
        </nav>
    </div>

    <div class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Orden #@Model.IdOrden</h1>
                <p class="section-sub">
                    <span class="badge-estado estado-@Model.Estado">@Model.Estado</span>
                    &nbsp;·&nbsp; Abierta el @Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")
                    @if (Model.FechaCierre.HasValue)
                    {
                        @:&nbsp;·&nbsp; Cerrada el @Model.FechaCierre.Value.ToString("dd/MM/yyyy")
                    }
                </p>
            </div>
            <a href="/Admin/Ordenes" class="btn-volver"><i class="bi bi-arrow-left me-2"></i>Volver</a>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err"><i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]</div>
        }

        <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:18px">

            <!-- Columna izquierda -->
            <div>

                <!-- Info vehículo y cliente -->
                <div class="card-section">
                    <h3><i class="bi bi-car-front me-2"></i>Vehículo y cliente</h3>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Placa</span>
                            <span class="info-val" style="font-weight:600;color:var(--dorado);font-size:1.1rem">@Model.Placa</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Vehículo</span>
                            <span class="info-val">@Model.MarcaModelo @(!string.IsNullOrEmpty(Model.Color) ? $"· {Model.Color}" : "")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">KM actuales</span>
                            <span class="info-val">@Model.KmActuales.ToString("N0") km</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">KM de ingreso</span>
                            <span class="info-val">@Model.KmIngreso.ToString("N0") km</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Cliente</span>
                            <span class="info-val">@Model.Cliente</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Contacto</span>
                            <span class="info-val">@Model.TelefonoCliente · @Model.CorreoCliente</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Tipo de servicio</span>
                            <span class="info-val">@Model.TipoServicio</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Mecánico</span>
                            <span class="info-val">@Model.Mecanico</span>
                        </div>
                    </div>
                </div>

                <!-- Descripción y diagnóstico -->
                <div class="card-section">
                    <h3><i class="bi bi-file-text me-2"></i>Problema y diagnóstico</h3>
                    <div class="info-item mb-3">
                        <span class="info-label">Descripción del problema</span>
                        <span class="info-val" style="line-height:1.6">@Model.DescripcionProblema</span>
                    </div>
                    <form asp-controller="Admin" asp-action="ActualizarDiagnostico" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idOrden" value="@Model.IdOrden" />
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Diagnóstico</label>
                            <textarea name="diagnostico" class="input-custom" style="padding:10px 14px;height:80px;resize:none" placeholder="Diagnóstico técnico...">@Model.Diagnostico</textarea>
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Observaciones</label>
                            <textarea name="observaciones" class="input-custom" style="padding:10px 14px;height:60px;resize:none" placeholder="Notas adicionales...">@Model.Observaciones</textarea>
                        </div>
                        <button type="submit" class="btn-guardar" style="font-size:.72rem;padding:8px 18px">
                            <i class="bi bi-floppy-fill me-1"></i>Guardar diagnóstico
                        </button>
                    </form>
                </div>

                <!-- Repuestos usados -->
                <div class="card-section">
                    <h3><i class="bi bi-wrench me-2"></i>Repuestos utilizados (@Model.Repuestos.Count)</h3>
                    @if (Model.Repuestos.Any())
                    {
                        <table class="mini-table">
                            <thead>
                                <tr><th>Repuesto</th><th>Ref.</th><th>Cant.</th><th>Precio unit.</th><th>Subtotal</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Repuestos)
                                {
                                    <tr>
                                        <td>@r.Nombre</td>
                                        <td style="color:var(--texto-suave)">@r.Referencia</td>
                                        <td>@r.Cantidad</td>
                                        <td>$@r.PrecioUsado.ToString("N0")</td>
                                        <td style="font-weight:500">$@((r.PrecioUsado * r.Cantidad).ToString("N0"))</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4" style="text-align:right;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--texto-suave)">Total repuestos</td>
                                    <td style="font-weight:600;color:var(--dorado)">$@Model.Repuestos.Sum(r => r.PrecioUsado * r.Cantidad).ToString("N0")</td>
                                </tr>
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="color:var(--texto-suave);font-size:.82rem">Sin repuestos registrados aún.</p>
                    }
                </div>
            </div>

            <!-- Columna derecha -->
            <div>

                <!-- Cambiar estado -->
                <div class="card-section">
                    <h3><i class="bi bi-arrow-repeat me-2"></i>Cambiar estado</h3>
                    <form asp-controller="Admin" asp-action="CambiarEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idOrden" value="@Model.IdOrden" />
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Nuevo estado</label>
                            <select name="nuevoEstado" class="input-custom select-custom" style="padding-left:14px">
                                @foreach (var e in estadosDisponibles)
                                {
                                    <option value="@e" selected="@(e == Model.Estado ? "selected" : null)">@e</option>
                                }
                            </select>
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Reasignar mecánico</label>
                            <select name="idMecanico" class="input-custom select-custom" style="padding-left:14px">
                                <option value="">— Sin cambios —</option>
                                @foreach (var m in (List<(int Id, string Nombre)>)ViewBag.Mecanicos)
                                {
                                    <option value="@m.Id" selected="@(m.Id == Model.IdMecanicoActual ? "selected" : null)">@m.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="form-group-custom mb-3">
                            <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Observación</label>
                            <textarea name="observacion" class="input-custom" style="padding:10px 14px;height:60px;resize:none" placeholder="Motivo del cambio..."></textarea>
                        </div>
                        <button type="submit" class="btn-guardar" style="font-size:.72rem;padding:8px 18px;width:100%">
                            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar estado
                        </button>
                    </form>
                </div>

                <!-- Historial -->
                <div class="card-section">
                    <h3><i class="bi bi-clock-history me-2"></i>Historial de estados</h3>
                    <div class="timeline">
                        @foreach (var h in Model.Historial)
                        {
                            <div class="tl-item">
                                <div class="tl-dot"></div>
                                <div class="tl-fecha">@h.FechaCambio.ToString("dd/MM/yyyy HH:mm") · @h.Usuario</div>
                                <div class="tl-estado">@h.EstadoNuevo</div>
                                @if (!string.IsNullOrEmpty(h.Observacion))
                                {
                                    <div class="tl-obs">@h.Observacion</div>
                                }
                            </div>
                        }
                        @if (!Model.Historial.Any())
                        {
                            <p style="color:var(--texto-suave);font-size:.8rem">Sin historial aún.</p>
                        }
                    </div>
                </div>

                <!-- Crear factura -->
                @if (Model.Estado == "Listo para entrega" || Model.Estado == "Entregado")
                {
                    <div class="card-section">
                        <h3><i class="bi bi-receipt me-2"></i>Generar factura</h3>
                        <form asp-controller="Admin" asp-action="CrearFactura" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idOrden" value="@Model.IdOrden" />
                            <div class="form-group-custom mb-3">
                                <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">Subtotal (mano de obra + repuestos)</label>
                                <input type="number" name="subtotal" class="input-custom" style="padding-left:14px" step="0.01" min="0"
                                       value="@Model.Repuestos.Sum(r => r.PrecioUsado * r.Cantidad)" required />
                            </div>
                            <div class="form-group-custom mb-3">
                                <label style="font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto-suave)">IVA (19%)</label>
                                <input type="number" name="iva" id="inputIva" class="input-custom" style="padding-left:14px" step="0.01" min="0" required />
                            </div>
                            <button type="submit" class="btn-guardar" style="font-size:.72rem;padding:8px 18px;width:100%"
                                    onclick="return confirm('¿Confirmas la generación de la factura?')">
                                <i class="bi bi-receipt me-1"></i>Generar factura
                            </button>
                        </form>
                    </div>
                }

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-calcular IVA 19%
        const subInput = document.querySelector('input[name="subtotal"]');
        const ivaInput = document.getElementById('inputIva');
        if (subInput && ivaInput) {
            const calcIva = () => {
                const sub = parseFloat(subInput.value) || 0;
                ivaInput.value = (sub * 0.19).toFixed(2);
            };
            subInput.addEventListener('input', calcIva);
            calcIva();
        }
    </script>
</body>
</html>
