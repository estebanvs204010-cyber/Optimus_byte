@model List<Optimus_byte.Models.SolicitudRepuesto>
@{
    ViewData["Title"] = "Solicitudes de Repuesto";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solicitudes de Repuesto — Optimus Byte</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>

    <!-- TOP BAR -->
    <div class="topbar">
        <div class="topbar-brand">
            <i class="fas fa-bolt"></i>
            Optimus Byte — Admin
        </div>
        <a href="/Admin/Dashboard" class="btn-back">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
    </div>

    <!-- MAIN -->
    <div class="main">

        <!-- Header -->
        <div class="page-header">
            <div>
                <h1 class="page-title">Solicitudes de <span>Repuesto</span></h1>
                <p style="color:var(--muted);font-size:.88rem;margin-top:4px;">
                    Gestiona las solicitudes enviadas por los mecánicos
                </p>
            </div>
        </div>

        <!-- Stats -->
        @{
            int total = Model?.Count ?? 0;
            int pendiente = Model?.Count(s => !s.Atendida) ?? 0;
            int atendida = Model?.Count(s => s.Atendida) ?? 0;
        }
        <div class="stats-row">
            <div class="stat-chip total">
                <i class="fas fa-list-ul" style="color:var(--accent)"></i>
                Total: <span class="num">@total</span>
            </div>
            <div class="stat-chip pending">
                <i class="fas fa-hourglass-half" style="color:var(--warning)"></i>
                Pendientes: <span class="num">@pendiente</span>
            </div>
            <div class="stat-chip done">
                <i class="fas fa-check-circle" style="color:var(--success)"></i>
                Atendidas: <span class="num">@atendida</span>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" onclick="filtrar('todas', this)">Todas</button>
            <button class="tab-btn" onclick="filtrar('pendientes', this)">Pendientes</button>
            <button class="tab-btn" onclick="filtrar('atendidas', this)">Atendidas</button>
            <button class="tab-btn" onclick="filtrar('libre', this)">Sin inventario</button>
        </div>

        <!-- Table -->
        <div class="table-wrap">
            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <p>No hay solicitudes de repuesto registradas.</p>
                </div>
            }
            else
            {
                <table id="tabla-solicitudes">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Orden</th>
                            <th>Mecánico</th>
                            <th>Repuesto solicitado</th>
                            <th>Origen</th>
                            <th>Cantidad</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.OrderByDescending(x => x.FechaSolicitud))
                        {
                            bool esLibre = s.NombreRepuesto?.StartsWith("[Sin inventario]") ?? false;
                            string nombre = esLibre
                            ? s.NombreRepuesto!.Replace("[Sin inventario]", "").Trim()
                            : (s.NombreRepuesto ?? "—");
                            string rowClass = s.Atendida ? "row-atendida" : "row-pendiente";

                            <tr class="@rowClass" data-libre="@esLibre.ToString().ToLower()">
                                <td style="color:var(--muted);font-size:.8rem;">@s.Id</td>

                                <td class="text-main">
                                    <a href="/Admin/DetalleOrden/@s.OrdenId"
                                       style="color:var(--accent);text-decoration:none;">
                                        #@s.OrdenId
                                    </a>
                                </td>

                                <td>@(s.NombreMecanico ?? "—")</td>

                                <td class="text-main">@nombre</td>

                                <td>
                                    @if (esLibre)
                                    {
                                        <span class="badge badge-libre">
                                            <i class="fas fa-pencil-alt"></i> Texto libre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inv">
                                            <i class="fas fa-boxes"></i> Inventario
                                        </span>
                                    }
                                </td>

                                <td>@s.Cantidad</td>

                                <td style="white-space:nowrap;font-size:.82rem;">
                                    @s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @if (s.Atendida)
                                    {
                                        <span class="badge badge-done">
                                            <i class="fas fa-check"></i> Atendida
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">
                                            <i class="fas fa-clock"></i> Pendiente
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!s.Atendida)
                                    {
                                        @if (esLibre)
                                        {
                                            <!-- Repuesto no está en inventario: enviar al admin a crearlo primero -->
                                            <a href="/Admin/NuevoRepuesto?nombre=@Uri.EscapeDataString(nombre)"
                                               class="btn-action btn-accept"
                                               title="Crear repuesto en inventario y luego aceptar">
                                                <i class="fas fa-plus"></i>
                                                <span>Crear repuesto</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <form method="post" action="/Admin/AceptarSolicitudRepuesto"
                                                  style="display:inline"
                                                  onsubmit="return confirmar(this, 'aceptar')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="solicitudId" value="@s.Id" />
                                                <button type="submit" class="btn-action btn-accept">
                                                    <i class="fas fa-check"></i>
                                                    <span>Aceptar</span>
                                                </button>
                                            </form>
                                        }

                                        <form method="post" action="/Admin/RechazarSolicitudRepuesto"
                                              style="display:inline"
                                              onsubmit="return confirmar(this, 'rechazar')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="solicitudId" value="@s.Id" />
                                            <button type="submit" class="btn-action btn-reject">
                                                <i class="fas fa-times"></i>
                                                <span>Rechazar</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="btn-action btn-disabled">
                                            <i class="fas fa-lock"></i>
                                            <span>Cerrada</span>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast"></div>

    <script>
        /* ── FILTRO TABS ── */
        function filtrar(tipo, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('#tabla-solicitudes tbody tr').forEach(tr => {
                const pendiente = tr.classList.contains('row-pendiente');
                const atendida  = tr.classList.contains('row-atendida');
                const libre     = tr.dataset.libre === 'true';

                let show = false;
                if      (tipo === 'todas')      show = true;
                else if (tipo === 'pendientes') show = pendiente;
                else if (tipo === 'atendidas')  show = atendida;
                else if (tipo === 'libre')      show = libre;

                tr.style.display = show ? '' : 'none';
            });
        }

        /* ── CONFIRMACIÓN ── */
        function confirmar(form, accion) {
            return confirm(`¿Seguro que deseas ${accion} esta solicitud?`);
        }

        /* ── TOAST desde TempData ── */
        @if (TempData["Mensaje"] != null)
        {
                <text>
                mostrarToast(@Html.Raw(Json.Serialize(TempData["Mensaje"])), 'success');
                </text>
        }
        @if (TempData["Error"] != null)
        {
                <text>
                mostrarToast(@Html.Raw(Json.Serialize(TempData["Error"])), 'error');
                </text>
        }

        function mostrarToast(msg, tipo) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className   = 'show ' + tipo;
            setTimeout(() => { t.className = ''; }, 4000);
        }
    </script>
</body>
</html>
