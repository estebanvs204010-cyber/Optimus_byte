@{
    ViewBag.Title = "Acerca de Nosotros - Optimus-Byte";
    Layout = null;
    var nombre = Context.Session.GetString("UsuarioNombre");
    bool logueado = !string.IsNullOrEmpty(nombre);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <nav class="ob-navbar">
        <button class="ob-hamburger" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <a class="ob-nav-logo" asp-controller="Home" asp-action="Index">
            <img src="~/img/putin.png" alt="Optimus-Byte" />
        </a>



        <div class="ob-nav-acciones">
            @if (!logueado)
            {
                <a class="ob-btn-ingresar"
                   href="/Login/Index?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">
                    Ingresar
                </a>
                <a class="ob-btn-registro" asp-controller="Registro" asp-action="Index">
                    Registrarse
                </a>
            }
            else
            {
                @await Html.PartialAsync("_MenuUsuarioPartial")
            }
        </div>
    </nav>

    <!-- ══ SIDEBAR ══ -->
    <aside class="ob-sidebar" id="obSidebar">
        <div class="ob-sidebar-title">Optimus-Byte</div>
        <a asp-controller="Home" asp-action="Index">
            <i class="fas fa-house"></i> Inicio
        </a>
        <a asp-controller="Inventario" asp-action="Index">
            <i class="fas fa-boxes-stacked"></i> Inventario
        </a>
        <a asp-controller="Servicios" asp-action="Index">
            <i class="fas fa-screwdriver-wrench"></i> Servicios
        </a>
        <a asp-controller="Citas" asp-action="Index">
            <i class="fas fa-calendar-check"></i> Citas
        </a>
        <a asp-controller="Home" asp-action="AcercaDe">
            <i class="fas fa-circle-info"></i> Acerca de
        </a>
    </aside>

    <div class="ob-overlay" id="obOverlay" onclick="closeSidebar()"></div>

    <section style="
        position:relative;
        min-height:100vh;
        background-image:url('/img/acercadee.jpg');
        background-size:cover;
        background-position:center;
        background-repeat:no-repeat;
        display:flex;
        align-items:center;">
        <!-- Capa oscura -->
        <div style="
            position:absolute;
            inset:0;
            background:rgba(0,0,0,.45);">
        </div>
        <!-- Contenido -->
        <div style="
            position:relative;
            z-index:2;
            max-width:700px;
            padding:0 6vw;
            color:white;">
            <h1 style="
                font-family:'Barlow Condensed',sans-serif;
                font-size:4.5rem;
                font-weight:900;
                margin-bottom:25px;">
                ¿Quiénes Somos?
            </h1>
            <p style="
                font-family:'Barlow',sans-serif;
                font-size:1.25rem;
                line-height:1.8;
                margin-bottom:20px;">
                Somos un taller mecánico especializado en el diagnóstico,
                mantenimiento y reparación de vehículos. Nos enfocamos en
                brindar soluciones confiables para motores, transmisiones,
                sistemas de frenos, suspensión, dirección y demás componentes
                mecánicos que garantizan el correcto funcionamiento de su automóvil.
            </p>
            <p style="
                font-family:'Barlow',sans-serif;
                font-size:1.25rem;
                line-height:1.8;">
                Nuestra misión es ofrecer un servicio mecánico de excelencia
                que permita a nuestros clientes conducir con seguridad,
                tranquilidad y la confianza de que su vehículo está en las
                mejores manos.
            </p>
        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar del home
        function toggleSidebar() {
            document.getElementById('obSidebar').classList.toggle('activa');
            document.getElementById('obOverlay').classList.toggle('activa');
        }
        function closeSidebar() {
            document.getElementById('obSidebar').classList.remove('activa');
            document.getElementById('obOverlay').classList.remove('activa');
        }
        // Dropdown usuario
                       function toggleMenu(btn) {
            const menu = document.getElementById('menuUsuario');
            menu.classList.toggle('abierto');
            document.addEventListener('click', function cerrar(e) {
                if (!btn.contains(e.target) && !menu.contains(e.target)) {
                    menu.classList.remove('abierto');
                    document.removeEventListener('click', cerrar);
                }
            });
        }
    </script>
</body>
</html>