<!-- Modal para Agendar Cita -->
<div id="modalAgendamiento" class="modal">
    <div class="modal-content">
        <span class="close" onclick="cerrarModal('modalAgendamiento')">&times;</span>
        <h2>📅 Agendar Cita</h2>
        <form id="formAgendamiento">
            <div class="form-group">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" name="nombre" required>
            </div>
            <div class="form-group">
                <label for="telefono">Teléfono:</label>
                <input type="tel" id="telefono" name="telefono" required>
            </div>
            <div class="form-group">
                <label for="servicio">Servicio Requerido:</label>
                <select id="servicio" name="servicio" required>
                    <option>Selecciona un servicio</option>
                    <option>Diagnóstico Computarizado</option>
                    <option>Mantenimiento Preventivo</option>
                    <option>Servicios Eléctricos</option>
                    <option>Reparaciones Mecánicas</option>
                    <option>Inspecciones Técnicas</option>
                    <option>Alineación y Balanceo</option>
                </select>
            </div>
            <div class="form-group">
                <label for="fechaDeseada">Fecha Deseada:</label>
                <input type="date" id="fechaDeseada" name="fechaDeseada" required>
            </div>
            <button type="submit" class="btn-primary">Agendar Cita</button>
        </form>
    </div>
</div>

<!-- Modal para Solicitar Cotización -->
<div id="modalCotizacion" class="modal">
    <div class="modal-content">
        <span class="close" onclick="cerrarModal('modalCotizacion')">&times;</span>
        <h2>📧 Solicitar Cotización</h2>
        <form id="formCotizacion">
            <div class="form-group">
                <label for="nombreCot">Nombre:</label>
                <input type="text" id="nombreCot" name="nombre" required>
            </div>
            <div class="form-group">
                <label for="emailCot">Correo Electrónico:</label>
                <input type="email" id="emailCot" name="email" required>
            </div>
            <div class="form-group">
                <label for="telefonoCot">Teléfono:</label>
                <input type="tel" id="telefonoCot" name="telefono" required>
            </div>
            <div class="form-group">
                <label for="descripcion">Descripción del Trabajo:</label>
                <textarea id="descripcion" name="descripcion" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn-primary">Solicitar Cotización</button>
        </form>
    </div>
</div>

<script>
    function abrirAgendamiento() {
        document.getElementById('modalAgendamiento').style.display = 'block';
    }

    function abrirCotizacion() {
        document.getElementById('modalCotizacion').style.display = 'block';
    }

    function abrirFormulario(tipo) {
        if (tipo === 'promo1') {
            abrirCotizacion();
        }
    }

    function cerrarModal(idModal) {
        document.getElementById(idModal).style.display = 'none';
    }

    function mostrarDetalles() {
        alert('Bienvenido al programa de Clientes Frecuentes. Acumula puntos en cada servicio y canjéalos por descuentos especiales.');
    }

    function llamarTaller() {
        window.location.href = 'tel:+573185004530';
    }

    function toggleFaq(element) {
        element.classList.toggle('open');
        const toggle = element.querySelector('.faq-toggle');
        toggle.textContent = element.classList.contains('open') ? '−' : '+';
    }

    window.onclick = function (event) {
        let modales = document.querySelectorAll('.modal');
        modales.forEach(function (modal) {
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        const formAgendamiento = document.getElementById('formAgendamiento');
        if (formAgendamiento) {
            formAgendamiento.addEventListener('submit', function (e) {
                e.preventDefault();
                alert('¡Cita agendada exitosamente! Nos pondremos en contacto pronto.');
                formAgendamiento.reset();
                cerrarModal('modalAgendamiento');
            });
        }

        const formCotizacion = document.getElementById('formCotizacion');
        if (formCotizacion) {
            formCotizacion.addEventListener('submit', function (e) {
                e.preventDefault();
                alert('¡Cotización solicitada! Responderemos en 24 horas.');
                formCotizacion.reset();
                cerrarModal('modalCotizacion');
            });
        }

        const inputFecha = document.getElementById('fechaDeseada');
        if (inputFecha) {
            const hoy = new Date();
            hoy.setDate(hoy.getDate() + 1);
            const minDate = hoy.toISOString().split('T')[0];
            inputFecha.min = minDate;
        }
    });
</script>

