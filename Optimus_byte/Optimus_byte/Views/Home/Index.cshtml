@{
    Layout = null;
    ViewData["Title"] = "Inicio";
    var nombre = ViewBag.UsuarioNombre as string;
    var rol = ViewBag.UsuarioRol as string;
    bool logueado = !string.IsNullOrEmpty(nombre);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VistaPrincipal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header class="barra-superior">
        <button class="boton-menu" onclick="mostrarMenu()">☰</button>

        <a class="logo-proyecto" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo-optimus-byte.png" alt="Optimus-Byte" class="logo-img" />
        </a>

        <div class="nav-acciones">
            @if (!logueado)
            {
                <a class="boton-ingresar" asp-controller="Login" asp-action="Index">
                    Ingresar
                </a>

                <a class="boton-registro" asp-controller="Registro" asp-action="Index">
                    Registrarse
                </a>
            }
            else
            {
                <div class="dropdown">
                    <button class="boton-usuario dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        @nombre
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end menu-usuario">
                        <li>
                            <a class="dropdown-item" asp-controller="Perfil" asp-action="Index">
                                Editar perfil
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item" asp-controller="Facturas" asp-action="Index">
                                Facturas
                            </a>
                        </li>

                        <li><hr class="dropdown-divider" /></li>

                        <li>
                            <form asp-controller="Home" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </header>


    <aside class="barra-lateral" id="barraLateral">
        <h2>Optimus-Byte</h2>

        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <a asp-controller="Inventario" asp-action="Index">Inventario</a>
        <a asp-controller="Servicios" asp-action="Index">Servicios</a>
        <a asp-controller="Citas" asp-action="Index">Citas</a>
        <a asp-controller="Home" asp-action="Sobre">Acerca de</a>
    </aside>

    <main class="container contenido-principal" id="contenidoPrincipal">

        <!-- HERO PRINCIPAL -->

        <section class="hero-principal">

            <div class="hero-texto animate-fade-up">

                <span class="hero-etiqueta">
                    Taller Inteligente
                </span>

                @if (logueado)
                {
                    <h1>
                        Bienvenido,
                        <em>@nombre</em>
                    </h1>

                    <p>
                        Gestiona tu taller mecánico, controla servicios,
                        citas y repuestos desde una sola plataforma.
                    </p>
                }
                else
                {
                    <h1>
                        Cuidamos tu vehículo con
                        <em>tecnología y confianza</em>
                    </h1>

                    <p>
                        Diagnóstico, mantenimiento y reparación
                        para vehículos modernos con atención profesional.
                    </p>
                }

                <div class="hero-botones">

                    <a asp-controller="Citas"
                       asp-action="Index"
                       class="boton-primario">
                        Agendar cita
                    </a>

                    <a asp-controller="Servicios"
                       asp-action="Index"
                       class="btn-elegante">
                        Ver servicios
                    </a>

                </div>

            </div>

            <div class="hero-imagen animate-fade-in">

                <img src="~/img/imagehome.jpg"
                     alt="Vehículo">

            </div>

        </section>


        <!-- SERVICIOS -->

        <section class="servicios-home">

            <div class="seccion-modulo">
                <h3>Mantenimiento</h3>

                <p>
                    Cambio de aceite, filtros,
                    alineación y revisión general.
                </p>

                <a asp-controller="Servicios"
                   asp-action="Index">
                    Ver más
                </a>
            </div>

            <div class="seccion-modulo">
                <h3>Diagnóstico</h3>

                <p>
                    Escaneo electrónico y detección
                    de fallas automotrices.
                </p>

                <a asp-controller="Servicios"
                   asp-action="Index">
                    Ver más
                </a>
            </div>

            <div class="seccion-modulo">
                <h3>Reparaciones</h3>

                <p>
                    Frenos, suspensión, motor
                    y reparación especializada.
                </p>

                <a asp-controller="Servicios"
                   asp-action="Index">
                    Ver más
                </a>
            </div>

        </section>


        <!-- ESTADÍSTICAS -->

        <section class="estadisticas">

            <div>
                <h2>+500</h2>
                <p>Vehículos atendidos</p>
            </div>

            <div>
                <h2>98%</h2>
                <p>Clientes satisfechos</p>
            </div>

            <div>
                <h2>24/7</h2>
                <p>Soporte y gestión</p>
            </div>

        </section>


        <!-- REPUESTOS -->

        <section class="seccion-repuestos">

            <h2>Repuestos destacados</h2>

            <p>
                Productos y componentes de alta calidad
                para tu vehículo.
            </p>

            <div class="contenedor-repuestos">

                <a class="caja-repuesto"
                   asp-controller="Inventario"
                   asp-action="Detalles"
                   asp-route-id="1">

                    <h3>Aceite de motor</h3>

                    <p>
                        Lubricante premium para
                        mantenimiento preventivo.
                    </p>

                    <span>Ver detalles</span>

                </a>

                <a class="caja-repuesto"
                   asp-controller="Inventario"
                   asp-action="Detalles"
                   asp-route-id="2">

                    <h3>Filtro de aire</h3>

                    <p>
                        Mantiene limpio el sistema
                        de admisión del motor.
                    </p>

                    <span>Ver detalles</span>

                </a>

                <a class="caja-repuesto"
                   asp-controller="Inventario"
                   asp-action="Detalles"
                   asp-route-id="3">

                    <h3>Pastillas de freno</h3>

                    <p>
                        Seguridad y rendimiento
                        para frenado preciso.
                    </p>

                    <span>Ver detalles</span>

                </a>

                <a class="caja-repuesto"
                   asp-controller="Inventario"
                   asp-action="Detalles"
                   asp-route-id="4">

                    <h3>Batería</h3>

                    <p>
                        Energía confiable para
                        vehículos modernos.
                    </p>

                    <span>Ver detalles</span>

                </a>

            </div>

            <a class="boton-catalogo"
               asp-controller="Inventario"
               asp-action="Index">

                Ver catálogo

            </a>

        </section>


        <!-- CTA FINAL -->

        <section class="cta-final">

            <div class="cta-contenido">

                <h2>
                    Agenda tu cita hoy mismo
                </h2>

                <p>
                    Nuestro equipo está listo para
                    ayudarte con el mantenimiento
                    de tu vehículo.
                </p>

                <a asp-controller="Citas"
                   asp-action="Index"
                   class="boton-primario">

                    Solicitar cita

                </a>

            </div>

        </section>

    </main>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>
