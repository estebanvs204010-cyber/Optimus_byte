@{
    ViewData["Title"] = "Editar Vehículo";
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Cliente";
    var inicial = nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "C";
    var v = ViewBag.Vehiculo;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Editar Vehículo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/Portal.css" rel="stylesheet" />
    <style>
        .form-wrap {
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            padding: 36px;
            box-shadow: 0 2px 12px rgba(37,99,235,0.06);
            max-width: 680px;
            margin: 0 auto 32px;
        }

        .form-label-custom {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }

        .input-custom {
            width: 100%;
            padding: 9px 14px;
            font-size: 0.88rem;
            border: 1px solid var(--borde-input);
            border-radius: 2px;
            background: var(--grafito-med);
            color: var(--texto-claro);
            outline: none;
            transition: var(--transicion);
        }

            .input-custom:focus {
                border-color: var(--dorado);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(37,99,235,0.07);
            }

        .btn-guardar {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #fff;
            background: var(--dorado);
            border: none;
            padding: 10px 28px;
            border-radius: 2px;
            cursor: pointer;
            transition: var(--transicion);
        }

            .btn-guardar:hover {
                opacity: 0.85;
            }

        .btn-volver {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--dorado);
            text-decoration: none;
            border: 1px solid var(--borde-input);
            padding: 9px 16px;
            border-radius: 2px;
            transition: var(--transicion);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-volver:hover {
                background: var(--dorado-suave);
                color: var(--dorado);
            }

        .field-group {
            margin-bottom: 20px;
        }

        .danger-zone {
            border: 1px solid rgba(220,38,38,0.25);
            border-radius: 4px;
            padding: 24px;
            max-width: 680px;
            margin: 0 auto 32px;
        }

        .danger-title {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #b91c1c;
            font-weight: 700;
            margin-bottom: 16px;
        }

        .danger-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid rgba(220,38,38,0.1);
        }

            .danger-row:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .d-label {
            font-size: 0.83rem;
            font-weight: 600;
            color: var(--texto-claro);
            margin: 0;
        }

        .d-desc {
            font-size: 0.75rem;
            color: var(--texto-suave);
            margin-top: 2px;
        }

        .btn-desactivar {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #b45309;
            background: rgba(245,158,11,0.08);
            border: 1px solid rgba(245,158,11,0.3);
            padding: 8px 16px;
            border-radius: 2px;
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-eliminar {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #b91c1c;
            background: rgba(220,38,38,0.07);
            border: 1px solid rgba(220,38,38,0.25);
            padding: 8px 16px;
            border-radius: 2px;
            cursor: pointer;
            white-space: nowrap;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: 4px;
            padding: 32px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        }

        .modal-icon {
            font-size: 2.2rem;
            margin-bottom: 12px;
        }

        .modal-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--marfil);
            margin-bottom: 8px;
        }

        .modal-desc {
            font-size: 0.83rem;
            color: var(--texto-suave);
            margin-bottom: 24px;
        }

        .modal-actions {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }

        .btn-modal-cancel {
            font-size: 0.75rem;
            padding: 8px 18px;
            border: 1px solid var(--borde-input);
            border-radius: 2px;
            background: transparent;
            color: var(--texto-suave);
            cursor: pointer;
        }

        .btn-modal-confirm {
            font-size: 0.75rem;
            padding: 8px 18px;
            border: none;
            border-radius: 2px;
            cursor: pointer;
            font-weight: 600;
        }

        .confirm-desactivar {
            background: rgba(245,158,11,0.15);
            color: #b45309;
        }

        .confirm-eliminar {
            background: #b91c1c;
            color: #fff;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-rol">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="user-name"><i class="bi bi-person-circle me-1"></i>@nombre</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="page">
        <div class="welcome-bar">
            <div class="avatar">@inicial</div>
            <div class="welcome-txt">
                <h2>Editar Vehículo</h2>
                <p>Modifica los datos del vehículo <strong>@v.Placa</strong>.</p>
            </div>
        </div>

        <div class="form-wrap">
            <p style="font-family:var(--fuente-titulo);font-size:1.4rem;color:var(--marfil);margin-bottom:6px">Datos del vehículo</p>
            <p style="font-size:0.78rem;color:var(--texto-suave);margin-bottom:28px">Modifica los campos que necesites</p>

            <form action="/Cliente/EditarVehiculo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdVehiculo" value="@v.IdVehiculo" />
                <div class="row g-3">
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Placa *</label>
                        <input name="Placa" class="input-custom" value="@v.Placa" style="text-transform:uppercase" required />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Marca *</label>
                        <input name="Marca" class="input-custom" value="@v.Marca" required />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Modelo *</label>
                        <input name="Modelo" class="input-custom" value="@v.Modelo" required />
                    </div>
                    <div class="col-md-3 field-group">
                        <label class="form-label-custom">Año *</label>
                        <input name="Anio" type="number" class="input-custom" value="@v.Anio" min="1900" max="2100" required />
                    </div>
                    <div class="col-md-3 field-group">
                        <label class="form-label-custom">Color</label>
                        <input name="Color" class="input-custom" value="@v.Color" />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">VIN</label>
                        <input name="Vin" class="input-custom" value="@v.Vin" />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Km actuales *</label>
                        <input name="KmActuales" type="number" class="input-custom" value="@v.KmActuales" min="0" required />
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mt-4">
                    <button type="submit" class="btn-guardar"><i class="bi bi-check-lg me-2"></i>Guardar cambios</button>
                    <a href="/Cliente/MisVehiculos" class="btn-volver"><i class="bi bi-arrow-left"></i>Cancelar</a>
                </div>
            </form>
        </div>

        <div class="danger-zone">
            <p class="danger-title"><i class="bi bi-exclamation-triangle me-2"></i>Zona peligrosa</p>
            <div class="danger-row">
                <div>
                    <p class="d-label">Desactivar vehículo</p>
                    <p class="d-desc">El vehículo quedará inactivo pero sus datos se conservan.</p>
                </div>
                <button type="button" class="btn-desactivar" onclick="abrirModal('desactivar')">
                    <i class="bi bi-eye-slash me-1"></i>Desactivar
                </button>
            </div>
            <div class="danger-row">
                <div>
                    <p class="d-label">Eliminar definitivamente</p>
                    <p class="d-desc">Esta acción no se puede deshacer.</p>
                </div>
                <button type="button" class="btn-eliminar" onclick="abrirModal('eliminar')">
                    <i class="bi bi-trash3 me-1"></i>Eliminar
                </button>
            </div>
        </div>

        <form id="formDesactivar" action="/Cliente/DesactivarVehiculo" method="post" style="display:none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@v.IdVehiculo" />
        </form>
        <form id="formEliminar" action="/Cliente/EliminarVehiculo" method="post" style="display:none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@v.IdVehiculo" />
        </form>
    </div>

    <div class="modal-overlay" id="modalDesactivar">
        <div class="modal-box">
            <div class="modal-icon">👁️</div>
            <p class="modal-title">¿Desactivar vehículo?</p>
            <p class="modal-desc">El vehículo <strong>@v.Placa</strong> quedará inactivo.</p>
            <div class="modal-actions">
                <button class="btn-modal-cancel" onclick="cerrarModal('desactivar')">Cancelar</button>
                <button class="btn-modal-confirm confirm-desactivar" onclick="document.getElementById('formDesactivar').submit()">Sí, desactivar</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalEliminar">
        <div class="modal-box">
            <div class="modal-icon">🗑️</div>
            <p class="modal-title">¿Eliminar definitivamente?</p>
            <p class="modal-desc">Se borrarán todos los datos de <strong>@v.Placa</strong>. No se puede deshacer.</p>
            <div class="modal-actions">
                <button class="btn-modal-cancel" onclick="cerrarModal('eliminar')">Cancelar</button>
                <button class="btn-modal-confirm confirm-eliminar" onclick="document.getElementById('formEliminar').submit()">Sí, eliminar</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function abrirModal(t) { document.getElementById(t==='desactivar'?'modalDesactivar':'modalEliminar').classList.add('show'); }
        function cerrarModal(t) { document.getElementById(t==='desactivar'?'modalDesactivar':'modalEliminar').classList.remove('show'); }
    </script>
</body>
</html>