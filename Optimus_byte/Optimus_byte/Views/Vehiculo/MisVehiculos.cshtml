@{
    ViewData["Title"] = "Mis Vehículos";
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Cliente";
    var inicial = nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "C";
    var vehiculos = ViewBag.Vehiculos as List<dynamic> ?? new List<dynamic>();
    var mensajeError = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Mis Vehículos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/Portal.css" rel="stylesheet" />
    <style>
        .vehiculos-wrap {
            background: #ffffff;
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            padding: 28px;
            box-shadow: 0 2px 12px rgba(37,99,235,0.06);
            margin-bottom: 32px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-title {
            font-family: var(--fuente-titulo);
            font-size: 1.5rem;
            font-weight: 400;
            color: var(--marfil);
            margin: 0 0 4px;
        }

        .section-sub {
            font-size: 0.78rem;
            color: var(--texto-suave);
            margin: 0;
        }

        .btn-volver {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--dorado);
            text-decoration: none;
            border: 1px solid var(--borde-input);
            padding: 7px 16px;
            border-radius: 2px;
            transition: var(--transicion);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-volver:hover {
                background: var(--dorado-suave);
                color: var(--dorado);
            }

        .btn-agregar {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #fff;
            background: var(--dorado);
            text-decoration: none;
            border: 1px solid var(--dorado);
            padding: 7px 16px;
            border-radius: 2px;
            transition: var(--transicion);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-agregar:hover {
                opacity: 0.85;
                color: #fff;
            }

        .tabla-vehiculos {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

            .tabla-vehiculos thead tr {
                border-bottom: 2px solid var(--borde-input);
            }

            .tabla-vehiculos th {
                font-size: 0.68rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--texto-suave);
                padding: 10px 14px;
                font-weight: 600;
            }

            .tabla-vehiculos td {
                padding: 13px 14px;
                color: var(--texto-claro);
                border-bottom: 1px solid var(--grafito-claro);
                vertical-align: middle;
            }

            .tabla-vehiculos tbody tr:last-child td {
                border-bottom: none;
            }

            .tabla-vehiculos tbody tr:hover td {
                background: var(--grafito-med);
            }

        .placa-badge {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            background: var(--dorado-suave);
            color: var(--dorado);
            border: 1px solid var(--borde);
            padding: 3px 10px;
            border-radius: 2px;
        }

        .estado-activo {
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #15803d;
            background: rgba(22,163,74,0.08);
            border: 1px solid rgba(22,163,74,0.2);
            padding: 3px 10px;
            border-radius: 2px;
        }

        .vehiculos-vacio {
            text-align: center;
            padding: 56px 20px;
            color: var(--texto-suave);
        }

            .vehiculos-vacio i {
                font-size: 3.2rem;
                color: var(--borde);
                margin-bottom: 16px;
                display: block;
            }

        .buscar-wrap {
            position: relative;
            max-width: 280px;
            width: 280px;
        }

            .buscar-wrap i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--texto-suave);
                font-size: 0.85rem;
                pointer-events: none;
            }

        .input-buscar {
            width: 100%;
            padding: 7px 12px 7px 34px;
            font-size: 0.82rem;
            border: 1px solid var(--borde-input);
            border-radius: 2px;
            background: var(--grafito-med);
            color: var(--texto-claro);
            outline: none;
            transition: var(--transicion);
        }

            .input-buscar:focus {
                border-color: var(--dorado);
                background: #fff;
            }

        .btn-edit-sm {
            font-size: 0.72rem;
            color: var(--dorado);
            background: transparent;
            text-decoration: none;
            border: 1px solid var(--borde-input);
            padding: 5px 12px;
            border-radius: 2px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: var(--transicion);
            cursor: pointer;
        }

            .btn-edit-sm:hover {
                background: var(--dorado-suave);
                color: var(--dorado);
            }

        .alerta-ok {
            background: rgba(22,163,74,0.06);
            border: 1px solid rgba(22,163,74,0.2);
            border-left: 3px solid #16a34a;
            color: #15803d;
            padding: 13px 18px;
            border-radius: 2px;
            font-size: 0.83rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

        .modal-aviso-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 1100;
            align-items: center;
            justify-content: center;
        }

        .modal-aviso-caja {
            background: #fff;
            border-radius: 6px;
            padding: 34px 30px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 8px 40px rgba(0,0,0,0.2);
            text-align: center;
        }

        .modal-aviso-icono {
            font-size: 2.4rem;
            color: #dc2626;
            margin-bottom: 14px;
        }

        .modal-aviso-titulo {
            font-family: var(--fuente-titulo);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--marfil);
            margin-bottom: 8px;
        }

        .modal-aviso-texto {
            font-size: 0.86rem;
            color: var(--texto-suave);
            margin-bottom: 22px;
            line-height: 1.5;
        }

        .modal-aviso-btn {
            font-size: 0.78rem;
            padding: 9px 26px;
            border: none;
            border-radius: 2px;
            background: var(--dorado);
            color: #fff;
            cursor: pointer;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

            .modal-aviso-btn:hover {
                opacity: 0.88;
            }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-rol">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="user-name"><i class="bi bi-person-circle me-1"></i>@nombre</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="page">
        <div class="welcome-bar">
            <div class="avatar">@inicial</div>
            <div class="welcome-txt">
                <h2>Mis Vehículos</h2>
                <p>Consulta y gestiona los vehículos registrados a tu nombre.</p>
            </div>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }

        <div class="vehiculos-wrap">
            <div class="section-header">
                <div>
                    <p class="section-title">Vehículos registrados</p>
                    <p class="section-sub">@((vehiculos as IEnumerable<dynamic>)?.Count() ?? 0) vehículo(s) encontrado(s)</p>
                </div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div>
                        <input type="text" id="buscarInput" name="q" class="input-buscar"
                               placeholder="Buscar placa, marca…" oninput="filtrarTabla()"
                               autocomplete="off" readonly
                               onfocus="this.removeAttribute('readonly')" />
                    </div>
                    <a href="/Cliente/AgregarVehiculo" class="btn-agregar">
                        <i class="bi bi-plus-lg"></i>Agregar
                    </a>
                    <a href="/Cliente/Portal" class="btn-volver">
                        <i class="bi bi-arrow-left"></i>Volver
                    </a>
                </div>
            </div>

            @{
                var lista = ViewBag.Vehiculos as IEnumerable<dynamic>;
                bool hayVehiculos = lista != null && lista.Any();
            }

            @if (!hayVehiculos)
            {
                <div class="vehiculos-vacio">
                    <i class="bi bi-car-front"></i>
                    <p>No tienes vehículos registrados aún.</p>
                    <a href="/Cliente/AgregarVehiculo" class="btn-agregar mt-3">
                        <i class="bi bi-plus-lg"></i>Agregar vehículo
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="tabla-vehiculos" id="tablaVehiculos">
                        <thead>
                            <tr>
                                <th>Placa</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Año</th>
                                <th>Color</th>
                                <th>VIN</th>
                                <th>Km actuales</th>
                                <th>Estado</th>
                                <th>Registro</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in lista!)
                            {
                                <tr class="fila-vehiculo"
                                    data-placa="@(((string)v.Placa).ToLower())"
                                    data-marca="@(((string)v.Marca).ToLower())"
                                    data-modelo="@(((string)v.Modelo).ToLower())">
                                    <td><span class="placa-badge">@v.Placa</span></td>
                                    <td>@v.Marca</td>
                                    <td>@v.Modelo</td>
                                    <td>@v.Anio</td>
                                    <td>@(string.IsNullOrWhiteSpace((string)v.Color) ? "—" : v.Color)</td>
                                    <td style="font-size:0.78rem">@(string.IsNullOrWhiteSpace((string)v.Vin) ? "—" : v.Vin)</td>
                                    <td>@v.KmActuales.ToString("N0") km</td>
                                    <td><span class="estado-activo"><i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>Activo</span></td>
                                    <td style="font-size:0.78rem;color:var(--texto-suave)">@(((DateTime)v.FechaRegistro).ToString("dd/MM/yyyy"))</td>
                                    <td>
                                        <button type="button" class="btn-edit-sm" onclick="abrirVerificacion(@v.IdVehiculo)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="info-section">
            <p class="info-title">Información del Taller</p>
            <p class="info-sub">Contáctanos si necesitas agendar o tienes alguna duda</p>
            <div class="info-grid">
                <div class="info-item"><i class="bi bi-telephone-fill"></i><div class="info-item-txt"><strong>Teléfono</strong><span>+57 318 509 4530</span></div></div>
                <div class="info-item"><i class="bi bi-envelope-fill"></i><div class="info-item-txt"><strong>Correo</strong><span>louisfonsea070&#64;gmail.com</span></div></div>
                <div class="info-item"><i class="bi bi-clock-fill"></i><div class="info-item-txt"><strong>Horario</strong><span>Lun – Sáb · 8:00 am – 6:00 pm</span></div></div>
                <div class="info-item"><i class="bi bi-geo-alt-fill"></i><div class="info-item-txt"><strong>Ubicación</strong><span>Colombia</span></div></div>
            </div>
        </div>
    </div>

    <!-- Modal verificación -->
    <div id="modalVerifEditar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:4px;padding:32px;max-width:400px;width:90%;box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div style="font-size:1.8rem;margin-bottom:10px">🔐</div>
            <p style="font-family:var(--fuente-titulo);font-size:1rem;font-weight:700;color:var(--marfil);margin-bottom:6px">Verificación de identidad</p>
            <p style="font-size:0.83rem;color:var(--texto-suave);margin-bottom:18px">Ingresa tu contraseña para editar este vehículo.</p>

            <input type="password" id="passEditarMis" placeholder="Tu contraseña..."
                   style="width:100%;padding:9px 14px;font-size:0.88rem;border:1px solid var(--borde-input);border-radius:2px;outline:none;box-sizing:border-box"
                   onkeydown="if(event.key==='Enter') confirmarVerifEditar()" />

            <p id="errorPassEditarMis" style="display:none;font-size:0.75rem;color:#b91c1c;margin-top:6px">
                <i class="bi bi-exclamation-circle me-1"></i>Contraseña incorrecta
            </p>

            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:18px">
                <button onclick="cerrarVerificacion()"
                        style="font-size:0.75rem;padding:8px 18px;border:1px solid var(--borde-input);border-radius:2px;background:transparent;color:var(--texto-suave);cursor:pointer">
                    Cancelar
                </button>
                <button id="btnConfirmarEditar" onclick="confirmarVerifEditar()"
                        style="font-size:0.75rem;padding:8px 18px;border:none;border-radius:2px;background:var(--dorado);color:#fff;cursor:pointer;font-weight:600">
                    <i class="bi bi-check-lg me-1"></i>Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- Modal de aviso (errores, ej. eliminación bloqueada) -->
    <div id="modalAvisoVehiculo" class="modal-aviso-overlay">
        <div class="modal-aviso-caja">
            <div class="modal-aviso-icono"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <p class="modal-aviso-titulo">No se pudo completar la acción</p>
            <p class="modal-aviso-texto" id="modalAvisoTexto"></p>
            <button class="modal-aviso-btn" onclick="cerrarModalAviso()">Entendido</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filtrarTabla() {
            const buscar = document.getElementById('buscarInput').value.toLowerCase();
            document.querySelectorAll('.fila-vehiculo').forEach(f => {
                const ok = !buscar || f.dataset.placa.includes(buscar) ||
                    f.dataset.marca.includes(buscar) || f.dataset.modelo.includes(buscar);
                f.style.display = ok ? '' : 'none';
            });
        }

        let vehiculoIdPendiente = null;

        function abrirVerificacion(id) {
            vehiculoIdPendiente = id;
            document.getElementById('passEditarMis').value = '';
            document.getElementById('errorPassEditarMis').style.display = 'none';
            document.getElementById('btnConfirmarEditar').disabled = false;
            document.getElementById('btnConfirmarEditar').innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirmar';
            document.getElementById('modalVerifEditar').style.display = 'flex';
            setTimeout(() => document.getElementById('passEditarMis').focus(), 100);
        }

        function cerrarVerificacion() {
            document.getElementById('modalVerifEditar').style.display = 'none';
            vehiculoIdPendiente = null;
        }

        async function confirmarVerifEditar() {
            const pass = document.getElementById('passEditarMis').value.trim();
            const error = document.getElementById('errorPassEditarMis');
            const btn = document.getElementById('btnConfirmarEditar');

            if (!pass) return;

            btn.disabled = true;
            btn.textContent = 'Verificando...';
            error.style.display = 'none';

            try {
                const resp = await fetch('/Cliente/VerificarContrasena', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contrasena: pass })
                });
                const data = await resp.json();

                if (data.ok) {
                    window.location.href = `/Cliente/EditarVehiculo/${vehiculoIdPendiente}`;
                } else {
                    error.style.display = 'block';
                    document.getElementById('passEditarMis').value = '';
                    document.getElementById('passEditarMis').focus();
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirmar';
                }
            } catch {
                error.textContent = 'Error de conexión. Intenta de nuevo.';
                error.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirmar';
            }
        }

        function cerrarModalAviso() {
            document.getElementById('modalAvisoVehiculo').style.display = 'none';
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                    document.getElementById('modalAvisoTexto').textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensajeError));
                    document.getElementById('modalAvisoVehiculo').style.display = 'flex';
                });
                </text>
        }
    </script>
</body>
</html>
