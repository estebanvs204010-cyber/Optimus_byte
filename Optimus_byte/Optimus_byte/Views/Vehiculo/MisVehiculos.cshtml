@{
    ViewData["Title"] = "Mis Vehículos";
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Cliente";
    var vehiculos = ViewBag.Vehiculos as List<dynamic> ?? new List<dynamic>();
    var mensajeError = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OPTIMUS-BYTE — Mis Vehículos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
    <style>
        /* ── Buscador ── */
        .buscar-wrap {
            position: relative;
            width: 240px;
        }

            .buscar-wrap i {
                position: absolute;
                left: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--texto-suave);
                font-size: 0.85rem;
                pointer-events: none;
            }

        .input-buscar {
            width: 100%;
            padding: 8px 12px 8px 32px;
            font-size: 0.82rem;
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            background: #fff;
            color: var(--texto);
            outline: none;
            font-family: inherit;
            transition: border-color .2s;
        }

            .input-buscar:focus {
                border-color: var(--dorado);
            }

        /* ── Placa badge en tabla ── */
        .placa-badge-v {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            background: var(--dorado-suave);
            color: var(--dorado);
            border: 1px solid var(--borde);
            padding: 3px 10px;
            border-radius: 4px;
        }

        .estado-activo-v {
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #15803d;
            background: rgba(22,163,74,0.08);
            border: 1px solid rgba(22,163,74,0.2);
            padding: 3px 10px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* ── Vacío ── */
        .vehiculos-vacio {
            text-align: center;
            padding: 60px 20px;
            color: var(--texto-suave);
        }

            .vehiculos-vacio i {
                font-size: 3rem;
                display: block;
                margin-bottom: 12px;
                opacity: .3;
            }

            .vehiculos-vacio p {
                font-size: 0.88rem;
            }

        /* ── Cards de vehículos ── */
        .vehiculos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }

        .vehiculo-card {
            background: #f8faff;
            border: 1px solid var(--borde-input);
            border-radius: 10px;
            overflow: hidden;
            transition: box-shadow .2s, border-color .2s;
        }

            .vehiculo-card:hover {
                box-shadow: 0 4px 20px rgba(37,99,235,.10);
                border-color: rgba(37,99,235,.25);
            }

        .vehiculo-card-header {
            background: var(--dorado-suave);
            border-bottom: 1px solid var(--borde);
            padding: 14px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .vehiculo-card-body {
            padding: 14px 16px;
        }

        .vehiculo-field {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--borde-input);
        }

            .vehiculo-field:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }

            .vehiculo-field span:first-child {
                color: var(--texto-suave);
                font-size: 0.72rem;
                letter-spacing: 0.05em;
                text-transform: uppercase;
            }

            .vehiculo-field span:last-child {
                color: var(--texto);
                font-weight: 500;
            }

        .vehiculo-card-footer {
            padding: 12px 16px;
            border-top: 1px solid var(--borde-input);
            display: flex;
            justify-content: flex-end;
        }

        .btn-edit-sm {
            font-size: 0.72rem;
            color: var(--dorado);
            background: transparent;
            text-decoration: none;
            border: 1px solid var(--borde-input);
            padding: 6px 14px;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: var(--transicion);
            cursor: pointer;
        }

            .btn-edit-sm:hover {
                background: var(--dorado-suave);
                color: var(--dorado);
            }

        /* ── Vista toggle ── */
        .vista-toggle {
            display: flex;
            gap: 4px;
        }

        .vista-btn {
            padding: 7px 14px;
            border: 1px solid var(--borde-input);
            background: transparent;
            color: var(--texto-suave);
            border-radius: 4px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: var(--transicion);
            display: flex;
            align-items: center;
        }

        .modal-aviso-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 1100;
            align-items: center;
            justify-content: center;
        }

            .vista-btn.active {
                background: var(--dorado-suave);
                color: var(--dorado);
                border-color: var(--dorado);
            }

        /* ── Stats ── */
        .bg-blue-soft {
            background: rgba(37,99,235,.08);
        }

        .bg-green-soft {
            background: rgba(22,163,74,.08);
        }

        .modal-aviso-caja {
            background: #fff;
            border-radius: 6px;
            padding: 34px 30px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 8px 40px rgba(0,0,0,0.2);
            text-align: center;
        }

        .modal-aviso-icono {
            font-size: 2.4rem;
            color: #dc2626;
            margin-bottom: 14px;
        }

        .modal-aviso-titulo {
            font-family: var(--fuente-titulo);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--marfil);
            margin-bottom: 8px;
        }

        .modal-aviso-texto {
            font-size: 0.86rem;
            color: var(--texto-suave);
            margin-bottom: 22px;
            line-height: 1.5;
        }

        .modal-aviso-btn {
            font-size: 0.78rem;
            padding: 9px 26px;
            border: none;
            border-radius: 2px;
            background: var(--dorado);
            color: #fff;
            cursor: pointer;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

            .modal-aviso-btn:hover {
                opacity: 0.88;
            }
    </style>
</head>
<body>

    <!-- Topbar -->
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@nombre</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <!-- Sidebar -->
    @await Html.PartialAsync("~/Views/Shared/_ClienteSidebar.cshtml")

    <!-- Contenido -->
    <main class="admin-content">

        <div class="section-header">
            <div>
                <h1 class="section-title">Mis Vehículos</h1>
                <p class="section-sub">Vehículos registrados a tu nombre en el taller</p>
            </div>
            <a href="/Cliente/AgregarVehiculo" class="btn-nuevo">
                <i class="bi bi-plus-lg me-1"></i><span>Agregar vehículo</span>
            </a>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok mb-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon bg-blue-soft"><i class="bi bi-car-front-fill text-primary"></i></div>
                <div>
                    <p class="section-title">Vehículos registrados</p>
                    <p class="section-sub">@((vehiculos as IEnumerable<dynamic>)?.Count() ?? 0) vehículo(s) encontrado(s)</p>
                </div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div>
                        <input type="text" id="buscarInput" name="q" class="input-buscar"
                               placeholder="Buscar placa, marca…" oninput="filtrarTabla()"
                               autocomplete="off" readonly
                               onfocus="this.removeAttribute('readonly')" />
                    </div>
                    <a href="/Cliente/AgregarVehiculo" class="btn-agregar">
                        <i class="bi bi-plus-lg"></i>Agregar
                    </a>
                    <a href="/Cliente/Portal" class="btn-volver">
                        <i class="bi bi-arrow-left"></i>Volver
                    </a>
                </div>
            </div>

        <div class="panel-section">
            <div class="section-mini-header">
                <div>
                    <h2>Vehículos registrados</h2>
                    <p>@vehiculos.Count vehículo(s) en tu cuenta</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="buscar-wrap">
                        <i class="bi bi-search"></i>
                        <input type="text" id="buscarInput" class="input-buscar"
                               placeholder="Buscar placa, marca…"
                               oninput="filtrarVehiculos()"
                               autocomplete="off" />
                    </div>
                    <div class="vista-toggle">
                        <button class="vista-btn active" id="btnCards" onclick="cambiarVista('cards')">
                            <i class="bi bi-grid-3x3-gap"></i> Cards
                        </button>
                        <button class="vista-btn" id="btnTabla" onclick="cambiarVista('tabla')">
                            <i class="bi bi-table"></i> Tabla
                        </button>
                    </div>
                </div>
            </div>

            @if (!vehiculos.Any())
            {
                <div class="vehiculos-vacio">
                    <i class="bi bi-car-front"></i>
                    <p>No tienes vehículos registrados aún.</p>
                    <a href="/Cliente/AgregarVehiculo" class="btn-nuevo mt-3 d-inline-flex">
                        <i class="bi bi-plus-lg me-1"></i>Agregar vehículo
                    </a>
                </div>
            }
            else
            {
                <!-- Vista Cards -->
                <div class="vehiculos-grid" id="vistaCards">
                    @foreach (var v in vehiculos)
                    {
                        <article class="vehiculo-card fila-vehiculo"
                                 data-placa="@(((string)v.Placa).ToLower())"
                                 data-marca="@(((string)v.Marca).ToLower())"
                                 data-modelo="@(((string)v.Modelo).ToLower())">
                            <div class="vehiculo-card-header">
                                <span class="placa-badge-v">@v.Placa</span>
                                <span class="estado-activo-v">
                                    <i class="bi bi-circle-fill" style="font-size:.4rem"></i>Activo
                                </span>
                            </div>
                            <div class="vehiculo-card-body">
                                <div class="vehiculo-field">
                                    <span>Marca</span><span>@v.Marca</span>
                                </div>
                                <div class="vehiculo-field">
                                    <span>Modelo</span><span>@v.Modelo</span>
                                </div>
                                <div class="vehiculo-field">
                                    <span>Año</span><span>@v.Anio</span>
                                </div>
                                <div class="vehiculo-field">
                                    <span>Color</span>
                                    <span>@(string.IsNullOrWhiteSpace((string)v.Color) ? "—" : v.Color)</span>
                                </div>
                                <div class="vehiculo-field">
                                    <span>Km actuales</span>
                                    <span>@v.KmActuales.ToString("N0") km</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace((string)v.Vin))
                                {
                                    <div class="vehiculo-field">
                                        <span>VIN</span><span style="font-size:.72rem">@v.Vin</span>
                                    </div>
                                }
                                <div class="vehiculo-field">
                                    <span>Registro</span>
                                    <span>@(((DateTime)v.FechaRegistro).ToString("dd/MM/yyyy"))</span>
                                </div>
                            </div>
                            <div class="vehiculo-card-footer">
                                <button type="button" class="btn-edit-sm"
                                        onclick="abrirVerificacion(@v.IdVehiculo)">
                                    <i class="bi bi-pencil"></i> Editar
                                </button>
                            </div>
                        </article>
                    }
                </div>

                <!-- Vista Tabla -->
                <div class="tabla-wrapper d-none" id="vistaTabla">
                    <table class="tabla-usuarios">
                        <thead>
                            <tr>
                                <th>Placa</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Año</th>
                                <th>Color</th>
                                <th>VIN</th>
                                <th>Km actuales</th>
                                <th>Estado</th>
                                <th>Registro</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in vehiculos)
                            {
                                <tr class="fila-vehiculo"
                                    data-placa="@(((string)v.Placa).ToLower())"
                                    data-marca="@(((string)v.Marca).ToLower())"
                                    data-modelo="@(((string)v.Modelo).ToLower())">
                                    <td><span class="placa-badge-v">@v.Placa</span></td>
                                    <td>@v.Marca</td>
                                    <td>@v.Modelo</td>
                                    <td>@v.Anio</td>
                                    <td>@(string.IsNullOrWhiteSpace((string)v.Color) ? "—" : v.Color)</td>
                                    <td style="font-size:0.78rem">@(string.IsNullOrWhiteSpace((string)v.Vin) ? "—" : v.Vin)</td>
                                    <td>@v.KmActuales.ToString("N0") km</td>
                                    <td>
                                        <span class="estado-activo-v">
                                            <i class="bi bi-circle-fill" style="font-size:.4rem"></i>Activo
                                        </span>
                                    </td>
                                    <td style="font-size:0.78rem;color:var(--texto-suave)">
                                        @(((DateTime)v.FechaRegistro).ToString("dd/MM/yyyy"))
                                    </td>
                                    <td>
                                        <button type="button" class="btn-edit-sm"
                                                onclick="abrirVerificacion(@v.IdVehiculo)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

        <div class="info-section">
            <p class="info-title">Información del Taller</p>
            <p class="info-sub">Contáctanos si necesitas agendar o tienes alguna duda</p>
            <div class="info-grid">
                <div class="info-item"><i class="bi bi-telephone-fill"></i><div class="info-item-txt"><strong>Teléfono</strong><span>+57 318 509 4530</span></div></div>
                <div class="info-item"><i class="bi bi-envelope-fill"></i><div class="info-item-txt"><strong>Correo</strong><span>louisfonsea070&#64;gmail.com</span></div></div>
                <div class="info-item"><i class="bi bi-clock-fill"></i><div class="info-item-txt"><strong>Horario</strong><span>Lun – Sáb · 8:00 am – 6:00 pm</span></div></div>
                <div class="info-item"><i class="bi bi-geo-alt-fill"></i><div class="info-item-txt"><strong>Ubicación</strong><span>Colombia</span></div></div>
            </div>
        </div>
    </div>

    <!-- Modal verificación -->
    <div id="modalVerifEditar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:4px;padding:32px;max-width:400px;width:90%;box-shadow:0 8px 40px rgba(0,0,0,0.18);">
            <div style="font-size:1.8rem;margin-bottom:10px">🔐</div>
            <p style="font-family:var(--fuente-titulo);font-size:1rem;font-weight:700;color:var(--marfil);margin-bottom:6px">Verificación de identidad</p>
            <p style="font-size:0.83rem;color:var(--texto-suave);margin-bottom:18px">Ingresa tu contraseña para editar este vehículo.</p>

            <input type="password" id="passEditarMis" placeholder="Tu contraseña..."
                   style="width:100%;padding:9px 14px;font-size:0.88rem;border:1px solid var(--borde-input);border-radius:2px;outline:none;box-sizing:border-box"
                   onkeydown="if(event.key==='Enter') confirmarVerifEditar()" />

            <p id="errorPassEditarMis" style="display:none;font-size:0.75rem;color:#b91c1c;margin-top:6px">
                <i class="bi bi-exclamation-circle me-1"></i>Contraseña incorrecta
            </p>

            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:18px">
                <button onclick="cerrarVerificacion()"
                        style="font-size:0.75rem;padding:8px 18px;border:1px solid var(--borde-input);border-radius:2px;background:transparent;color:var(--texto-suave);cursor:pointer">
                    Cancelar
                </button>
                <button id="btnConfirmarEditar" onclick="confirmarVerifEditar()"
                        style="font-size:0.75rem;padding:8px 18px;border:none;border-radius:2px;background:var(--dorado);color:#fff;cursor:pointer;font-weight:600">
                    <i class="bi bi-check-lg me-1"></i>Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- Modal de aviso (errores, ej. eliminación bloqueada) -->
    <div id="modalAvisoVehiculo" class="modal-aviso-overlay">
        <div class="modal-aviso-caja">
            <div class="modal-aviso-icono"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <p class="modal-aviso-titulo">No se pudo completar la acción</p>
            <p class="modal-aviso-texto" id="modalAvisoTexto"></p>
            <button class="modal-aviso-btn" onclick="cerrarModalAviso()">Entendido</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Cambiar vista ─────────────────────────────────────────
        function cambiarVista(modo) {
            const esCards = modo === 'cards';
            document.getElementById('vistaCards').classList.toggle('d-none', !esCards);
            document.getElementById('vistaTabla').classList.toggle('d-none', esCards);
            document.getElementById('btnCards').classList.toggle('active', esCards);
            document.getElementById('btnTabla').classList.toggle('active', !esCards);
        }

        // ── Filtrar ────────────────────────────────────────────────
        function filtrarVehiculos() {
            const q = document.getElementById('buscarInput').value.toLowerCase();
            document.querySelectorAll('.fila-vehiculo').forEach(f => {
                const ok = !q || f.dataset.placa.includes(q) ||
                    f.dataset.marca.includes(q) || f.dataset.modelo.includes(q);
                f.style.display = ok ? '' : 'none';
            });
        }

        // ── Modal verificación ─────────────────────────────────────
        let vehiculoIdPendiente = null;
        let modalVerif = null;

        function abrirVerificacion(id) {
            vehiculoIdPendiente = id;
            document.getElementById('passEditarMis').value = '';
            document.getElementById('errorPassEditarMis').style.display = 'none';
            const btn = document.getElementById('btnConfirmarEditar');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-lg"></i><span>Confirmar</span>';
            modalVerif = new bootstrap.Modal(document.getElementById('modalVerifEditar'));
            modalVerif.show();
            setTimeout(() => document.getElementById('passEditarMis').focus(), 300);
        }

        async function confirmarVerifEditar() {
            const pass  = document.getElementById('passEditarMis').value.trim();
            const error = document.getElementById('errorPassEditarMis');
            const btn   = document.getElementById('btnConfirmarEditar');
            if (!pass) return;

            btn.disabled = true;
            btn.innerHTML = '<span>Verificando…</span>';
            error.style.display = 'none';

            try {
                const resp = await fetch('/Cliente/VerificarContrasena', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contrasena: pass })
                });
                const data = await resp.json();

                if (data.ok) {
                    window.location.href = `/Cliente/EditarVehiculo/${vehiculoIdPendiente}`;
                } else {
                    error.style.display = 'block';
                    document.getElementById('passEditarMis').value = '';
                    document.getElementById('passEditarMis').focus();
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-lg"></i><span>Confirmar</span>';
                }
            } catch {
                error.textContent = 'Error de conexión. Intenta de nuevo.';
                error.style.display = 'block';
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg"></i><span>Confirmar</span>';
            }
        }

        function cerrarModalAviso() {
            document.getElementById('modalAvisoVehiculo').style.display = 'none';
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
                <text>
                document.addEventListener('DOMContentLoaded', function () {
                    document.getElementById('modalAvisoTexto').textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensajeError));
                    document.getElementById('modalAvisoVehiculo').style.display = 'flex';
                });
                </text>
        }
    </script>
</body>
</html>
