@{
    ViewData["Title"] = "Agregar Vehículo";
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Cliente";
    var inicial = nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "C";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Agregar Vehículo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/Portal.css" rel="stylesheet" />
    <style>
        .form-wrap {
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            padding: 36px;
            box-shadow: 0 2px 12px rgba(37,99,235,0.06);
            max-width: 680px;
            margin: 0 auto 32px;
        }

        .form-label-custom {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }

        .input-custom {
            width: 100%;
            padding: 9px 14px;
            font-size: 0.88rem;
            border: 1px solid var(--borde-input);
            border-radius: 2px;
            background: var(--grafito-med);
            color: var(--texto-claro);
            outline: none;
            transition: var(--transicion);
        }

            .input-custom:focus {
                border-color: var(--dorado);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(37,99,235,0.07);
            }

        .btn-guardar {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #fff;
            background: var(--dorado);
            border: none;
            padding: 10px 28px;
            border-radius: 2px;
            cursor: pointer;
            transition: var(--transicion);
        }

            .btn-guardar:hover {
                opacity: 0.85;
            }

        .btn-volver {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--dorado);
            text-decoration: none;
            border: 1px solid var(--borde-input);
            padding: 9px 16px;
            border-radius: 2px;
            transition: var(--transicion);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-volver:hover {
                background: var(--dorado-suave);
                color: var(--dorado);
            }

        .form-title {
            font-family: var(--fuente-titulo);
            font-size: 1.4rem;
            font-weight: 400;
            color: var(--marfil);
            margin-bottom: 6px;
        }

        .form-sub {
            font-size: 0.78rem;
            color: var(--texto-suave);
            margin-bottom: 28px;
        }

        .field-group {
            margin-bottom: 20px;
        }

        .alerta-err {
            background: rgba(220,38,38,0.07);
            border: 1px solid rgba(220,38,38,0.2);
            border-left: 3px solid #dc2626;
            color: #b91c1c;
            padding: 12px 16px;
            border-radius: 2px;
            font-size: 0.83rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-rol">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="user-name"><i class="bi bi-person-circle me-1"></i>@nombre</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
    </div>

    <div class="page">
        <div class="welcome-bar">
            <div class="avatar">@inicial</div>
            <div class="welcome-txt">
                <h2>Agregar Vehículo</h2>
                <p>Registra un nuevo vehículo a tu nombre en el taller.</p>
            </div>
        </div>

        <div class="form-wrap">
            <p class="form-title">Datos del vehículo</p>
            <p class="form-sub">Los campos marcados con * son obligatorios</p>

            @if (TempData["Error"] != null)
            {
                <div class="alerta-err"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]</div>
            }

            <form action="/Cliente/AgregarVehiculo" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Placa *</label>
                        <input name="Placa" class="input-custom" placeholder="Ej: ABC123" style="text-transform:uppercase" required />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Marca *</label>
                        <input name="Marca" class="input-custom" placeholder="Ej: Toyota" required />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Modelo *</label>
                        <input name="Modelo" class="input-custom" placeholder="Ej: Corolla" required />
                    </div>
                    <div class="col-md-3 field-group">
                        <label class="form-label-custom">Año *</label>
                        <input name="Anio" type="number" class="input-custom" placeholder="Ej: 2020" min="1900" max="2100" required />
                    </div>
                    <div class="col-md-3 field-group">
                        <label class="form-label-custom">Color</label>
                        <input name="Color" class="input-custom" placeholder="Ej: Blanco" />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">VIN</label>
                        <input name="Vin" class="input-custom" placeholder="Número de chasis (opcional)" />
                    </div>
                    <div class="col-md-6 field-group">
                        <label class="form-label-custom">Km actuales *</label>
                        <input name="KmActuales" type="number" class="input-custom" placeholder="Ej: 45000" min="0" required />
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mt-4">
                    <button type="submit" class="btn-guardar"><i class="bi bi-check-lg me-2"></i>Guardar vehículo</button>
                    <a href="/Cliente/MisVehiculos" class="btn-volver"><i class="bi bi-arrow-left"></i>Cancelar</a>
                </div>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>