@model Optimus_byte.Models.ViewModels.MecanicoDashboardViewModel
@{
    ViewData["Title"] = "Panel de Mecanico";
    Layout = null;
    var inicial = Model.NombreMecanico.Length > 0 ? Model.NombreMecanico[0].ToString().ToUpper() : "M";
    string[] estadosDisponibles = { "Pendiente", "En proceso", "Esperando repuesto", "Listo para entrega", "Entregado", "Cancelado" };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OPTIMUS-BYTE - Panel de Mecanico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <style>
        /* ── Modales ── */
        .modal-mecanico .modal-content {
            background: #1e2235;
            border: 1px solid rgba(255,255,255,0.10);
            border-radius: 16px;
            color: #e2e8f0;
        }

        .modal-mecanico .modal-header {
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 1.25rem 1.5rem;
        }

        .modal-mecanico .modal-title {
            font-size: .85rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            font-weight: 700;
            color: #e2e8f0;
        }

        .modal-mecanico .modal-body {
            padding: 1.5rem;
        }

        .modal-mecanico .modal-footer {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 1rem 1.5rem;
        }

        .modal-mecanico label {
            color: #94a3b8;
        }

        .modal-mecanico .modal-label {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #94a3b8;
            display: block;
            margin-bottom: .4rem;
        }

        .modal-mecanico .modal-input {
            width: 100%;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            color: #e2e8f0;
            padding: .55rem .85rem;
            font-size: .88rem;
            outline: none;
            transition: border-color .15s;
        }

            .modal-mecanico .modal-input:focus {
                border-color: #3b82f6;
            }

        .modal-mecanico textarea.modal-input {
            resize: vertical;
        }

        /* ── Botones accion cards ── */
        .card-actions {
            display: flex;
            gap: .5rem;
            margin-top: .85rem;
            flex-wrap: wrap;
        }

            .card-actions .btn-accion {
                width: auto !important;
                height: auto !important;
                font-size: .68rem !important;
                letter-spacing: .06em !important;
                text-transform: uppercase !important;
                font-weight: 600 !important;
                padding: .38rem .9rem !important;
                border-radius: 8px !important;
                border: none !important;
                cursor: pointer !important;
                display: inline-flex !important;
                align-items: center !important;
                gap: .3rem !important;
                white-space: nowrap !important;
                transition: opacity .15s !important;
            }

                .card-actions .btn-accion:hover {
                    opacity: .82 !important;
                }

        .btn-estado {
            background: #2563eb;
            color: #fff;
        }

        .btn-tiempo {
            background: #7c3aed;
            color: #fff;
        }

        .btn-repuesto {
            background: rgba(249,115,22,.15);
            color: #c2410c;
            border: 1px solid rgba(249,115,22,.35) !important;
        }

        /* ── Estado options ── */
        .estado-option {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: .55rem .85rem;
            border-radius: 10px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: border-color .15s, background .15s;
            margin-bottom: .4rem;
            color: #e2e8f0;
        }

            .estado-option:hover {
                background: rgba(255,255,255,.05);
            }

            .estado-option input[type=radio] {
                accent-color: #2563eb;
                width: 1rem;
                height: 1rem;
            }

            .estado-option.selected {
                border-color: #2563eb;
                background: rgba(37,99,235,.15);
            }

        .dot-estado {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ── Tiempo estimado toggle ── */
        .tiempo-toggle {
            display: flex;
            gap: .5rem;
            margin-bottom: 1rem;
        }

            .tiempo-toggle button {
                flex: 1;
                padding: .45rem;
                border-radius: 8px;
                border: 2px solid rgba(255,255,255,.12);
                background: transparent;
                color: #94a3b8;
                font-size: .75rem;
                font-weight: 600;
                letter-spacing: .06em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all .15s;
            }

                .tiempo-toggle button.active {
                    border-color: #7c3aed;
                    background: rgba(124,58,237,.15);
                    color: #a78bfa;
                }

        /* ── Cuenta regresiva en card ── */
        .countdown-pill {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: rgba(124,58,237,.13);
            border: 1px solid rgba(124,58,237,.3);
            border-radius: 20px;
            padding: .28rem .75rem;
            font-size: .72rem;
            font-weight: 600;
            color: #a78bfa;
            margin-top: .5rem;
        }

            .countdown-pill.urgente {
                background: rgba(239,68,68,.13);
                border-color: rgba(239,68,68,.3);
                color: #f87171;
            }

            .countdown-pill.ok {
                background: rgba(34,197,94,.1);
                border-color: rgba(34,197,94,.25);
                color: #4ade80;
            }

        /* ── Info repuesto en modal ── */
        .rep-info-box {
            background: rgba(255,255,255,.05);
            border-radius: 8px;
            padding: .75rem;
            margin-bottom: .85rem;
            font-size: .78rem;
        }

        .rep-info-grid {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .rep-info-val {
            color: #e2e8f0;
            font-weight: 700;
        }

        .rep-info-lbl {
            color: #94a3b8;
            font-size: .7rem;
            display: block;
        }

        /* ── Divisor del modal repuesto ── */
        .rep-divisor {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin: .85rem 0;
            color: #475569;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

            .rep-divisor::before,
            .rep-divisor::after {
                content: '';
                flex: 1;
                height: 1px;
                background: rgba(255,255,255,.1);
            }

        /* ── Secciones mecanico ── */
        .mecanico-content {
        }

        .mechanic-hero {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            margin-bottom: 1.5rem;
        }

        .mechanic-avatar {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: var(--dorado-suave);
            border: 2px solid var(--borde);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--dorado);
            flex-shrink: 0;
        }

        .mechanic-stats {
            margin-bottom: 1.5rem;
        }

        .panel-section {
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .section-mini-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 1.2rem;
        }

            .section-mini-header h2 {
                font-size: 1rem;
                margin: 0 0 .2rem;
                font-weight: 600;
            }

            .section-mini-header p {
                font-size: .78rem;
                color: var(--texto-suave);
                margin: 0;
            }

            .section-mini-header.compact {
                margin-bottom: .9rem;
            }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        @@media (max-width: 900px) {
            .two-column {
                grid-template-columns: 1fr;
            }
        }

        .agenda-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1rem;
        }

        .appointment-card {
            background: #f8faff;
            border: 1px solid var(--borde-input);
            border-radius: 10px;
            display: flex;
            overflow: visible;
        }

        .appointment-time {
            background: var(--dorado-suave);
            border-right: 1px solid var(--borde);
            padding: 1rem .75rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: 64px;
            border-radius: 10px 0 0 10px;
            font-size: .72rem;
            color: var(--dorado);
            text-align: center;
            gap: .2rem;
        }

            .appointment-time strong {
                font-size: .85rem;
            }

        .appointment-body {
            padding: .9rem 1rem;
            flex: 1;
            overflow: visible;
        }

            .appointment-body h3 {
                font-size: .92rem;
                margin: 0 0 .3rem;
                font-weight: 700;
            }

        .vehicle-line, .client-line, .service-line {
            font-size: .78rem;
            color: var(--texto-suave);
            margin: 0 0 .25rem;
        }

        .estimate-pill {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            font-size: .7rem;
            background: var(--dorado-suave);
            color: var(--dorado);
            border-radius: 20px;
            padding: .2rem .65rem;
            margin-top: .4rem;
        }

        .mechanic-table {
            margin-top: 1rem;
        }

        /* historial / timeline */
        .timeline-list {
            display: flex;
            flex-direction: column;
            gap: .85rem;
        }

        .timeline-item {
            border-left: 2px solid var(--borde);
            padding-left: 1rem;
            font-size: .82rem;
        }

        .timeline-date {
            font-size: .7rem;
            color: var(--texto-suave);
        }

        .timeline-item h3 {
            font-size: .88rem;
            margin: .2rem 0;
        }

        .timeline-item p {
            margin: 0 0 .2rem;
            color: var(--texto-suave);
        }

        .parts-line {
            font-size: .75rem;
            color: var(--dorado);
        }

        /* checklists */
        .checklist-box {
            margin-bottom: 1rem;
        }

        .checklist-title {
            display: flex;
            justify-content: space-between;
            font-size: .82rem;
            margin-bottom: .5rem;
        }

        .check-row {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .82rem;
            margin-bottom: .3rem;
            cursor: pointer;
        }

        .slim-progress {
            height: 4px;
            border-radius: 2px;
            background: var(--grafito-med);
            margin-top: .5rem;
        }

        /* evidencias */
        .mechanic-form {
            display: flex;
            flex-direction: column;
            gap: .65rem;
        }

        .form-grid-small {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .65rem;
        }

        .textarea-custom {
            width: 100%;
            background: #fff;
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            padding: .55rem .85rem;
            font-size: .85rem;
            font-family: inherit;
            outline: none;
            resize: vertical;
            transition: border-color .15s;
        }

            .textarea-custom:focus {
                border-color: var(--dorado);
            }

        .file-custom {
            font-size: .82rem;
        }

        .evidence-list {
            margin-top: .85rem;
            display: flex;
            flex-direction: column;
            gap: .6rem;
        }

        .evidence-item {
            display: flex;
            gap: .75rem;
            font-size: .82rem;
            align-items: flex-start;
        }

            .evidence-item i {
                font-size: 1.3rem;
                color: var(--dorado);
                margin-top: .1rem;
            }

            .evidence-item p {
                margin: 0;
                color: var(--texto-suave);
                font-size: .75rem;
            }

        /* mensajes */
        .message-list {
            display: flex;
            flex-direction: column;
            gap: .65rem;
            margin-bottom: .75rem;
        }

        .message-item {
            font-size: .82rem;
            border-bottom: 1px solid var(--borde-input);
            padding-bottom: .65rem;
        }

            .message-item div {
                display: flex;
                justify-content: space-between;
                margin-bottom: .2rem;
            }

        .message-priority {
            font-size: .68rem;
            padding: 2px 8px;
            border-radius: 10px;
            background: var(--dorado-suave);
            color: var(--dorado);
        }

        .message-item p {
            margin: 0 0 .2rem;
            color: var(--texto-suave);
        }

        /* manuales */
        .manual-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px,1fr));
            gap: .75rem;
        }

        .manual-card {
            display: flex;
            flex-direction: column;
            gap: .3rem;
            background: var(--grafito-med);
            border: 1px solid var(--borde-input);
            border-radius: 8px;
            padding: .85rem;
            text-decoration: none;
            color: var(--texto-claro);
            font-size: .78rem;
            transition: border-color .15s;
        }

            .manual-card:hover {
                border-color: var(--dorado);
            }

            .manual-card i {
                font-size: 1.4rem;
                color: var(--dorado);
            }

            .manual-card span {
                font-size: .68rem;
                color: var(--texto-suave);
            }

        /* herramientas */
        .tool-list {
            display: flex;
            flex-direction: column;
            gap: .6rem;
        }

        .tool-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .82rem;
        }

            .tool-item div span {
                display: block;
                font-size: .72rem;
                color: var(--texto-suave);
            }

        /* tiempo real */
        .time-form {
            display: flex;
            gap: .65rem;
            flex-wrap: wrap;
            align-items: flex-end;
        }

            .time-form .input-custom {
                flex: 1;
                min-width: 140px;
            }

        .bg-blue-soft {
            background: rgba(37,99,235,.08);
        }

        .bg-green-soft {
            background: rgba(22,163,74,.08);
        }

        .bg-cyan-soft {
            background: rgba(6,182,212,.08);
        }

        .bg-red-soft {
            background: rgba(220,38,38,.08);
        }
    </style>
</head>
<body>
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">OPTIMUS-BYTE</span>
            <span class="badge-admin">Mecanico</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name"><i class="bi bi-person-circle me-1"></i>@Model.NombreMecanico</span>
            <a href="/Login/Logout" class="btn-salir"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn-nuevo">
            <i class="fas fa-eye"></i> Home 
        </a>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="#agenda" class="nav-link active"><i class="bi bi-calendar2-week"></i><span>Agenda</span></a>
            <a href="#historial" class="nav-link"><i class="bi bi-clock-history"></i><span>Historial</span></a>
            <a href="#checklists" class="nav-link"><i class="bi bi-ui-checks"></i><span>Checklists</span></a>
            <a href="#evidencias" class="nav-link"><i class="bi bi-camera-fill"></i><span>Evidencias</span></a>
            <a href="#mensajes" class="nav-link"><i class="bi bi-chat-dots-fill"></i><span>Chat</span></a>
            <a href="#manuales" class="nav-link"><i class="bi bi-journal-text"></i><span>Manuales</span></a>
            <a href="#herramientas" class="nav-link"><i class="bi bi-tools"></i><span>Herramientas</span></a>
        </nav>
    </div>

    <main class="admin-content mecanico-content">
        <section class="mechanic-hero">
            <div class="mechanic-avatar">@inicial</div>
            <div>
                <h1 class="section-title">Panel de Mecanico</h1>
                <p class="section-sub">Ordenes asignadas, tiempos, evidencias y soporte tecnico del taller</p>
            </div>
        </section>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div>
        }

        @* ── Stats ── *@
        <section class="stats-row mechanic-stats">
            <div class="stat-card">
                <div class="stat-icon bg-blue-soft"><i class="bi bi-calendar-check text-primary"></i></div>
                <div>
                    <div class="stat-num">@Model.CitasClientes.Count</div>
                    <div class="stat-label">Citas de clientes</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-green-soft"><i class="bi bi-check2-square text-success"></i></div>
                <div>
                    <div class="stat-num">@Model.Checklists.Count</div>
                    <div class="stat-label">Checklists activos</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-cyan-soft"><i class="bi bi-camera text-info"></i></div>
                <div>
                    <div class="stat-num">@Model.Evidencias.Count</div>
                    <div class="stat-label">Evidencias</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-red-soft"><i class="bi bi-exclamation-triangle text-danger"></i></div>
                <div>
                    <div class="stat-num">@Model.Herramientas.Count(h => h.Estado.Contains("revision", StringComparison.OrdinalIgnoreCase))</div>
                    <div class="stat-label">Herramientas por revisar</div>
                </div>
            </div>
        </section>

        <section class="panel-section">
            <div class="section-mini-header">
                <div>
                    <h2>Citas solicitadas por clientes</h2>
                    <p>Reservas que entran desde el botón de citas de la página principal.</p>
                </div>
            </div>

            <div class="tabla-wrapper mechanic-table">
                <table class="tabla-usuarios">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Vehículo</th>
                            <th>Servicio</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in Model.CitasClientes)
                        {
                            <tr>
                                <td>@cita.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>@cita.Cliente</td>
                                <td>@cita.Vehiculo - @cita.Placa</td>
                                <td>@cita.Servicio</td>
                                <td><span class="estado-badge estado-activo">@cita.Estado</span></td>
                            </tr>
                        }
                        @if (!Model.CitasClientes.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;padding:24px;color:var(--texto-suave)">
                                    Aún no hay citas solicitadas por clientes.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* ════════════════ AGENDA ════════════════ *@
        <section id="agenda" class="panel-section">
            <div class="section-mini-header">
                <div>
                    <h2>Agenda de citas asignadas</h2>
                    <p>Vista rapida por hora, cliente, vehiculo y servicio programado.</p>
                </div>
                <button type="button" class="btn-nuevo" onclick="alternarAgenda()">
                    <i class="bi bi-layout-three-columns me-2"></i><span>Cambiar vista</span>
                </button>
            </div>

            <div class="agenda-grid" id="agendaCards">
                @foreach (var cita in Model.CitasAsignadas)
                {
                    <article class="appointment-card">
                        <div class="appointment-time">
                            <span>@cita.FechaHora.ToString("dd MMM")</span>
                            <strong>@cita.FechaHora.ToString("hh:mm tt")</strong>
                        </div>
                        <div class="appointment-body">
                            <div class="d-flex justify-content-between gap-3">
                                <h3>OT-@cita.Id</h3>
                                <span class="estado-badge estado-activo">@cita.Estado</span>
                            </div>
                            <p class="vehicle-line">@cita.Vehiculo · @cita.Placa</p>
                            <p class="client-line"><i class="bi bi-person me-1"></i>@cita.Cliente</p>
                            <p class="service-line">@cita.Servicio</p>
                            @if (!string.IsNullOrWhiteSpace(cita.Diagnostico))
                            {
                                <p class="service-line" style="color:var(--texto-suave);font-size:.75rem;">
                                    <i class="bi bi-clipboard2-pulse me-1"></i>@cita.Diagnostico
                                </p>
                            }

                            @if (cita.FechaEntregaEstimada.HasValue)
                            {
                                <div class="countdown-pill">
                                    <i class="bi bi-clock"></i>
                                    <span data-entrega="@cita.FechaEntregaEstimada.Value.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        Calculando...
                                    </span>
                                </div>
                            }

                            <div class="card-actions">
                                <button type="button" class="btn-accion btn-estado"
                                        onclick="abrirModalEstado(@cita.Id, '@Html.Raw(cita.Estado)')">
                                    <i class="bi bi-arrow-repeat"></i> Cambiar estado
                                </button>
                                <button type="button" class="btn-accion btn-tiempo"
                                        onclick="abrirModalTiempo(@cita.Id)">
                                    <i class="bi bi-clock"></i> Tiempo estimado
                                </button>
                                <button type="button" class="btn-accion btn-repuesto"
                                        onclick="abrirModalRepuesto(@cita.Id, '@Html.Raw(cita.MarcaVehiculo)')">
                                    <i class="bi bi-box-seam"></i> Pedir repuesto
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="tabla-wrapper mechanic-table d-none" id="agendaTabla">
                <table class="tabla-usuarios">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Vehiculo</th>
                            <th>Servicio</th>
                            <th>Estado</th>
                            <th>Entrega estimada</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in Model.CitasAsignadas)
                        {
                            <tr>
                                <td>OT-@cita.Id</td>
                                <td>@cita.FechaHora.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>@cita.Cliente</td>
                                <td>@cita.Vehiculo - @cita.Placa</td>
                                <td>@cita.Servicio</td>
                                <td><span class="estado-badge estado-activo">@cita.Estado</span></td>
                                <td>
                                    @if (cita.FechaEntregaEstimada.HasValue)
                                    {
                                        <span data-entrega="@cita.FechaEntregaEstimada.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                                              style="font-size:.78rem;color:#7c3aed;font-weight:600">
                                            Calculando...
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size:.75rem;color:#94a3b8">Sin definir</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;gap:.4rem;flex-wrap:wrap">
                                        <button type="button" class="btn-accion btn-estado"
                                                onclick="abrirModalEstado(@cita.Id, '@Html.Raw(cita.Estado)')">
                                            <i class="bi bi-arrow-repeat"></i> Estado
                                        </button>
                                        <button type="button" class="btn-accion btn-tiempo"
                                                onclick="abrirModalTiempo(@cita.Id)">
                                            <i class="bi bi-clock"></i> Tiempo
                                        </button>
                                        {{!-- CAMBIO 1b: se pasa MarcaVehiculo al modal en la tabla --}}
                                        <button type="button" class="btn-accion btn-repuesto"
                                                onclick="abrirModalRepuesto(@cita.Id, '@Html.Raw(cita.MarcaVehiculo)')">
                                            <i class="bi bi-box-seam"></i> Repuesto
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* ════════════════ HISTORIAL + CHECKLISTS ════════════════ *@
        <section class="two-column">
            <div id="historial" class="panel-section">
                <div class="section-mini-header compact">
                    <div><h2>Historial de servicios</h2><p>Contexto tecnico del vehiculo antes de intervenir.</p></div>
                </div>
                <div class="timeline-list">
                    @foreach (var servicio in Model.HistorialServicios)
                    {
                        <article class="timeline-item">
                            <span class="timeline-date">@servicio.Fecha.ToString("dd/MM/yyyy")</span>
                            <h3>@servicio.Vehiculo</h3>
                            <p>@servicio.Diagnostico</p>
                            <div class="parts-line"><i class="bi bi-nut-fill"></i> @servicio.PartesReemplazadas</div>
                            <small>Tecnico anterior: @servicio.Tecnico</small>
                        </article>
                    }
                </div>
            </div>
            <div id="checklists" class="panel-section">
                <div class="section-mini-header compact">
                    <div><h2>Checklists digitales</h2><p>Marca pasos de inspeccion y mantenimiento.</p></div>
                </div>
                @foreach (var checklist in Model.Checklists)
                {
                    <article class="checklist-box">
                        <div class="checklist-title"><strong>@checklist.Nombre</strong><span>@checklist.Orden</span></div>
                        @foreach (var paso in checklist.Pasos)
                        {
                            <label class="check-row">
                                <input type="checkbox" onchange="actualizarProgreso(this)" />
                                <span>@paso</span>
                            </label>
                        }
                        <div class="progress slim-progress"><div class="progress-bar" style="width:0%"></div></div>
                    </article>
                }
            </div>
        </section>

        @* ════════════════ EVIDENCIAS + MENSAJES ════════════════ *@
        <section class="two-column">
            <div id="evidencias" class="panel-section">
                <div class="section-mini-header compact">
                    <div><h2>Carga de evidencias</h2><p>Fotos y notas del antes y despues de la reparacion.</p></div>
                </div>
                <form asp-controller="Mecanico" asp-action="CargarEvidencia" method="post" enctype="multipart/form-data" class="mechanic-form">
                    @Html.AntiForgeryToken()
                    <div class="form-grid-small">
                        <select name="orden" class="input-custom select-custom">
                            @foreach (var cita in Model.CitasAsignadas)
                            {
                                <option value="OT-@cita.Id">OT-@cita.Id - @cita.Placa</option>
                            }
                        </select>
                        <select name="tipo" class="input-custom select-custom">
                            <option>Antes</option>
                            <option>Durante</option>
                            <option>Despues</option>
                        </select>
                    </div>
                    <textarea name="nota" class="textarea-custom" rows="3" placeholder="Describe la evidencia o el estado del vehiculo"></textarea>
                    <input name="archivos" type="file" multiple class="file-custom" accept="image/*" />
                    <button type="submit" class="btn-guardar"><i class="bi bi-cloud-arrow-up me-2"></i><span>Subir evidencia</span></button>
                </form>
                <div class="evidence-list">
                    @foreach (var evidencia in Model.Evidencias)
                    {
                        <div class="evidence-item">
                            <i class="bi bi-image"></i>
                            <div>
                                <strong>@evidencia.Orden · @evidencia.Tipo</strong>
                                <p>@evidencia.Nota</p>
                                <small>@evidencia.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div id="mensajes" class="panel-section">
                <div class="section-mini-header compact">
                    <div><h2>Chat interno</h2><p>Comunicate con administracion o recepcion.</p></div>
                </div>
                <div class="message-list">
                    @foreach (var mensaje in Model.Mensajes)
                    {
                        <article class="message-item">
                            <div><strong>@mensaje.De</strong><span class="message-priority">@mensaje.Prioridad</span></div>
                            <p>@mensaje.Mensaje</p>
                            <small>@mensaje.FechaHora.ToString("hh:mm tt")</small>
                        </article>
                    }
                </div>
                <form asp-controller="Mecanico" asp-action="EnviarMensaje" method="post" class="mechanic-form mt-3">
                    @Html.AntiForgeryToken()
                    <select name="para" class="input-custom select-custom">
                        <option>Administrador</option>
                        <option>Recepcion</option>
                        <option>Inventario</option>
                    </select>
                    <textarea name="mensaje" class="textarea-custom" rows="3" placeholder="Escribe una consulta sobre la orden o repuestos"></textarea>
                    <button type="submit" class="btn-guardar"><i class="bi bi-send-fill me-2"></i><span>Enviar</span></button>
                </form>
            </div>
        </section>

        @* ════════════════ MANUALES + HERRAMIENTAS ════════════════ *@
        <section class="two-column">
            <div id="manuales" class="panel-section">
                <div class="section-mini-header compact">
                    <div><h2>Manuales y guias tecnicas</h2><p>Accesos rapidos para diagnostico y mantenimiento.</p></div>
                </div>
                <div class="manual-grid">
                    @foreach (var manual in Model.Manuales)
                    {
                        <a href="@manual.Url" class="manual-card" target="_blank">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>@manual.Categoria</span>
                            <strong>@manual.Titulo</strong>
                        </a>
                    }
                </div>
            </div>
            <div id="herramientas" class="panel-section">
                <div class="section-mini-header compact">
                    <div><h2>Gestion de herramientas</h2><p>Control de uso y alertas de mantenimiento.</p></div>
                </div>
                <div class="tool-list">
                    @foreach (var herramienta in Model.Herramientas)
                    {
                        var claseEstado = herramienta.Estado.Contains("revision", StringComparison.OrdinalIgnoreCase) ? "estado-inactivo" : "estado-activo";
                        <article class="tool-item">
                            <div>
                                <strong>@herramienta.Nombre</strong>
                                <span>@herramienta.Codigo · Ultimo uso: @herramienta.UltimoUso</span>
                            </div>
                            <span class="estado-badge @claseEstado">@herramienta.Estado</span>
                        </article>
                    }
                </div>
            </div>
        </section>

        @* ════════════════ TIEMPO REAL ════════════════ *@
        <section class="panel-section">
            <div class="section-mini-header compact">
                <div><h2>Tiempo real de reparacion</h2><p>Registra la duracion para medir productividad y planificar mejor.</p></div>
            </div>
            <form asp-controller="Mecanico" asp-action="RegistrarTiempo" method="post" class="time-form">
                @Html.AntiForgeryToken()
                <select name="ordenId" class="input-custom select-custom">
                    @foreach (var cita in Model.CitasAsignadas)
                    {
                        <option value="@cita.Id">OT-@cita.Id - @cita.Servicio</option>
                    }
                </select>
                <input name="minutos" type="number" min="1" class="input-custom" placeholder="Minutos usados" />
                <input name="observacion" class="input-custom" placeholder="Observacion del trabajo realizado" />
                <button type="submit" class="btn-guardar"><i class="bi bi-stopwatch-fill me-2"></i><span>Registrar tiempo</span></button>
            </form>
        </section>
    </main>

    @* ════════════════ MODAL: Cambiar estado ════════════════ *@
    <div class="modal fade modal-mecanico" id="modalEstado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-repeat me-2"></i>Cambiar estado · <span id="modalEstadoOT"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Mecanico" asp-action="CambiarEstado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" id="estadoOrdenId" />
                    <div class="modal-body">
                        <p class="modal-label" style="margin-bottom:1rem">Selecciona el nuevo estado</p>
                        @{
                            var coloresEstado = new Dictionary<string, string> {
                                                { "Pendiente",            "#f59e0b" },
                                                { "En proceso",           "#3b82f6" },
                                                { "Esperando repuesto",   "#ef4444" },
                                                { "Listo para entrega",   "#8b5cf6" },
                                                { "Entregado",            "#22c55e" },
                                                { "Cancelado",            "#6b7280" }
                                                };
                        }
                        @foreach (var est in estadosDisponibles)
                        {
                            var color = coloresEstado.ContainsKey(est) ? coloresEstado[est] : "#6b7280";
                            <label class="estado-option" onclick="seleccionarEstado(this)">
                                <input type="radio" name="nuevoEstado" value="@est" />
                                <span class="dot-estado" style="background:@color"></span>
                                <span>@est</span>
                            </label>
                        }
                        <div style="margin-top:1rem">
                            <label class="modal-label">Observacion (opcional)</label>
                            <textarea name="observacion" class="modal-input" rows="2"
                                      placeholder="Ej: esperando llegada de filtro de aceite..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-salir" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="bi bi-check-lg me-1"></i> Guardar estado</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ════════════════ MODAL: Tiempo estimado ════════════════ *@
    <div class="modal fade modal-mecanico" id="modalTiempo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clock me-2"></i>Tiempo estimado · <span id="modalTiempoOT"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Mecanico" asp-action="GuardarTiempoEstimado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" id="tiempoOrdenId" />
                    <div class="modal-body">
                        <p class="modal-label" style="margin-bottom:.75rem">¿Como quieres definir el tiempo?</p>
                        <div class="tiempo-toggle">
                            <button type="button" id="btnModoHoras" class="active" onclick="cambiarModoTiempo('horas')">
                                <i class="bi bi-hourglass-split me-1"></i> En horas
                            </button>
                            <button type="button" id="btnModoDias" onclick="cambiarModoTiempo('dias')">
                                <i class="bi bi-calendar3 me-1"></i> Por fecha
                            </button>
                        </div>

                        <div id="panelHoras">
                            <label class="modal-label">Cuantas horas aproximadamente</label>
                            <input type="number" id="inputHoras" name="horas" min="1" max="999"
                                   class="modal-input" placeholder="Ej: 3" style="margin-bottom:.5rem" />
                            <p style="font-size:.72rem;color:#64748b;margin:0">
                                Se calculara la fecha de entrega desde ahora.
                            </p>
                        </div>

                        <div id="panelFecha" style="display:none">
                            <label class="modal-label">Fecha y hora de entrega estimada</label>
                            <input type="datetime-local" id="inputFecha" name="fechaEntrega"
                                   class="modal-input" style="color-scheme:dark" />
                            <p style="font-size:.72rem;color:#64748b;margin-top:.4rem;margin-bottom:0">
                                El cliente vera una cuenta regresiva hasta esta fecha.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-salir" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="bi bi-floppy me-1"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ════════════════ MODAL: Pedir repuesto — inventario + texto libre ════════════════ *@
    <div class="modal fade modal-mecanico" id="modalRepuesto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-box-seam me-2"></i>Solicitar repuesto · <span id="modalRepuestoOT"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Mecanico" asp-action="SolicitarRepuesto" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" id="repOrdenId" />
                    <div class="modal-body">

                        @* ── OPCIÓN 1: Selector del inventario ── *@
                        <div style="margin-bottom:.6rem">
                            <label class="modal-label">
                                <i class="bi bi-archive me-1"></i>Buscar en inventario
                            </label>
                            <select name="repuestoId" id="selectRepuesto"
                                    class="modal-input" onchange="toggleCampoLibre(this)">
                                <option value="">— No está en inventario, lo escribo abajo —</option>
                                @* CAMBIO 2a: data-marca agregado a cada option *@
                                @foreach (var r in Model.RepuestosDisponibles)
                                {
                                    <option value="@r.IdRepuesto"
                                            data-stock="@r.StockActual"
                                            data-ref="@r.Referencia"
                                            data-cat="@r.Categoria"
                                            data-marca="@r.Marca">
                                        @r.Nombre (@r.Referencia) · Stock: @r.StockActual
                                    </option>
                                }
                            </select>
                            @* CAMBIO 2b: mensaje de sin resultados para la marca *@
                            <p id="sinRepuestosMsg" style="display:none;font-size:.75rem;
                               color:#f87171;margin-top:.4rem">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                No hay repuestos de esta marca en inventario. Usa el campo de abajo.
                            </p>
                        </div>

                        @* Info del repuesto seleccionado — aparece dinámicamente *@
                        <div id="repInfoBox" class="rep-info-box" style="display:none">
                            <div class="rep-info-grid">
                                <div><span class="rep-info-lbl">Referencia</span><span class="rep-info-val" id="repInfoRef">—</span></div>
                                <div><span class="rep-info-lbl">Categoría</span><span class="rep-info-val" id="repInfoCat">—</span></div>
                                <div><span class="rep-info-lbl">Stock disponible</span><span class="rep-info-val" id="repInfoStock">—</span></div>
                            </div>
                        </div>

                        @* ── Divisor ── *@
                        <div class="rep-divisor">o si no está en inventario</div>

                        @* ── OPCIÓN 2: Texto libre ── *@
                        <div id="campoNombreLibre" style="margin-bottom:.85rem">
                            <label class="modal-label">
                                <i class="bi bi-pencil me-1"></i>Escribe el nombre del repuesto
                                <span style="color:#ef4444" id="repLibreAsterisco">*</span>
                                <span id="repLibreHint" style="color:#64748b;font-size:.7rem;text-transform:none;letter-spacing:0">
                                    — no está en el inventario
                                </span>
                            </label>
                            <input type="text" name="nombreLibre" id="inputNombreLibre"
                                   class="modal-input"
                                   placeholder="Ej: Filtro de combustible Bosch 1457434310" />
                        </div>

                        @* ── Cantidad ── *@
                        <div style="margin-bottom:.85rem">
                            <label class="modal-label">Cantidad *</label>
                            <input type="number" name="cantidad" id="repCantidad"
                                   min="1" value="1" class="modal-input" required />
                        </div>

                        @* ── Motivo ── *@
                        <div>
                            <label class="modal-label">Motivo / especificacion tecnica</label>
                            <textarea name="motivo" rows="2" class="modal-input"
                                      placeholder="Ej: necesario para cambio de aceite en OT, llanta desgastada..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-salir" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-guardar">
                            <i class="bi bi-send me-1"></i> Enviar solicitud
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Agenda ────────────────────────────────────────────────
        function alternarAgenda() {
            document.getElementById('agendaCards').classList.toggle('d-none');
            document.getElementById('agendaTabla').classList.toggle('d-none');
        }

        // ── Checklists ────────────────────────────────────────────
        function actualizarProgreso(checkbox) {
            const box      = checkbox.closest('.checklist-box');
            const checks   = box.querySelectorAll('input[type="checkbox"]');
            const marcados = box.querySelectorAll('input[type="checkbox"]:checked');
            box.querySelector('.progress-bar').style.width =
                Math.round((marcados.length / checks.length) * 100) + '%';
        }

        // ── Modal estado ──────────────────────────────────────────
        function abrirModalEstado(ordenId, estadoActual) {
            document.getElementById('estadoOrdenId').value = ordenId;
            document.getElementById('modalEstadoOT').textContent = 'OT-' + ordenId;
            document.querySelectorAll('#modalEstado input[type=radio]').forEach(r => {
                const opt = r.closest('.estado-option');
                r.checked = (r.value === estadoActual);
                opt.classList.toggle('selected', r.checked);
            });
            new bootstrap.Modal(document.getElementById('modalEstado')).show();
        }

        function seleccionarEstado(label) {
            document.querySelectorAll('#modalEstado .estado-option').forEach(o => o.classList.remove('selected'));
            label.classList.add('selected');
            label.querySelector('input[type=radio]').checked = true;
        }

        // ── Modal tiempo estimado ─────────────────────────────────
        function abrirModalTiempo(ordenId) {
            document.getElementById('tiempoOrdenId').value = ordenId;
            document.getElementById('modalTiempoOT').textContent = 'OT-' + ordenId;
            const ahora = new Date();
            ahora.setMinutes(ahora.getMinutes() - ahora.getTimezoneOffset());
            document.getElementById('inputFecha').min = ahora.toISOString().slice(0, 16);
            document.getElementById('inputFecha').value = '';
            document.getElementById('inputHoras').value = '';
            cambiarModoTiempo('horas');
            new bootstrap.Modal(document.getElementById('modalTiempo')).show();
        }

        function cambiarModoTiempo(modo) {
            const esHoras = modo === 'horas';
            document.getElementById('panelHoras').style.display = esHoras ? '' : 'none';
            document.getElementById('panelFecha').style.display = esHoras ? 'none' : '';
            document.getElementById('btnModoHoras').classList.toggle('active', esHoras);
            document.getElementById('btnModoDias').classList.toggle('active', !esHoras);
            if (esHoras) document.getElementById('inputFecha').value = '';
            else         document.getElementById('inputHoras').value = '';
        }

        // ── Modal repuesto (CAMBIO 3) ─────────────────────────────
        // Guarda la marca del vehículo para filtrar el inventario
        let _marcaVehiculo = '';

        function abrirModalRepuesto(ordenId, marcaVehiculo) {
            _marcaVehiculo = (marcaVehiculo || '').trim().toLowerCase();

            document.getElementById('repOrdenId').value = ordenId;
            document.getElementById('modalRepuestoOT').textContent = 'OT-' + ordenId;

            // Resetear campos
            const select = document.getElementById('selectRepuesto');
            select.value = '';
            document.getElementById('inputNombreLibre').value = '';
            document.getElementById('repCantidad').value = 1;

            // Filtrar opciones por marca y mostrar/ocultar aviso
            filtrarRepuestosPorMarca(_marcaVehiculo);
            toggleCampoLibre(select);

            new bootstrap.Modal(document.getElementById('modalRepuesto')).show();
        }

        // Filtra las <option> del select según la marca del vehículo.
        // Si no hay ninguna coincidencia, muestra el mensaje de aviso.
        function filtrarRepuestosPorMarca(marca) {
            const select  = document.getElementById('selectRepuesto');
            const aviso   = document.getElementById('sinRepuestosMsg');
            const options = select.querySelectorAll('option[value]'); // excluye el placeholder

            let hayCoincidencia = false;

            options.forEach(opt => {
                const marcaOpt = (opt.dataset.marca || '').toLowerCase();
                // Mostrar siempre si no hay marca de vehículo, o si coincide
                const visible = !marca || marcaOpt === marca || marcaOpt === 'general';
                opt.style.display = visible ? '' : 'none';
                if (visible && opt.value !== '') hayCoincidencia = true;
            });

            // Mostrar aviso solo cuando hay marca pero ningún repuesto coincide
            aviso.style.display = (marca && !hayCoincidencia) ? '' : 'none';
        }

        // Muestra/oculta campo libre según si escogió del inventario
        function toggleCampoLibre(select) {
            const tieneInventario = select.value !== '';
            const campoLibre  = document.getElementById('campoNombreLibre');
            const inputLibre  = document.getElementById('inputNombreLibre');
            const infoBox     = document.getElementById('repInfoBox');
            const asterisco   = document.getElementById('repLibreAsterisco');
            const hint        = document.getElementById('repLibreHint');

            if (tieneInventario) {
                campoLibre.style.opacity  = '.45';
                inputLibre.required       = false;
                inputLibre.placeholder    = 'Opcional: agrega mas detalles si lo necesitas';
                asterisco.style.display   = 'none';
                hint.textContent          = '— opcional si ya escogiste del inventario';

                const opt = select.selectedOptions[0];
                document.getElementById('repInfoRef').textContent   = opt.dataset.ref   || '—';
                document.getElementById('repInfoCat').textContent   = opt.dataset.cat   || '—';
                document.getElementById('repInfoStock').textContent = opt.dataset.stock || '—';
                infoBox.style.display = '';
            } else {
                campoLibre.style.opacity  = '1';
                inputLibre.required       = true;
                inputLibre.placeholder    = 'Ej: Filtro de combustible Bosch 1457434310';
                asterisco.style.display   = '';
                hint.textContent          = '— no está en el inventario';
                infoBox.style.display     = 'none';
            }
        }

        // ── Cuentas regresivas ────────────────────────────────────
        function actualizarCuentas() {
            document.querySelectorAll('[data-entrega]').forEach(el => {
                const diff = new Date(el.dataset.entrega) - new Date();
                if (diff <= 0) {
                    el.textContent = 'Tiempo vencido';
                    el.closest('.countdown-pill').classList.add('urgente');
                    return;
                }
                const dias  = Math.floor(diff / 86400000);
                const horas = Math.floor((diff % 86400000) / 3600000);
                const mins  = Math.floor((diff % 3600000)  / 60000);

                el.textContent = dias  > 0 ? `${dias}d ${horas}h restantes`
                               : horas > 0 ? `${horas}h ${mins}m restantes`
                                           : `${mins} min restantes`;

                const pill = el.closest('.countdown-pill');
                if (diff < 3600000)       pill.classList.add('urgente');
                else if (diff > 86400000) pill.classList.add('ok');
            });
        }

        actualizarCuentas();
        setInterval(actualizarCuentas, 30000);
    </script>
</body>
</html>
