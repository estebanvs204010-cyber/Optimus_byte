@model Optimus_byte.Models.ViewModels.MecanicoDashboardViewModel
@{
    ViewData["Title"] = "Panel de Mecánico";
    Layout = null;
    var inicial = Model.NombreMecanico.Length > 0 ? Model.NombreMecanico[0].ToString().ToUpper() : "M";
    string[] estadosDisponibles = { "Pendiente", "En proceso", "Esperando repuesto", "Listo para entrega", "Entregado", "Cancelado" };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OPTIMUS-BYTE · Panel de Mecánico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/MisOrdenesMecanico.css" asp-append-version="true" />
</head>
<body>
    <div class="mec-layout">

        <!-- ══ TOPBAR ══ -->
        <header class="mec-topbar">
            <div class="d-flex align-items-center gap-2">
                <span class="mec-brand">⚙ OPTIMUS-BYTE</span>
                <span class="mec-badge">Mecánico</span>
            </div>
            <div class="mec-user">
                <strong><i class="bi bi-person-circle me-1"></i>@Model.NombreMecanico</strong>
                <a href="/Login/Logout" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i> Salir
                </a>
            </div>
        </header>

        <!-- ══ SIDEBAR ══ -->
        <aside class="mec-sidebar">
            <div class="mec-avatar-block">
                <div class="mec-avatar">@inicial</div>
                <div class="mec-avatar-name">@Model.NombreMecanico</div>
                <div class="mec-avatar-role">Mecánico</div>
            </div>

            <nav class="mec-nav">
                <button class="mec-nav-link active" onclick="irA('agenda', this)">
                    <i class="bi bi-calendar2-week"></i> Agenda
                    @if (Model.CitasAsignadas.Count > 0)
                    {
                        <span class="nav-badge">@Model.CitasAsignadas.Count</span>
                    }
                </button>
                <button class="mec-nav-link" onclick="irA('historial', this)">
                    <i class="bi bi-clock-history"></i> Historial
                </button>
                <button class="mec-nav-link" onclick="irA('checklists', this)">
                    <i class="bi bi-ui-checks"></i> Checklists
                    @if (Model.Checklists.Count > 0)
                    {
                        <span class="nav-badge">@Model.Checklists.Count</span>
                    }
                </button>
                <button class="mec-nav-link" onclick="irA('evidencias', this)">
                    <i class="bi bi-camera-fill"></i> Evidencias
                </button>
                <button class="mec-nav-link" onclick="irA('mensajes', this)">
                    <i class="bi bi-chat-dots-fill"></i> Chat
                    @if (Model.Mensajes.Count > 0)
                    {
                        <span class="nav-badge">@Model.Mensajes.Count</span>
                    }
                </button>
                <button class="mec-nav-link" onclick="irA('manuales', this)">
                    <i class="bi bi-journal-text"></i> Manuales
                </button>
                <button class="mec-nav-link" onclick="irA('herramientas', this)">
                    <i class="bi bi-tools"></i> Herramientas
                </button>
                <button class="mec-nav-link" onclick="irA('tiempo', this)">
                    <i class="bi bi-stopwatch-fill"></i> Tiempo
                </button>
            </nav>
        </aside>

        <!-- ══ MAIN ══ -->
        <main class="mec-main">

            @if (TempData["Exito"] != null)
            {
                <div class="alerta alerta-ok"><i class="bi bi-check-circle-fill"></i> @TempData["Exito"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alerta alerta-err"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div>
            }

            <!-- ════ AGENDA ════ -->
            <section id="agenda" class="mec-section visible">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-calendar2-week me-2" style="color:#c9a84c"></i>Agenda de citas</h1>
                        <p>Órdenes asignadas · tiempos · estados</p>
                    </div>
                    <div class="vista-toggle">
                        <button class="btn-vista active" id="btnCards" onclick="setVista('cards')">
                            <i class="bi bi-grid-3x3-gap"></i> Cards
                        </button>
                        <button class="btn-vista" id="btnTabla" onclick="setVista('tabla')">
                            <i class="bi bi-table"></i> Tabla
                        </button>
                    </div>
                </div>

                <!-- Stats -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(37,99,235,.1)">
                            <i class="bi bi-calendar-check" style="color:#2563eb"></i>
                        </div>
                        <div>
                            <div class="stat-num">@Model.CitasAsignadas.Count</div>
                            <div class="stat-label">Citas asignadas</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(34,197,94,.1)">
                            <i class="bi bi-check2-square" style="color:#16a34a"></i>
                        </div>
                        <div>
                            <div class="stat-num">@Model.Checklists.Count</div>
                            <div class="stat-label">Checklists activos</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(6,182,212,.1)">
                            <i class="bi bi-camera" style="color:#0891b2"></i>
                        </div>
                        <div>
                            <div class="stat-num">@Model.Evidencias.Count</div>
                            <div class="stat-label">Evidencias</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(239,68,68,.1)">
                            <i class="bi bi-exclamation-triangle" style="color:#dc2626"></i>
                        </div>
                        <div>
                            <div class="stat-num">@Model.Herramientas.Count(h => h.Estado.Contains("revision", StringComparison.OrdinalIgnoreCase))</div>
                            <div class="stat-label">Por revisar</div>
                        </div>
                    </div>
                </div>

                <!-- Vista Cards -->
                <div class="agenda-grid" id="vistaCards">
                    @foreach (var cita in Model.CitasAsignadas)
                    {
                        var chipClass = cita.Estado switch
                        {
                            "Pendiente" => "chip-pendiente",
                            "En proceso" => "chip-proceso",
                            "Esperando repuesto" => "chip-repuesto",
                            "Listo para entrega" => "chip-listo",
                            "Entregado" => "chip-entregado",
                            _ => "chip-cancelado"
                        };
                        <article class="apt-card apt-card-clickable"
                                 onclick="abrirDetalle(@cita.Id)"
                                 data-id="@cita.Id"
                                 data-vehiculo="@Html.Raw(cita.Vehiculo)"
                                 data-placa="@cita.Placa"
                                 data-cliente="@Html.Raw(cita.Cliente)"
                                 data-servicio="@Html.Raw(cita.Servicio)"
                                 data-estado="@cita.Estado"
                                 data-fecha="@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")"
                                 data-diagnostico="@Html.Raw(cita.Diagnostico ?? "")"
                                 data-entrega="@(cita.FechaEntregaEstimada.HasValue ? cita.FechaEntregaEstimada.Value.ToString("yyyy-MM-ddTHH:mm:ss") : "")"
                                 data-marca="@Html.Raw(cita.MarcaVehiculo)">
                            <div class="apt-time">
                                <span>@cita.FechaHora.ToString("dd MMM")</span>
                                <strong>@cita.FechaHora.ToString("hh:mm tt")</strong>
                            </div>
                            <div class="apt-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <h3>OT-@cita.Id</h3>
                                    <span class="estado-chip @chipClass">@cita.Estado</span>
                                </div>
                                <p class="apt-meta"><i class="bi bi-car-front me-1"></i>@cita.Vehiculo · @cita.Placa</p>
                                <p class="apt-meta"><i class="bi bi-person me-1"></i>@cita.Cliente</p>
                                <p class="apt-meta">@cita.Servicio</p>
                                @if (!string.IsNullOrWhiteSpace(cita.Diagnostico))
                                {
                                    <p class="apt-meta" style="font-style:italic">
                                        <i class="bi bi-clipboard2-pulse me-1"></i>@cita.Diagnostico
                                    </p>
                                }
                                @if (cita.FechaEntregaEstimada.HasValue)
                                {
                                    <div class="countdown-pill">
                                        <i class="bi bi-clock"></i>
                                        <span data-entrega="@cita.FechaEntregaEstimada.Value.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            Calculando...
                                        </span>
                                    </div>
                                }
                                <div class="card-actions" onclick="event.stopPropagation()">
                                    <button class="btn-act btn-act-estado"
                                            onclick="abrirModalEstado(@cita.Id, '@Html.Raw(cita.Estado)')">
                                        <i class="bi bi-arrow-repeat"></i> Estado
                                    </button>
                                    <button class="btn-act btn-act-tiempo"
                                            onclick="abrirModalTiempo(@cita.Id)">
                                        <i class="bi bi-clock"></i> Tiempo
                                    </button>
                                    <button class="btn-act btn-act-repuesto"
                                            onclick="abrirModalRepuesto(@cita.Id, '@Html.Raw(cita.MarcaVehiculo)')">
                                        <i class="bi bi-box-seam"></i> Repuesto
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <!-- Vista Tabla -->
                <div class="tabla-scroll d-none" id="vistaTabla">
                    <table class="tabla">
                        <thead>
                            <tr>
                                <th>Orden</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Vehículo</th>
                                <th>Servicio</th>
                                <th>Estado</th>
                                <th>Entrega estimada</th>
                                <th style="min-width:230px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model.CitasAsignadas)
                            {
                                var chipClass = cita.Estado switch
                                {
                                    "Pendiente" => "chip-pendiente",
                                    "En proceso" => "chip-proceso",
                                    "Esperando repuesto" => "chip-repuesto",
                                    "Listo para entrega" => "chip-listo",
                                    "Entregado" => "chip-entregado",
                                    _ => "chip-cancelado"
                                };
                                <tr style="cursor:pointer"
                                    onclick="abrirDetalle(@cita.Id)"
                                    data-id="@cita.Id"
                                    data-vehiculo="@Html.Raw(cita.Vehiculo)"
                                    data-placa="@cita.Placa"
                                    data-cliente="@Html.Raw(cita.Cliente)"
                                    data-servicio="@Html.Raw(cita.Servicio)"
                                    data-estado="@cita.Estado"
                                    data-fecha="@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")"
                                    data-diagnostico="@Html.Raw(cita.Diagnostico ?? "")"
                                    data-entrega="@(cita.FechaEntregaEstimada.HasValue ? cita.FechaEntregaEstimada.Value.ToString("yyyy-MM-ddTHH:mm:ss") : "")"
                                    data-marca="@Html.Raw(cita.MarcaVehiculo)">
                                    <td><strong>OT-@cita.Id</strong></td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yy HH:mm")</td>
                                    <td>@cita.Cliente</td>
                                    <td style="font-size:.78rem">@cita.Vehiculo<br /><span style="color:#94a3b8">@cita.Placa</span></td>
                                    <td>@cita.Servicio</td>
                                    <td><span class="estado-chip @chipClass">@cita.Estado</span></td>
                                    <td>
                                        @if (cita.FechaEntregaEstimada.HasValue)
                                        {
                                            <span data-entrega="@cita.FechaEntregaEstimada.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                  style="font-size:.76rem;color:#7c3aed;font-weight:600">
                                                Calculando...
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-size:.73rem;color:#94a3b8">Sin definir</span>
                                        }
                                    </td>
                                    <td onclick="event.stopPropagation()">
                                        <div style="display:flex;gap:.35rem;flex-wrap:wrap">
                                            <button class="btn-act btn-act-estado"
                                                    onclick="abrirModalEstado(@cita.Id, '@Html.Raw(cita.Estado)')">
                                                <i class="bi bi-arrow-repeat"></i> Estado
                                            </button>
                                            <button class="btn-act btn-act-tiempo"
                                                    onclick="abrirModalTiempo(@cita.Id)">
                                                <i class="bi bi-clock"></i> Tiempo
                                            </button>
                                            <button class="btn-act btn-act-repuesto"
                                                    onclick="abrirModalRepuesto(@cita.Id, '@Html.Raw(cita.MarcaVehiculo)')">
                                                <i class="bi bi-box-seam"></i> Repuesto
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- ════ HISTORIAL ════ -->
            <section id="historial" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-clock-history me-2" style="color:#c9a84c"></i>Historial de servicios</h1>
                        <p>Contexto técnico del vehículo antes de intervenir</p>
                    </div>
                </div>
                <div class="panel">
                    <div class="timeline">
                        @foreach (var s in Model.HistorialServicios)
                        {
                            <article class="tl-item">
                                <span class="tl-date">@s.Fecha.ToString("dd/MM/yyyy")</span>
                                <h3>@s.Vehiculo</h3>
                                <p>@s.Diagnostico</p>
                                <div class="tl-parts"><i class="bi bi-nut-fill me-1"></i>@s.PartesReemplazadas</div>
                                <small style="color:#94a3b8">Técnico anterior: @s.Tecnico</small>
                            </article>
                        }
                    </div>
                </div>
            </section>

            <!-- ════ CHECKLISTS ════ -->
            <section id="checklists" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-ui-checks me-2" style="color:#c9a84c"></i>Checklists digitales</h1>
                        <p>Marca pasos de inspección y mantenimiento</p>
                    </div>
                </div>
                <div class="panel">
                    @foreach (var checklist in Model.Checklists)
                    {
                        <article class="checklist-box">
                            <div class="checklist-title">
                                <strong>@checklist.Nombre</strong>
                                <span style="font-size:.72rem;color:#94a3b8">@checklist.Orden</span>
                            </div>
                            @foreach (var paso in checklist.Pasos)
                            {
                                <label class="check-row">
                                    <input type="checkbox" onchange="actualizarProgreso(this)" />
                                    <span>@paso</span>
                                </label>
                            }
                            <div class="slim-progress"><div class="bar"></div></div>
                        </article>
                    }
                </div>
            </section>

            <!-- ════ EVIDENCIAS ════ -->
            <section id="evidencias" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-camera-fill me-2" style="color:#c9a84c"></i>Carga de evidencias</h1>
                        <p>Fotos y notas del antes y después de la reparación</p>
                    </div>
                </div>
                <div class="two-col">
                    <div class="panel">
                        <p class="panel-title">Nueva evidencia</p>
                        <p class="panel-sub">Adjunta foto y descripción del estado del vehículo</p>
                        <form asp-controller="Mecanico" asp-action="CargarEvidencia" method="post"
                              enctype="multipart/form-data" class="mec-form">
                            @Html.AntiForgeryToken()
                            <div class="form-grid-2">
                                <select name="orden" class="mec-select">
                                    @foreach (var cita in Model.CitasAsignadas)
                                    {
                                        <option value="OT-@cita.Id">OT-@cita.Id · @cita.Placa</option>
                                    }
                                </select>
                                <select name="tipo" class="mec-select">
                                    <option>Antes</option>
                                    <option>Durante</option>
                                    <option>Después</option>
                                </select>
                            </div>
                            <textarea name="nota" class="mec-textarea" rows="3"
                                      placeholder="Describe la evidencia o el estado del vehículo"></textarea>
                            <input name="archivos" type="file" multiple accept="image/*" style="font-size:.82rem" />
                            <button type="submit" class="btn-submit">
                                <i class="bi bi-cloud-arrow-up"></i> Subir evidencia
                            </button>
                        </form>
                    </div>
                    <div class="panel">
                        <p class="panel-title">Evidencias registradas</p>
                        <p class="panel-sub">@Model.Evidencias.Count evidencia(s) en total</p>
                        <div class="evidence-list">
                            @foreach (var ev in Model.Evidencias)
                            {
                                <div class="ev-item">
                                    <i class="bi bi-image"></i>
                                    <div>
                                        <strong>@ev.Orden · @ev.Tipo</strong>
                                        <p>@ev.Nota</p>
                                        <small>@ev.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- ════ MENSAJES ════ -->
            <section id="mensajes" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-chat-dots-fill me-2" style="color:#c9a84c"></i>Chat interno</h1>
                        <p>Comunícate con administración o recepción</p>
                    </div>
                </div>
                <div class="two-col">
                    <div class="panel">
                        <p class="panel-title">Mensajes recibidos</p>
                        <p class="panel-sub">@Model.Mensajes.Count mensaje(s)</p>
                        <div class="msg-list">
                            @foreach (var m in Model.Mensajes)
                            {
                                <article class="msg-item">
                                    <div class="msg-header">
                                        <strong>@m.De</strong>
                                        <span class="msg-prio">@m.Prioridad</span>
                                    </div>
                                    <p>@m.Mensaje</p>
                                    <small>@m.FechaHora.ToString("hh:mm tt")</small>
                                </article>
                            }
                        </div>
                    </div>
                    <div class="panel">
                        <p class="panel-title">Nuevo mensaje</p>
                        <p class="panel-sub">Escribe una consulta sobre la orden o repuestos</p>
                        <form asp-controller="Mecanico" asp-action="EnviarMensaje" method="post" class="mec-form">
                            @Html.AntiForgeryToken()
                            <select name="para" class="mec-select">
                                <option>Administrador</option>
                                <option>Recepción</option>
                                <option>Inventario</option>
                            </select>
                            <textarea name="mensaje" class="mec-textarea" rows="4"
                                      placeholder="Escribe tu consulta..."></textarea>
                            <button type="submit" class="btn-submit">
                                <i class="bi bi-send-fill"></i> Enviar
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- ════ MANUALES ════ -->
            <section id="manuales" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-journal-text me-2" style="color:#c9a84c"></i>Manuales y guías técnicas</h1>
                        <p>Accesos rápidos para diagnóstico y mantenimiento</p>
                    </div>
                </div>
                <div class="panel">
                    <div class="manual-grid">
                        @foreach (var manual in Model.Manuales)
                        {
                            <a href="@manual.Url" class="manual-card" target="_blank">
                                <i class="bi bi-file-earmark-text-fill"></i>
                                <span>@manual.Categoria</span>
                                <strong>@manual.Titulo</strong>
                            </a>
                        }
                    </div>
                </div>
            </section>

            <!-- ════ HERRAMIENTAS ════ -->
            <section id="herramientas" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-tools me-2" style="color:#c9a84c"></i>Gestión de herramientas</h1>
                        <p>Control de uso y alertas de mantenimiento</p>
                    </div>
                </div>
                <div class="panel">
                    <div class="tool-list">
                        @foreach (var h in Model.Herramientas)
                        {
                            var enRevision = h.Estado.Contains("revision", StringComparison.OrdinalIgnoreCase);
                            var chipH = enRevision ? "chip-repuesto" : "chip-entregado";
                            <article class="tool-item">
                                <div>
                                    <strong>@h.Nombre</strong>
                                    <span>@h.Codigo · Último uso: @h.UltimoUso</span>
                                </div>
                                <span class="estado-chip @chipH">@h.Estado</span>
                            </article>
                        }
                    </div>
                </div>
            </section>

            <!-- ════ TIEMPO REAL ════ -->
            <section id="tiempo" class="mec-section">
                <div class="page-header">
                    <div>
                        <h1><i class="bi bi-stopwatch-fill me-2" style="color:#c9a84c"></i>Tiempo real de reparación</h1>
                        <p>Registra la duración para medir productividad</p>
                    </div>
                </div>
                <div class="panel">
                    <form asp-controller="Mecanico" asp-action="RegistrarTiempo" method="post" class="time-form">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="modal-label" style="color:#64748b">Orden de trabajo</label>
                            <select name="ordenId" class="mec-select">
                                @foreach (var cita in Model.CitasAsignadas)
                                {
                                    <option value="@cita.Id">OT-@cita.Id · @cita.Servicio</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="modal-label" style="color:#64748b">Minutos usados</label>
                            <input name="minutos" type="number" min="1" class="mec-input" placeholder="Ej: 45" />
                        </div>
                        <div>
                            <label class="modal-label" style="color:#64748b">Observación</label>
                            <input name="observacion" class="mec-input" placeholder="Trabajo realizado..." />
                        </div>
                        <div>
                            <label class="modal-label" style="color:transparent">·</label>
                            <button type="submit" class="btn-submit" style="width:100%;justify-content:center">
                                <i class="bi bi-stopwatch-fill"></i> Registrar
                            </button>
                        </div>
                    </form>
                </div>
            </section>

        </main>
    </div>

    <!-- ════════════════════════════════════════════════════
         DRAWER: Detalle completo de la orden
    ════════════════════════════════════════════════════ -->
    <div id="drawerOverlay" onclick="cerrarDetalle()"></div>

    <aside id="drawerDetalle" aria-hidden="true">

        <!-- Header del drawer -->
        <div class="drawer-header">
            <div>
                <h2 id="drawerTitulo"></h2>
                <p id="drawerSubtitulo"></p>
            </div>
            <button class="drawer-close" onclick="cerrarDetalle()" title="Cerrar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Cuerpo del drawer -->
        <div class="drawer-body">

            <!-- Chip de estado -->
            <div id="drawerEstadoWrap" style="margin-bottom:1.25rem"></div>

            <!-- Countdown si hay fecha estimada -->
            <div id="drawerCountdownWrap" style="display:none;margin-bottom:1rem">
                <div class="countdown-pill" id="drawerCountdownPill">
                    <i class="bi bi-clock"></i>
                    <span id="drawerCountdownText">Calculando...</span>
                </div>
            </div>

            <!-- Bloque: Vehículo y propietario -->
            <div class="drawer-block">
                <p class="drawer-block-title"><i class="bi bi-car-front me-1"></i>Vehículo y propietario</p>
                <div class="drawer-grid">
                    <div class="drawer-field">
                        <span class="drawer-label">Vehículo</span>
                        <p class="drawer-value" id="dVehiculo"></p>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Placa</span>
                        <p class="drawer-value" id="dPlaca"></p>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Propietario</span>
                        <p class="drawer-value" id="dCliente"></p>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Km de entrada</span>
                        <p class="drawer-value drawer-highlight" id="dKm">—</p>
                    </div>
                </div>
            </div>

            <!-- Bloque: Servicio -->
            <div class="drawer-block">
                <p class="drawer-block-title"><i class="bi bi-wrench-adjustable me-1"></i>Servicio solicitado</p>
                <p class="drawer-value" id="dServicio"></p>
            </div>

            <!-- Bloque: Diagnóstico -->
            <div class="drawer-block" id="dDiagnosticoWrap">
                <p class="drawer-block-title"><i class="bi bi-clipboard2-pulse me-1"></i>Diagnóstico</p>
                <p class="drawer-value" id="dDiagnostico" style="font-style:italic"></p>
            </div>

            <!-- Bloque: Fechas -->
            <div class="drawer-block">
                <p class="drawer-block-title"><i class="bi bi-calendar3 me-1"></i>Fechas</p>
                <div class="drawer-grid">
                    <div class="drawer-field">
                        <span class="drawer-label">Fecha de apertura</span>
                        <p class="drawer-value" id="dFecha"></p>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Entrega estimada</span>
                        <p class="drawer-value drawer-highlight" id="dEntregaFecha">Sin definir</p>
                    </div>
                </div>
            </div>

            <!-- Bloque: Historial del vehículo -->
            <div class="drawer-block">
                <p class="drawer-block-title"><i class="bi bi-clock-history me-1"></i>Historial del vehículo</p>
                <div id="dHistorial">
                    <p style="font-size:.8rem;color:#64748b;font-style:italic">Cargando historial...</p>
                </div>
            </div>

            <!-- Acciones del drawer -->
            <div class="drawer-actions">
                <p class="drawer-block-title" style="margin-bottom:.75rem"><i class="bi bi-lightning-charge me-1"></i>Acciones rápidas</p>
                <div class="drawer-btns" id="drawerBtns"></div>
            </div>

        </div>
    </aside>

    <!-- ════════════ MODAL: Cambiar estado ════════════ -->
    <div class="modal fade modal-mec" id="modalEstado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-repeat me-2"></i>Cambiar estado · <span id="modalEstadoOT"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Mecanico" asp-action="CambiarEstado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" id="estadoOrdenId" />
                    <div class="modal-body">
                        <p class="modal-label" style="margin-bottom:.85rem">Selecciona el nuevo estado</p>
                        @{
                            var coloresEstado = new Dictionary<string, string> {
                                { "Pendiente",           "#f59e0b" },
                                { "En proceso",          "#3b82f6" },
                                { "Esperando repuesto",  "#ef4444" },
                                { "Listo para entrega",  "#8b5cf6" },
                                { "Entregado",           "#22c55e" },
                                { "Cancelado",           "#6b7280" }
                            };
                        }
                        @foreach (var est in estadosDisponibles)
                        {
                            var color = coloresEstado.ContainsKey(est) ? coloresEstado[est] : "#6b7280";
                            <label class="estado-option" onclick="seleccionarEstado(this)">
                                <input type="radio" name="nuevoEstado" value="@est" />
                                <span class="dot-estado" style="background:@color"></span>
                                <span>@est</span>
                            </label>
                        }
                        <div style="margin-top:1rem">
                            <label class="modal-label">Observación (opcional)</label>
                            <textarea name="observacion" class="modal-input" rows="2"
                                      placeholder="Ej: esperando llegada de filtro de aceite..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer gap-2">
                        <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-modal-save"><i class="bi bi-check-lg"></i> Guardar estado</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ════════════ MODAL: Tiempo estimado ════════════ -->
    <div class="modal fade modal-mec" id="modalTiempo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clock me-2"></i>Tiempo estimado · <span id="modalTiempoOT"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Mecanico" asp-action="GuardarTiempoEstimado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" id="tiempoOrdenId" />
                    <div class="modal-body">
                        <p class="modal-label" style="margin-bottom:.75rem">¿Cómo quieres definir el tiempo?</p>
                        <div class="tiempo-toggle">
                            <button type="button" id="btnModoHoras" class="active" onclick="cambiarModoTiempo('horas')">
                                <i class="bi bi-hourglass-split me-1"></i> En horas
                            </button>
                            <button type="button" id="btnModoDias" onclick="cambiarModoTiempo('dias')">
                                <i class="bi bi-calendar3 me-1"></i> Por fecha
                            </button>
                        </div>
                        <div id="panelHoras">
                            <label class="modal-label">Cuántas horas aproximadamente</label>
                            <input type="number" id="inputHoras" name="horas" min="1" max="999"
                                   class="modal-input" placeholder="Ej: 3" style="margin-bottom:.5rem" />
                            <p style="font-size:.72rem;color:#64748b;margin:0">Se calculará la fecha de entrega desde ahora.</p>
                        </div>
                        <div id="panelFecha" style="display:none">
                            <label class="modal-label">Fecha y hora de entrega estimada</label>
                            <input type="datetime-local" id="inputFecha" name="fechaEntrega"
                                   class="modal-input" style="color-scheme:dark" />
                            <p style="font-size:.72rem;color:#64748b;margin-top:.4rem;margin-bottom:0">
                                El cliente verá una cuenta regresiva hasta esta fecha.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer gap-2">
                        <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-modal-save"><i class="bi bi-floppy"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ════════════ MODAL: Pedir repuesto ════════════ -->
    <div class="modal fade modal-mec" id="modalRepuesto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-box-seam me-2"></i>Solicitar repuesto · <span id="modalRepuestoOT"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Mecanico" asp-action="SolicitarRepuesto" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" id="repOrdenId" />
                    <div class="modal-body">
                        <div style="margin-bottom:.65rem">
                            <label class="modal-label"><i class="bi bi-archive me-1"></i>Buscar en inventario</label>
                            <select name="repuestoId" id="selectRepuesto" class="modal-input" onchange="toggleCampoLibre(this)">
                                <option value="">— No está en inventario, lo escribo abajo —</option>
                                @foreach (var r in Model.RepuestosDisponibles)
                                {
                                    <option value="@r.IdRepuesto"
                                            data-stock="@r.StockActual"
                                            data-ref="@r.Referencia"
                                            data-cat="@r.Categoria"
                                            data-marca="@r.Marca">
                                        @r.Nombre (@r.Referencia) · Stock: @r.StockActual
                                    </option>
                                }
                            </select>
                            <p id="sinRepuestosMsg" style="display:none;font-size:.75rem;color:#f87171;margin-top:.4rem">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                No hay repuestos de esta marca en inventario. Usa el campo de abajo.
                            </p>
                        </div>
                        <div id="repInfoBox" class="rep-info-box" style="display:none">
                            <div class="rep-info-grid">
                                <div><span class="rep-info-lbl">Referencia</span><span class="rep-info-val" id="repInfoRef">—</span></div>
                                <div><span class="rep-info-lbl">Categoría</span><span class="rep-info-val" id="repInfoCat">—</span></div>
                                <div><span class="rep-info-lbl">Stock disponible</span><span class="rep-info-val" id="repInfoStock">—</span></div>
                            </div>
                        </div>
                        <div class="rep-divisor">o si no está en inventario</div>
                        <div id="campoNombreLibre" style="margin-bottom:.85rem">
                            <label class="modal-label">
                                <i class="bi bi-pencil me-1"></i>Nombre del repuesto
                                <span style="color:#ef4444" id="repLibreAsterisco">*</span>
                                <span id="repLibreHint" style="color:#64748b;font-size:.68rem;text-transform:none;letter-spacing:0"> — no está en el inventario</span>
                            </label>
                            <input type="text" name="nombreLibre" id="inputNombreLibre" class="modal-input"
                                   placeholder="Ej: Filtro de combustible Bosch 1457434310" />
                        </div>
                        <div style="margin-bottom:.85rem">
                            <label class="modal-label">Cantidad *</label>
                            <input type="number" name="cantidad" id="repCantidad" min="1" value="1" class="modal-input" required />
                        </div>
                        <div>
                            <label class="modal-label">Motivo / especificación técnica</label>
                            <textarea name="motivo" rows="2" class="modal-input"
                                      placeholder="Ej: necesario para cambio de aceite en OT..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer gap-2">
                        <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn-modal-save"><i class="bi bi-send"></i> Enviar solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Navegación por secciones ──────────────────────────────
        function irA(id, btn) {
            document.querySelectorAll('.mec-section').forEach(s => s.classList.remove('visible'));
            document.querySelectorAll('.mec-nav-link').forEach(b => b.classList.remove('active'));
            document.getElementById(id).classList.add('visible');
            btn.classList.add('active');
            document.querySelector('.mec-main').scrollTop = 0;
        }

        // ── Vista agenda ──────────────────────────────────────────
        function setVista(modo) {
            const cards = document.getElementById('vistaCards');
            const tabla = document.getElementById('vistaTabla');
            const btnC  = document.getElementById('btnCards');
            const btnT  = document.getElementById('btnTabla');
            if (modo === 'cards') {
                cards.classList.remove('d-none');
                tabla.classList.add('d-none');
                btnC.classList.add('active');
                btnT.classList.remove('active');
            } else {
                cards.classList.add('d-none');
                tabla.classList.remove('d-none');
                btnT.classList.add('active');
                btnC.classList.remove('active');
            }
        }

        // ── Checklists ────────────────────────────────────────────
        function actualizarProgreso(checkbox) {
            const box    = checkbox.closest('.checklist-box');
            const total  = box.querySelectorAll('input[type="checkbox"]').length;
            const checks = box.querySelectorAll('input[type="checkbox"]:checked').length;
            box.querySelector('.bar').style.width = Math.round((checks / total) * 100) + '%';
        }

        // ══════════════════════════════════════════════════════════
        // DRAWER: Detalle de orden
        // ══════════════════════════════════════════════════════════

        // Mapa de chips de estado (igual que en el resto de la vista)
        const chipClasses = {
            'Pendiente':          'chip-pendiente',
            'En proceso':         'chip-proceso',
            'Esperando repuesto': 'chip-repuesto',
            'Listo para entrega': 'chip-listo',
            'Entregado':          'chip-entregado',
            'Cancelado':          'chip-cancelado'
        };

        // Historial del vehículo: datos precargados desde Razor
        const historialData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.HistorialServicios.Select(h => new {
                fecha     = h.Fecha.ToString("dd/MM/yyyy"),
                vehiculo  = h.Vehiculo,
                diagnostico = h.Diagnostico,
                partes    = h.PartesReemplazadas,
                tecnico   = h.Tecnico
            })
        ));

        function abrirDetalle(ordenId) {
            const card = document.querySelector(`[data-id="${ordenId}"]`);
            if (!card) return;

            const d = card.dataset;

            // Título
            document.getElementById('drawerTitulo').textContent    = `OT-${ordenId}`;
            document.getElementById('drawerSubtitulo').textContent = `${d.fecha} · ${d.placa}`;

            // Estado chip
            const chipCls = chipClasses[d.estado] || 'chip-cancelado';
            document.getElementById('drawerEstadoWrap').innerHTML =
                `<span class="estado-chip ${chipCls}" style="font-size:.82rem;padding:5px 14px">${d.estado}</span>`;

            // Campos
            document.getElementById('dVehiculo').textContent  = d.vehiculo  || '—';
            document.getElementById('dPlaca').textContent     = d.placa     || '—';
            document.getElementById('dCliente').textContent   = d.cliente   || '—';
            document.getElementById('dServicio').textContent  = d.servicio  || '—';
            document.getElementById('dFecha').textContent     = d.fecha     || '—';
            document.getElementById('dKm').textContent        = '—'; // campo disponible para futuro

            // Diagnóstico
            const diagWrap = document.getElementById('dDiagnosticoWrap');
            const diagEl   = document.getElementById('dDiagnostico');
            if (d.diagnostico && d.diagnostico.trim() !== '') {
                diagEl.textContent  = d.diagnostico;
                diagWrap.style.display = '';
            } else {
                diagWrap.style.display = 'none';
            }

            // Entrega estimada
            const entregaEl = document.getElementById('dEntregaFecha');
            if (d.entrega) {
                const fecha = new Date(d.entrega);
                entregaEl.textContent = fecha.toLocaleString('es-CO', { dateStyle:'medium', timeStyle:'short' });
                // Countdown en el drawer
                document.getElementById('drawerCountdownWrap').style.display = '';
                document.getElementById('drawerCountdownPill').dataset.entrega = d.entrega;
                actualizarCountdownDrawer();
            } else {
                entregaEl.textContent = 'Sin definir';
                document.getElementById('drawerCountdownWrap').style.display = 'none';
            }

            // Historial del vehículo (filtrado por placa incluida en el campo vehiculo)
            const histContainer = document.getElementById('dHistorial');
            const placaBuscar   = (d.placa || '').toLowerCase();
            const histFiltrado  = historialData.filter(h =>
                h.vehiculo && h.vehiculo.toLowerCase().includes(placaBuscar)
            );
            if (histFiltrado.length > 0) {
                histContainer.innerHTML = histFiltrado.map(h => `
                    <div class="drawer-hist-item">
                        <span class="drawer-hist-fecha">${h.fecha}</span>
                        <p class="drawer-hist-diag">${h.diagnostico || 'Sin diagnóstico'}</p>
                        <p class="drawer-hist-partes"><i class="bi bi-nut-fill me-1"></i>${h.partes || 'Sin repuestos'}</p>
                        <small style="color:#64748b">Técnico: ${h.tecnico || '—'}</small>
                    </div>
                `).join('');
            } else {
                histContainer.innerHTML =
                    `<p style="font-size:.8rem;color:#64748b;font-style:italic">
                        No hay historial previo registrado para este vehículo.
                     </p>`;
            }

            // Botones de acción (mismos que en la card)
            document.getElementById('drawerBtns').innerHTML = `
                <button class="btn-act btn-act-estado"
                        onclick="event.stopPropagation();cerrarDetalle();abrirModalEstado(${ordenId},'${d.estado}')">
                    <i class="bi bi-arrow-repeat"></i> Cambiar estado
                </button>
                <button class="btn-act btn-act-tiempo"
                        onclick="event.stopPropagation();cerrarDetalle();abrirModalTiempo(${ordenId})">
                    <i class="bi bi-clock"></i> Tiempo estimado
                </button>
                <button class="btn-act btn-act-repuesto"
                        onclick="event.stopPropagation();cerrarDetalle();abrirModalRepuesto(${ordenId},'${d.marca}')">
                    <i class="bi bi-box-seam"></i> Pedir repuesto
                </button>
            `;

            // Abrir drawer
            document.getElementById('drawerOverlay').style.display = 'block';
            requestAnimationFrame(() => {
                document.getElementById('drawerDetalle').classList.add('drawer-open');
                document.getElementById('drawerDetalle').setAttribute('aria-hidden','false');
                document.body.style.overflow = 'hidden';
            });
        }

        function cerrarDetalle() {
            document.getElementById('drawerDetalle').classList.remove('drawer-open');
            document.getElementById('drawerDetalle').setAttribute('aria-hidden','true');
            document.body.style.overflow = '';
            setTimeout(() => {
                document.getElementById('drawerOverlay').style.display = 'none';
            }, 300);
        }

        function actualizarCountdownDrawer() {
            const pill = document.getElementById('drawerCountdownPill');
            if (!pill || !pill.dataset.entrega) return;
            const diff = new Date(pill.dataset.entrega) - new Date();
            const el   = document.getElementById('drawerCountdownText');
            if (diff <= 0) {
                el.textContent = 'Tiempo vencido';
                pill.classList.add('urgente');
            } else {
                const dias  = Math.floor(diff / 86400000);
                const horas = Math.floor((diff % 86400000) / 3600000);
                const mins  = Math.floor((diff % 3600000) / 60000);
                el.textContent = dias > 0  ? `${dias}d ${horas}h restantes`
                               : horas > 0 ? `${horas}h ${mins}m restantes`
                                           : `${mins} min restantes`;
            }
        }

        // Cerrar drawer con tecla ESC
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') cerrarDetalle();
        });

        // ── Modal estado ──────────────────────────────────────────
        function abrirModalEstado(ordenId, estadoActual) {
            document.getElementById('estadoOrdenId').value = ordenId;
            document.getElementById('modalEstadoOT').textContent = 'OT-' + ordenId;
            document.querySelectorAll('#modalEstado input[type=radio]').forEach(r => {
                const opt = r.closest('.estado-option');
                r.checked = (r.value === estadoActual);
                opt.classList.toggle('selected', r.checked);
            });
            new bootstrap.Modal(document.getElementById('modalEstado')).show();
        }

        function seleccionarEstado(label) {
            document.querySelectorAll('#modalEstado .estado-option').forEach(o => o.classList.remove('selected'));
            label.classList.add('selected');
            label.querySelector('input[type=radio]').checked = true;
        }

        // ── Modal tiempo estimado ─────────────────────────────────
        function abrirModalTiempo(ordenId) {
            document.getElementById('tiempoOrdenId').value = ordenId;
            document.getElementById('modalTiempoOT').textContent = 'OT-' + ordenId;
            const ahora = new Date();
            ahora.setMinutes(ahora.getMinutes() - ahora.getTimezoneOffset());
            document.getElementById('inputFecha').min = ahora.toISOString().slice(0, 16);
            document.getElementById('inputFecha').value = '';
            document.getElementById('inputHoras').value = '';
            cambiarModoTiempo('horas');
            new bootstrap.Modal(document.getElementById('modalTiempo')).show();
        }

        function cambiarModoTiempo(modo) {
            const esHoras = modo === 'horas';
            document.getElementById('panelHoras').style.display = esHoras ? '' : 'none';
            document.getElementById('panelFecha').style.display = esHoras ? 'none' : '';
            document.getElementById('btnModoHoras').classList.toggle('active', esHoras);
            document.getElementById('btnModoDias').classList.toggle('active', !esHoras);
            if (esHoras) document.getElementById('inputFecha').value = '';
            else         document.getElementById('inputHoras').value = '';
        }

        // ── Modal repuesto ────────────────────────────────────────
        let _marcaVehiculo = '';

        function abrirModalRepuesto(ordenId, marcaVehiculo) {
            _marcaVehiculo = (marcaVehiculo || '').trim().toLowerCase();
            document.getElementById('repOrdenId').value = ordenId;
            document.getElementById('modalRepuestoOT').textContent = 'OT-' + ordenId;
            const select = document.getElementById('selectRepuesto');
            select.value = '';
            document.getElementById('inputNombreLibre').value = '';
            document.getElementById('repCantidad').value = 1;
            filtrarRepuestosPorMarca(_marcaVehiculo);
            toggleCampoLibre(select);
            new bootstrap.Modal(document.getElementById('modalRepuesto')).show();
        }

        function filtrarRepuestosPorMarca(marca) {
            const select  = document.getElementById('selectRepuesto');
            const aviso   = document.getElementById('sinRepuestosMsg');
            let hayCoincidencia = false;
            select.querySelectorAll('option[value]').forEach(opt => {
                const marcaOpt = (opt.dataset.marca || '').toLowerCase();
                const visible  = !marca || marcaOpt === marca || marcaOpt === 'general';
                opt.style.display = visible ? '' : 'none';
                if (visible && opt.value !== '') hayCoincidencia = true;
            });
            aviso.style.display = (marca && !hayCoincidencia) ? '' : 'none';
        }

        function toggleCampoLibre(select) {
            const tieneInventario = select.value !== '';
            const campoLibre = document.getElementById('campoNombreLibre');
            const inputLibre = document.getElementById('inputNombreLibre');
            const infoBox    = document.getElementById('repInfoBox');
            const asterisco  = document.getElementById('repLibreAsterisco');
            const hint       = document.getElementById('repLibreHint');

            if (tieneInventario) {
                campoLibre.style.opacity = '.45';
                inputLibre.required      = false;
                inputLibre.placeholder   = 'Opcional: agrega más detalles si lo necesitas';
                asterisco.style.display  = 'none';
                hint.textContent         = '— opcional si ya escogiste del inventario';
                const opt = select.selectedOptions[0];
                document.getElementById('repInfoRef').textContent   = opt.dataset.ref   || '—';
                document.getElementById('repInfoCat').textContent   = opt.dataset.cat   || '—';
                document.getElementById('repInfoStock').textContent = opt.dataset.stock || '—';
                infoBox.style.display = '';
            } else {
                campoLibre.style.opacity = '1';
                inputLibre.required      = true;
                inputLibre.placeholder   = 'Ej: Filtro de combustible Bosch 1457434310';
                asterisco.style.display  = '';
                hint.textContent         = '— no está en el inventario';
                infoBox.style.display    = 'none';
            }
        }

        // ── Cuentas regresivas (cards y tabla) ───────────────────
        function actualizarCuentas() {
            document.querySelectorAll('[data-entrega]').forEach(el => {
                if (el.id === 'drawerCountdownPill') return; // lo maneja su propio fn
                const diff = new Date(el.dataset.entrega) - new Date();
                const pill = el.closest('.countdown-pill');
                if (!pill) return;
                if (diff <= 0) {
                    el.textContent = 'Tiempo vencido';
                    pill.classList.add('urgente');
                    return;
                }
                const dias  = Math.floor(diff / 86400000);
                const horas = Math.floor((diff % 86400000) / 3600000);
                const mins  = Math.floor((diff % 3600000) / 60000);
                el.textContent = dias > 0  ? `${dias}d ${horas}h restantes`
                               : horas > 0 ? `${horas}h ${mins}m restantes`
                                           : `${mins} min restantes`;
                if (diff < 3600000)       pill.classList.add('urgente');
                else if (diff > 86400000) pill.classList.add('ok');
            });
            actualizarCountdownDrawer();
        }

        actualizarCuentas();
        setInterval(actualizarCuentas, 30000);
    </script>
</body>
</html>
