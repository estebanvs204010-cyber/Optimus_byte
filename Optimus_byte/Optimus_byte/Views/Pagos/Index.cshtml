@model VistaPrincipal.Models.ViewModels.PagosIndexViewModel
@{
    ViewData["Title"] = "Gestión de Pagos";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE - Gestión de Pagos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
</head>
<body>
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name">
                <i class="bi bi-person-circle me-1"></i>
                @Context.Session.GetString("UsuarioNombre")
            </span>
            <a href="/Login/Logout" class="btn-salir">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link">
                <i class="bi bi-people-fill"></i><span>Usuarios</span>
            </a>
            <a href="/Admin/Ordenes" class="nav-link">
                <i class="bi bi-clipboard2-check"></i><span>Órdenes</span>
            </a>
            <a href="/Admin/Inventario" class="nav-link">
                <i class="bi bi-box-seam"></i><span>Inventario</span>
            </a>
            <a href="/Pagos" class="nav-link active">
                <i class="bi bi-cash-coin"></i><span>Pagos</span>
            </a>
            <a href="/Admin/Dashboard" class="nav-link">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>
        </nav>
    </div>

    <div class="admin-content">
        <div class="section-header">
            <div>
                <h1 class="section-title">Gestión de Pagos</h1>
                <p class="section-sub">Historial y control de pagos recibidos</p>
            </div>
            <a asp-controller="Pagos" asp-action="Crear" class="btn-nuevo">
                <i class="bi bi-plus-lg me-2"></i>Nuevo Pago
            </a>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="alerta alerta-ok">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alerta alerta-err">
                <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
            </div>
        }

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon" style="background:#1e3a5f">
                    <i class="bi bi-receipt-cutoff text-info"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.TotalPagos</div>
                    <div class="stat-label">Pagos registrados</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#1a3a2a">
                    <i class="bi bi-cash-coin text-success"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.TotalRecaudado.ToString("C0")</div>
                    <div class="stat-label">Total recaudado</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#2a2a1a">
                    <i class="bi bi-hourglass-split text-warning"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.FacturasPendientes</div>
                    <div class="stat-label">Pendientes</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#1a3a2a">
                    <i class="bi bi-check2-circle text-success"></i>
                </div>
                <div>
                    <div class="stat-num">@Model.FacturasPagadas</div>
                    <div class="stat-label">Facturas pagadas</div>
                </div>
            </div>
        </div>

        <div class="filtro-bar">
            <div class="input-buscar">
                <i class="bi bi-search"></i>
                <input type="text" id="buscarInput"
                       placeholder="Buscar por factura, orden, método o referencia..."
                       onkeyup="filtrarTabla()" />
            </div>
            <select id="filtroMetodo" class="filtro-select" onchange="filtrarTabla()">
                <option value="">Todos los métodos</option>
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>
                <option value="Tarjeta debito">Tarjeta débito</option>
                <option value="Tarjeta credito">Tarjeta crédito</option>
                <option value="PSE">PSE</option>
                <option value="Nequi">Nequi</option>
            </select>
            <select id="filtroEstado" class="filtro-select" onchange="filtrarTabla()">
                <option value="">Todos los estados</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Pagado">Pagado</option>
                <option value="Anulado">Anulado</option>
            </select>
        </div>

        <div class="tabla-wrapper">
            <table class="tabla-usuarios" id="tablaPagos">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Factura</th>
                        <th>Monto</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pago in Model.Pagos)
                    {
                        var referencia = string.IsNullOrWhiteSpace(pago.ReferenciaTransaccion)
                        ? "Sin referencia"
                        : pago.ReferenciaTransaccion;

                        <tr class="fila-pago"
                            data-buscar="factura @pago.IdFactura orden @pago.IdOrden @pago.Metodo.ToLower() @referencia.ToLower()"
                            data-metodo="@pago.Metodo"
                            data-estado="@pago.EstadoPago">
                            <td>@pago.IdPago</td>
                            <td>
                                <div class="fw-semibold">Factura #@pago.IdFactura</div>
                                <small class="text-muted">Orden #@pago.IdOrden</small>
                            </td>
                            <td class="fw-semibold">@pago.Monto.ToString("C0")</td>
                            <td>
                                <span class="rol-badge badge-cli">
                                    <i class="bi bi-cash-stack me-1" style="font-size:.7rem"></i>@pago.Metodo
                                </span>
                            </td>
                            <td>@referencia</td>
                            <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    var estadoClase = pago.EstadoPago == "Pagado"
                                    ? "estado-activo"
                                    : pago.EstadoPago == "Anulado" ? "estado-inactivo" : "estado-pendiente";
                                }
                                <span class="estado-badge @estadoClase">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>@pago.EstadoPago
                                </span>
                            </td>
                            <td class="td-acciones">
                                <a asp-controller="Pagos" asp-action="Editar" asp-route-id="@pago.IdPago"
                                   class="btn-accion btn-editar" title="Editar pago">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-controller="Pagos" asp-action="Eliminar" asp-route-id="@pago.IdPago"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar el pago #@pago.IdPago?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-accion btn-desactivar" title="Eliminar pago">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Pagos.Any())
            {
                <div class="tabla-vacia">
                    <i class="bi bi-cash-coin" style="font-size:3rem;color:#334155"></i>
                    <p class="mt-2">No hay pagos registrados aún.</p>
                    <a asp-controller="Pagos" asp-action="Crear" class="btn-nuevo mt-2">
                        Registrar primer pago
                    </a>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filtrarTabla() {
            const buscar = document.getElementById('buscarInput').value.toLowerCase();
            const metodo = document.getElementById('filtroMetodo').value;
            const estado = document.getElementById('filtroEstado').value;

            document.querySelectorAll('.fila-pago').forEach(fila => {
                const okBuscar = !buscar || fila.dataset.buscar.includes(buscar);
                const okMetodo = !metodo || fila.dataset.metodo === metodo;
                const okEstado = !estado || fila.dataset.estado === estado;

                fila.style.display = (okBuscar && okMetodo && okEstado) ? '' : 'none';
            });
        }
    </script>
</body>
</html>