@model Optimus_byte.Models.ViewModels.PagoFormViewModel
@{
    ViewData["Title"] = "Editar Pago";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE - Editar Pago</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/usuarios.css" rel="stylesheet" />
</head>
<body>
    <div class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-admin">Admin</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="admin-name">
                <i class="bi bi-person-circle me-1"></i>
                @Context.Session.GetString("UsuarioNombre")
            </span>
            <a href="/Login/Logout" class="btn-salir">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>

    <div class="admin-sidebar">
        <nav class="sidebar-nav">
            <a href="/Usuarios" class="nav-link"><i class="bi bi-people-fill"></i><span>Usuarios</span></a>
            <a href="/Admin/Ordenes" class="nav-link"><i class="bi bi-clipboard2-check"></i><span>Órdenes</span></a>
            <a href="/Admin/Inventario" class="nav-link"><i class="bi bi-box-seam"></i><span>Inventario</span></a>
            <a href="/Pagos" class="nav-link active"><i class="bi bi-cash-coin"></i><span>Pagos</span></a>
            <a href="/Admin/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
        </nav>
    </div>

    <div class="admin-content">
        <div class="section-header">
            <div>
                <h1 class="section-title">Editar Pago</h1>
                <p class="section-sub">Actualiza la información del pago #@Model.IdPago</p>
            </div>
            <a asp-controller="Pagos" asp-action="Index" class="btn-volver">
                <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
        </div>

        <div class="form-card">
            <form asp-controller="Pagos" asp-action="Editar" asp-route-id="@Model.IdPago" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IdPago" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-grid">
                    <div class="form-group span-2">
                        <label asp-for="IdFactura"></label>
                        <select asp-for="IdFactura" asp-items="ViewBag.Facturas" class="form-control">
                            <option value="0">Selecciona una factura</option>
                        </select>
                        <span asp-validation-for="IdFactura" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Monto"></label>
                        <input asp-for="Monto" class="form-control" type="number" min="0.01" step="0.01" />
                        <span asp-validation-for="Monto" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Metodo"></label>
                        <select asp-for="Metodo" asp-items="ViewBag.MetodosPago" class="form-control"></select>
                        <span asp-validation-for="Metodo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EstadoPago"></label>
                        <select asp-for="EstadoPago" asp-items="ViewBag.EstadosPago" class="form-control"></select>
                        <span asp-validation-for="EstadoPago" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ReferenciaTransaccion"></label>
                        <input asp-for="ReferenciaTransaccion" class="form-control" placeholder="Opcional" />
                        <span asp-validation-for="ReferenciaTransaccion" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FechaPago"></label>
                        <input asp-for="FechaPago" class="form-control" type="datetime-local" />
                        <span asp-validation-for="FechaPago" class="text-danger"></span>
                    </div>

                    <div class="form-group span-2">
                        <label asp-for="Observaciones"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="4" placeholder="Notas internas del pago"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-controller="Pagos" asp-action="Index" class="btn-cancelar">Cancelar</a>
                    <button type="submit" class="btn-guardar">
                        <i class="bi bi-check2-circle me-2"></i>Actualizar Pago
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>